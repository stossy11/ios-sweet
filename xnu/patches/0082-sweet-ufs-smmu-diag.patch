+/*
+ * apps_smmu (Qualcomm QSMMUv500).  The live device tree gives the UFS
+ * master an SMMU stream ("iommus = <&apps_smmu 0x60 0x00>" with
+ * "qcom,iommu-dma = \"fastmap\""), so every DMA address the host uses is
+ * translated by this block.  A plain physical address is only a legal UFS
+ * DMA address when the SMMU context for that stream is a bypass, so the
+ * state of the block is part of the bring-up story and is dumped here.
+ *
+ * Register offsets follow the SMMUv3 layout (ARM DDI 0487A): the device
+ * tree programs 0x800 (SMR) and 0xc00 (S2CR) exactly like the
+ * architecture defines, which corroborates the map.
+ */
+#define SMMU_BASE_PHYS  0x15000000ULL
+#define SMMU_SIZE       0x100000ULL
+#define SMMU_IDR0       0x00
+#define SMMU_CR0        0x20
+#define SMMU_CR0ACK     0x24
+#define SMMU_GBPA       0x44
+#define SMMU_GERROR     0x60
+#define SMMU_GERRORN    0x64
+#define SMMU_SMR        0x800
+#define SMMU_STRTAB     0x8000
+#define SMMU_CDBAR      0x8008
+#define SMMU_FSR        0x9000
+#define SMMU_FAR        0x9008
+#define SMMU_GSR        0x9010
+#define SMMU_CR0_S0EN   (1u << 0)   /* translation enabled, secure */
+#define SMMU_CR0_NS0EN  (1u << 1)   /* translation enabled, non-secure */
+
+/* Stream id of the UFS master (device tree: iommus = <&apps_smmu 0x60 0x00>). */
+#define SMMU_UFS_SID    0x60
+
 #define UFS_BLOCK       4096u
 #define BOUNCE_SIZE     (1u << 20)
 #define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
