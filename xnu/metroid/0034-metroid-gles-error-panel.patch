 #include <kern/clock.h>
 #include <sys/proc.h>
 
+/* Updated by bounded /dev/null diagnostic records and process exit hooks.
+ * Try-lock only: diagnostics must never stall a dying compositor. */
+#include "metroid_gles_error_panel.h"
+extern "C" bool metroid_gpu_copy_status(char *, size_t);
+extern "C" unsigned char iso_font[];
+static struct metroid_gles_panel gles_panel;
+static unsigned gles_panel_lock;
+static void gles_panel_record(int process, const char *text, size_t length)
+{
+    if (__atomic_exchange_n(&gles_panel_lock, 1u, __ATOMIC_ACQUIRE)) return;
+    metroid_gles_panel_store(&gles_panel, process, text, length);
+    __atomic_store_n(&gles_panel_lock, 0u, __ATOMIC_RELEASE);
+}
+extern "C" void sweet_fb_gles_error_log(const char *name, const char *text, size_t length)
+{
+    static const char prefix[] = "SOFTGLES ERROR: ";
+    if (strcmp(name, "backboardd") && strcmp(name, "softgles-probe")) return;
+    if (length <= sizeof(prefix) - 1 || memcmp(text, prefix, sizeof(prefix) - 1)) return;
+    gles_panel_record(0, text + sizeof(prefix) - 1, length - (sizeof(prefix) - 1));
+}
+extern "C" void sweet_fb_gles_process_exit(const char *name, int pid, int signal, int status)
+{
+    if (strcmp(name, "backboardd") && strcmp(name, "SpringBoard") &&
+        strcmp(name, "softgles-probe")) return;
+    if (!strcmp(name, "softgles-probe") && !signal && !status) return;
+    char text[96];
+    snprintf(text, sizeof(text), "%s pid %d exited: signal %d status %d", name, pid, signal, status);
+    gles_panel_record(1, text, strlen(text));
+}
+static void gles_panel_draw(uintptr_t pixels, uint32_t width, uint32_t height, uint32_t stride)
+{
+    if (__atomic_exchange_n(&gles_panel_lock, 1u, __ATOMIC_ACQUIRE)) return;
+    (void)metroid_gpu_copy_status(gles_panel.gpu, sizeof(gles_panel.gpu));
+    struct metroid_gles_panel snapshot = gles_panel;
+    __atomic_store_n(&gles_panel_lock, 0u, __ATOMIC_RELEASE);
+    metroid_gles_panel_draw(&snapshot, (volatile uint32_t *)pixels, width, height, stride, iso_font);
+}
+
 enum {
 	kSweetFBGetLayerDefaultSurface  = 3,
 	kSweetFBSwapBegin               = 4,
