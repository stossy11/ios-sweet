--- /dev/null
+++ b/iokit/Kernel/arm/metroid_gles_error_panel.h
@@ -0,0 +1,69 @@
+/* Bounded CPU-only diagnostic overlay; shared by the kernel and host checks. */
+#ifndef METROID_GLES_ERROR_PANEL_H
+#define METROID_GLES_ERROR_PANEL_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+struct metroid_gles_panel {
+    char renderer[96];
+    char process[96];
+    char gpu[320];
+};
+
+static inline void
+metroid_gles_panel_store(struct metroid_gles_panel *panel, int process,
+    const char *text, size_t length)
+{
+    char *out = process ? panel->process : panel->renderer;
+    size_t n = length < 95 ? length : 95;
+    for (size_t i = 0; i < n; i++) {
+        unsigned char ch = (unsigned char)text[i];
+        if (!ch) { n = i; break; }
+        out[i] = ch >= 32 && ch <= 126 ? (char)ch : ' ';
+    }
+    out[n] = 0;
+}
+
+static inline void
+metroid_gles_panel_draw(const struct metroid_gles_panel *panel,
+    volatile uint32_t *pixels, uint32_t width, uint32_t height,
+    uint32_t stride, const unsigned char *font)
+{
+    if ((!panel->renderer[0] && !panel->process[0] && !panel->gpu[0]) || !pixels || !font ||
+        width < 88 || height < 80 || width > 16384 || height > 16384 ||
+        (uint64_t)stride < (uint64_t)width * 4 || (stride & 3)) return;
+    unsigned cols = (width - 40) / 16;
+    if (cols > 60) cols = 60;
+    const char *title = panel->gpu[0] ? "GPU / PROCESS STATUS" : "GLES / PROCESS FAILURE";
+    const char *lines[] = {title, panel->gpu, panel->renderer, panel->process};
+    unsigned rows = 1;
+    for (unsigned i = 1; i < 4; i++)
+        rows += (unsigned)(strlen(lines[i]) + cols - 1) / cols;
+    unsigned boxw = cols * 16 + 16, boxh = rows * 32 + 16;
+    if (boxh + 24 > height) return;
+    unsigned x0 = width - boxw - 12, y0 = height - boxh - 12;
+    for (unsigned y = 0; y < boxh; y++) {
+        volatile uint32_t *row = pixels + (size_t)(y0 + y) * (stride / 4) + x0;
+        for (unsigned x = 0; x < boxw; x++)
+            row[x] = (y < 2 || y >= boxh - 2 || x < 2 || x >= boxw - 2) ? 0xffff4040 : 0xff101010;
+    }
+    unsigned row = 0;
+    for (unsigned i = 0; i < 4; i++) {
+        size_t length = strlen(lines[i]);
+        if (!i && length > cols) length = cols;
+        for (size_t k = 0; k < length; k++) {
+            unsigned ch = (unsigned char)lines[i][k];
+            for (unsigned y = 0; y < 32; y++) {
+                unsigned bits = font[ch * 16 + y / 2];
+                volatile uint32_t *dst = pixels +
+                    (size_t)(y0 + 8 + row * 32 + (k / cols) * 32 + y) * (stride / 4) +
+                    x0 + 8 + (k % cols) * 16;
+                for (unsigned x = 0; x < 16; x++)
+                    if (bits & (1u << (x / 2))) dst[x] = i ? 0xffffffff : 0xffff8080;
+            }
+        }
+        row += i ? (unsigned)(length + cols - 1) / cols : 1;
+    }
+}
+#endif
