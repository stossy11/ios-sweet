diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,18 +1,57 @@
 /* Metroid early diagnostics; console remains available as the serial sink. */
 #include <arm64/sweet_early.h>
 #include <kern/misc_protos.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <console/video_console.h>
 #include "metroid_console.h"
-static unsigned started, panicking;
+static unsigned started, panicking, framebuffer_console;
+static unsigned timestamp_enabled, log_line_start = 1;
+
+/* Boot is single CPU. Disable local interrupts while changing the shared
+ * cursor/line state; never allocate, take a sleeping lock, or log recursively.
+ * Both the virtual serial device and normal console enter this same sink. */
 void sweet_early_putc(char c)
 {
-    if (!started) { started = 1; metroid_console_init(); }
-    metroid_console_putc(c);
+    if (!framebuffer_console) {
+        if (!started) { started = 1; metroid_console_init(); }
+        metroid_console_putc(c);
+        return;
+    }
+    boolean_t interrupts = ml_set_interrupts_enabled(FALSE);
+    if (timestamp_enabled && log_line_start && c != '\r' && c != '\n' && c != '\0') {
+        clock_sec_t seconds;
+        clock_usec_t micros;
+        char prefix[40];
+        clock_get_system_microtime(&seconds, &micros);
+        snprintf(prefix, sizeof(prefix), "[%5lu.%06u]: ",
+            (unsigned long)seconds, (unsigned int)micros);
+        for (const char *p = prefix; *p; p++) vcputc(*p);
+        log_line_start = 0;
+    }
+    /* vcputc handles LF and CR separately. Both printf's bare LF and
+     * kprintf's CRLF must return to column zero without creating a new stamp. */
+    if (c == '\n') {
+        vcputc('\r');
+        log_line_start = 1;
+    }
+    vcputc(c);
+    ml_set_interrupts_enabled(interrupts);
 }
-void sweet_early_flush(void) { metroid_console_flush(); }
+void sweet_early_flush(void)
+{
+    if (!framebuffer_console) metroid_console_flush();
+}
 int sweet_early_ready(void) { return metroid_console_ready(); }
-static unsigned framebuffer_console;
 int sweet_early_owns_console(void) { return !framebuffer_console; }
 void sweet_early_framebuffer_console(void) { framebuffer_console = 1; }
+/* Called after vcattach's msgbuf replay, and after timebase initialization.
+ * Replayed text already has timestamps and uses vcputc directly. */
+void sweet_console_enable_timestamps(void)
+{
+    log_line_start = 1;
+    timestamp_enabled = 1;
+}
 int sweet_early_framebuffer(uint64_t *base, uint32_t *width,
     uint32_t *height, uint32_t *stride)
 {
@@ -37,8 +76,8 @@
 {
     if (panicking) return;
     panicking = 1;
-    metroid_console_string("\nMETROID PANIC: ");
+    for (const char *p = "\nMETROID PANIC: "; *p; p++) sweet_early_putc(*p);
     va_list copy; va_copy(copy, *args);
     _doprnt(fmt, &copy, sweet_early_putc, 16);
-    va_end(copy); metroid_console_putc('\n');
+    va_end(copy); sweet_early_putc('\n'); sweet_early_flush();
 }
