+void sweet_console_enable_timestamps(void);
 int sweet_early_framebuffer(uint64_t *base, uint32_t *width, uint32_t *height, uint32_t *stride);
 void sweet_early_panic(const char *fmt, va_list *args);
 void sweet_early_relocate(uint64_t base);
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -247,13 +247,11 @@
 _cnputc(char c, bool poll)
 {
 #if defined(SWEET)
-    /* The Metroid overlay owns the firmware scanout from first C entry.
-     * printf/panic output must not go to vcputc before serial_init completes. */
-    if (sweet_early_owns_console()) {
-        (void)poll;
-        sweet_early_putc(c);
-        return;
-    }
+    /* One sink before and after handoff. The serial backend also uses it;
+     * dispatching back through serial here would risk a recursive loop. */
+    (void)poll;
+    sweet_early_putc(c);
+    return;
 #endif
 
