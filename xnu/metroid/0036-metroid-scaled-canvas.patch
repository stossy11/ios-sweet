+/* A logical default framebuffer must not expose full-resolution panel
+ * memory as a smaller surface. Account and zero its cached backing exactly
+ * like ordinary userspace-created surfaces. */
+SweetSurface *
+sweet_surface_create_canvas(uint32_t width, uint32_t height)
+{
+	if (!width || !height || width > 16384 || height > 16384) return NULL;
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) return NULL;
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = (width * 4 + 63) & ~63u;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = 0x42475241;
+	s->allocSize = (uint32_t)round_page((uint64_t)s->bytesPerRow * height);
+	uint64_t previous = (uint64_t)OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+	IOBufferMemoryDescriptor *mem = NULL;
+	if (previous + s->allocSize <= SWEET_SURFACE_WIRED_MAX) {
+		mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+	}
+	if (mem == NULL) {
+		OSAddAtomic64(-(SInt64)s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+		s->release();
+		return NULL;
+	}
+	s->memory = mem;
+	s->mapCache = kIOMapDefaultCache;
+	bzero(mem->getBytesNoCopy(), s->allocSize);
+	if (!sweet_surface_publish(s)) {
 		s->release();
 		return NULL;
 	}
