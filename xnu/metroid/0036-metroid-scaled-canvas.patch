+++ b/iokit/Kernel/arm/metroid_canvas_scale.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: MIT
+ * Metroid CPU canvas presentation. Coordinates are logical canvas pixels;
+ * scanout addresses/stride always remain those validated at firmware handoff.
+ * Nearest neighbour, with one cached row per source row. No allocation here.
+ */
+#ifndef METROID_CANVAS_SCALE_H
+#define METROID_CANVAS_SCALE_H
+
+static inline int64_t mc_max(int64_t a, int64_t b) { return a > b ? a : b; }
+static inline int64_t mc_min(int64_t a, int64_t b) { return a < b ? a : b; }
+
+static bool
+metroid_canvas_present(uint8_t *dst, uint64_t dst_size, uint32_t pw, uint32_t ph,
+    uint32_t dst_stride, const uint8_t *src, uint64_t src_size,
+    uint32_t sw, uint32_t sh, uint32_t src_stride, uint32_t offset,
+    uint32_t cw, uint32_t ch, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+    int32_t w, int32_t h, const uint16_t *xmap, uint32_t *row)
+{
+    if (!dst || !src || !xmap || !row || !pw || !ph || !cw || !ch || !sw || !sh ||
+        pw > 16384 || ph > 16384 || cw > pw || ch > ph ||
+        (uint64_t)pw * 4 > dst_stride || (uint64_t)sw * 4 > src_stride ||
+        (offset & 3) || (src_stride & 3) || (dst_stride & 3) ||
+        (uint64_t)dst_stride * ph > dst_size ||
+        (uint64_t)offset + (uint64_t)(sh - 1) * src_stride + (uint64_t)sw * 4 > src_size)
+        return false;
+    if (w <= 0 || h <= 0) {
+        if (sw > INT32_MAX || sh > INT32_MAX) return false;
+        w = (int32_t)sw;
+        h = (int32_t)sh;
+    }
+    int64_t left = mc_max(0, mc_max(dx, (int64_t)dx - sx));
+    int64_t top = mc_max(0, mc_max(dy, (int64_t)dy - sy));
+    int64_t right = mc_min(cw, mc_min((int64_t)dx + w, (int64_t)dx + sw - sx));
+    int64_t bottom = mc_min(ch, mc_min((int64_t)dy + h, (int64_t)dy + sh - sy));
+    if (left >= right || top >= bottom) return false;
+    uint32_t x0 = (uint32_t)((left * pw + cw - 1) / cw);
+    uint32_t x1 = (uint32_t)((right * pw + cw - 1) / cw);
+    uint32_t y0 = (uint32_t)((top * ph + ch - 1) / ch);
+    uint32_t y1 = (uint32_t)((bottom * ph + ch - 1) / ch);
+    uint32_t last = UINT32_MAX;
+    for (uint32_t y = y0; y < y1; y++) {
+        uint32_t source_y = (uint32_t)((int64_t)((uint64_t)y * ch / ph) - dy + sy);
+        if (source_y != last) {
+            const uint32_t *srow = (const uint32_t *)(src + offset + (uint64_t)source_y * src_stride);
+            for (uint32_t x = x0; x < x1; x++) {
+                uint32_t source_x = (uint32_t)((int64_t)xmap[x] - dx + sx);
+                row[x] = srow[source_x];
+            }
+            last = source_y;
+        }
+        memcpy(dst + (uint64_t)y * dst_stride + (uint64_t)x0 * 4,
+            row + x0, (size_t)(x1 - x0) * 4);
+    }
+    return true;
+}
+#endif
