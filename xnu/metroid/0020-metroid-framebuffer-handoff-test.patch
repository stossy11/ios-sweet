+#if defined(SWEET)
+/* Called only by the Metroid overlay after PE_create_console hands off output.
+ * Use the video console's resolved mapping, not the early-console alias.
+ * This tests framebuffer writes independently of text-console enablement.
+ */
+void vc_metroid_handoff_test(void);
+void
+vc_metroid_handoff_test(void)
+{
+	if (!vinfo.v_baseaddr || vinfo.v_depth != 32 || !vinfo.v_width ||
+	    vinfo.v_height < 8 || (vinfo.v_baseaddr & 3) ||
+	    (vinfo.v_rowbytes & 3) || vinfo.v_width > vinfo.v_rowbytes / 4) {
+		return;
+	}
+
+	/* Eight red scanlines across the middle, away from early boot text. */
+	unsigned int top = (vinfo.v_height - 8) / 2;
+	for (unsigned int y = top; y < top + 8; y++) {
+		volatile uint32_t *row = (volatile uint32_t *)(vinfo.v_baseaddr +
+		    (uint64_t)y * vinfo.v_rowbytes);
+		for (unsigned int x = 0; x < vinfo.v_width; x++) {
+			row[x] = 0xffff0000U; /* Firmware's 32-bit B,G,R,A layout. */
+		}
+	}
+	/* Complete the stores; retain firmware scanout without a CTL_START. */
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif
