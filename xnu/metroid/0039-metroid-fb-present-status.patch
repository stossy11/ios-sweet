+/* One layer's outcome for the panel. A skip of this frame wins over a copy. */
+static void
+sweet_fb_note_layer(uint32_t layer, uint32_t id, const SweetSurface *s, const char *what,
+    uintptr_t src, bool *skip_noted)
+{
+	bool skip = strcmp(what, "copy") != 0;
+	if (skip) {
+		sweet_fb_skipped++;
+	} else {
+		sweet_fb_copied++;
+	}
+	if (*skip_noted && !skip) {
+		return;
+	}
+	*skip_noted = *skip_noted || skip;
+	char fmt[5] = "----";
+	uint32_t pixel = 0;
+	if (s != NULL) {
+		for (unsigned i = 0; i < 4; i++) {
+			char c = (char)(s->pixelFormat >> (24 - 8 * i));
+			fmt[i] = c >= 32 && c <= 126 ? c : '?';
+		}
+		/* Centre pixel of the source, when it was copied (bounds already proven). */
+		if (!skip && src && s->memory && s->width && s->height) {
+			uint64_t at = (uint64_t)s->offset + (uint64_t)(s->height / 2) * s->bytesPerRow +
+			    (uint64_t)(s->width / 2) * 4;
+			if (at + 4 <= s->memory->getLength()) {
+				pixel = *(const volatile uint32_t *)(src + at);
+			}
+		}
+	}
+	snprintf(sweet_fb_present_detail, sizeof(sweet_fb_present_detail),
+	    "L%u s%u %s %ux%u b%u e%ux%u %s %08x", layer, id, fmt,
+	    s ? s->width : 0, s ? s->height : 0, s ? s->bytesPerElement : 0,
+	    s ? s->elementWidth : 0, s ? s->elementHeight : 0, what, pixel);
+}
