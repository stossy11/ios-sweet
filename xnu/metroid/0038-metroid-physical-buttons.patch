+/* SPDX-License-Identifier: GPL-2.0-only
+ * Nothing Phone (3) physical buttons. Register layout checked against NothingOSS
+ * 031e8669eb198d93e69532b01af973a1c2a82710: spmi-pmic-arb.c,
+ * pm8941-pwrkey.c and pinctrl-spmi-gpio.c. Board wiring: metroid-live.txt.
+ * Only observer EXT_READL commands are written; no PMIC configuration/IRQ,
+ * reset, regulator or panel-power writes. One thread owns these channels.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int, int);
+void metroid_keys_init(void);
+
+#define MK_CORE_PA 0x0c400000u
+#define MK_CNFG_PA 0x0c42d000u
+#define MK_OBS_PA  0x0c440000u
+#define MK_CORE_SIZE 0x3000u
+#define MK_CNFG_SIZE 0x4000u
+#define MK_OBS_SIZE 0x80000u
+#define MK_NONE 0xffffu
+#define MK_PON 0x1310u /* SID0, GEN3 HLOS: power bit7, resin/vol-down bit6 */
+#define MK_GPIO 0x8d10u /* SID1 GPIO6: 0x8800 + (6-1)*0x100, active low */
+#define MK_POLL_MS 10u
+#define MK_DEBOUNCE 3u /* three valid samples spanning at least20ms */
+#define MK_LOST 20u /* release and disarm after200ms without valid input */
+
+static vm_offset_t mk_core, mk_cnfg, mk_obs;
+static bool mk_started;
+static int mk_sleep_chan;
+static uint32_t mk_status;
+
+struct mk_channel {
+	uint16_t apid;
+	bool pending;
+};
+static struct mk_channel mk_pon = { MK_NONE, false };
+static struct mk_channel mk_gpio = { MK_NONE, false };
+
+struct mk_key {
+	bool armed, down, candidate;
+	unsigned samples, lost;
+};
+static struct mk_key mk_keys[3];
+
+static uint32_t
+mk_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+mk_command(uint32_t off, uint32_t command)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(mk_obs + off) = command;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+mk_geometry(uint32_t version, uint32_t features, unsigned *count)
+{
+	/* This board uses bus0, EE0 and the v7 layout. Reject unknown layouts. */
+	*count = features & 0x7ffu;
+	return version >= 0x70000000u && version < 0x80000000u &&
+	    features != 0xffffffffu && *count > 0 && *count <= 1024;
+}
+
+static uint16_t
+mk_find(uint16_t ppid, unsigned count)
+{
+	uint16_t found = MK_NONE;
+	for (unsigned i = 0; i < count; ++i) {
+		uint32_t map = mk_rd(mk_core, 0x2000u + 4u * i);
+		if (!map || map == 0xffffffffu || ((map >> 8) & 0xfffu) != ppid)
+			continue;
+		uint32_t owner = mk_rd(mk_cnfg, 4u * i);
+		if (owner == 0xffffffffu) continue;
+		/* Same duplicate-PPID selection as the vendor v7 driver. */
+		if (found == MK_NONE || (owner & 7u) == 0) found = (uint16_t)i;
+	}
+	return found;
+}
+
+static bool
+mk_read(struct mk_channel *channel, uint16_t addr, uint8_t *value)
+{
+	if (channel->apid == MK_NONE || channel->apid >= 1024) return false;
+	uint32_t off = 0x20u * channel->apid; /* v7 observer, EE0 */
+	if (channel->pending) {
+		mk_status = mk_rd(mk_obs, off + 8);
+		if (mk_status != 0xffffffffu && (mk_status & 1u))
+			channel->pending = false;
+		/* A late completion belongs to the timed-out request, discard it. */
+		return false;
+	}
+	channel->pending = true;
+	mk_command(off, (1u << 27) | ((uint32_t)(addr & 0xffu) << 4));
+	for (unsigned us = 0; us < 1000; ++us) {
+		mk_status = mk_rd(mk_obs, off + 8);
+		if (mk_status == 0xffffffffu) return false;
+		if (mk_status & 1u) {
+			channel->pending = false;
+			if (mk_status & 0x0eu) return false;
+			uint32_t data = mk_rd(mk_obs, off + 0x18);
+			if (data == 0xffffffffu) return false;
+			*value = (uint8_t)data;
+			return true;
+		}
+		delay(1);
+	}
+	/* Do not overwrite an outstanding read on the next poll. */
+	return false;
+}
+
+static bool
+mk_pon_valid(void)
+{
+	uint8_t subtype;
+	return mk_read(&mk_pon, 0x1305, &subtype) && subtype == 9;
+}
+
+static bool
+mk_gpio_valid(void)
+{
+	uint8_t type, subtype, mode, enable, source;
+	if (!mk_read(&mk_gpio, 0x8d04, &type) || type != 0x10 ||
+	    !mk_read(&mk_gpio, 0x8d05, &subtype) ||
+	    !mk_read(&mk_gpio, 0x8d40, &mode) ||
+	    !mk_read(&mk_gpio, 0x8d46, &enable) || !(enable & 0x80u))
+		return false;
+	/* Require normal digital INPUT, leaving bootloader GPIO state intact. */
+	if (subtype >= 0x10 && subtype <= 0x13)
+		return (mode & 3u) == 0 &&
+		    mk_read(&mk_gpio, 0x8d44, &source) && (source & 0xfu) == 0;
+	if (subtype == 1 || subtype == 5 || subtype == 9 || subtype == 13)
+		return ((mode >> 4) & 7u) == 0 && ((mode >> 1) & 7u) == 0;
+	return false;
+}
+
+static void
+mk_sample(unsigned key, bool valid, bool down)
+{
+	struct mk_key *s = &mk_keys[key];
+	if (!valid) {
+		s->samples = 0;
+		if (s->lost < MK_LOST) ++s->lost;
+		if (s->lost == MK_LOST) {
+			if (s->down) sweet_hid_key((int)key, 0);
+			s->down = false;
+			s->armed = false;
+		}
+		return;
+	}
+	s->lost = 0;
+	if (!s->samples || s->candidate != down) {
+		s->candidate = down;
+		s->samples = 1;
+	} else if (s->samples < MK_DEBOUNCE) ++s->samples;
+	if (s->samples < MK_DEBOUNCE) return;
+	/* Ignore keys held during boot or transport loss until stable release. */
+	if (!s->armed) {
+		if (!down) s->armed = true;
+		return;
+	}
+	if (down != s->down) {
+		s->down = down;
+		printf("METROID KEYS: key=%u down=%u\n", key, down);
+		sweet_hid_key((int)key, down);
+	}
+}
+
+static void
+mk_poll(bool pon_valid, bool gpio_valid)
+{
+	uint8_t pon = 0, gpio = 0;
+	bool pok = pon_valid && mk_read(&mk_pon, MK_PON, &pon);
+	bool gok = gpio_valid && mk_read(&mk_gpio, MK_GPIO, &gpio);
+	mk_sample(0, pok, !!(pon & 0x80u));
+	mk_sample(1, gok, !(gpio & 1u));
+	mk_sample(2, pok, !!(pon & 0x40u));
+}
+
+static void
+mk_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	bool pok = false, gok = false;
+	unsigned tick = 0;
+	for (;;) {
+		if (tick++ % 100u == 0) {
+			bool p = mk_pon_valid(), g = mk_gpio_valid();
+			if (tick == 1 || p != pok || g != gok)
+				printf("METROID KEYS: PON-ready=%u GPIO6-ready=%u status=%#x\n",
+				    p, g, mk_status);
+			pok = p;
+			gok = g;
+		}
+		mk_poll(pok, gok);
+		uint64_t deadline;
+		clock_interval_to_deadline(MK_POLL_MS, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&mk_sleep_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void
+metroid_keys_init(void)
+{
+	int enabled = 1;
+	if (mk_started) return;
+	mk_started = true;
+	(void)PE_parse_boot_argn("metroidkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("METROID KEYS: disabled (metroidkeys=0)\n");
+		return;
+	}
+	mk_core = ml_io_map(MK_CORE_PA, MK_CORE_SIZE);
+	mk_cnfg = ml_io_map(MK_CNFG_PA, MK_CNFG_SIZE);
+	mk_obs = ml_io_map(MK_OBS_PA, MK_OBS_SIZE);
+	if (!mk_core || !mk_cnfg || !mk_obs) goto fail;
+	unsigned count;
+	uint32_t version = mk_rd(mk_core, 0), features = mk_rd(mk_core, 4);
+	if (!mk_geometry(version, features, &count)) {
+		printf("METROID KEYS: unsupported arbiter version=%#x features=%#x\n",
+		    version, features);
+		goto fail;
+	}
+	mk_pon.apid = mk_find(0x013, count);
+	mk_gpio.apid = mk_find(0x18d, count);
+	printf("METROID KEYS: v7=%#x bus0 EE0 count=%u PON-apid=%u GPIO6-apid=%u\n",
+	    version, count, mk_pon.apid, mk_gpio.apid);
+	if (mk_pon.apid == MK_NONE && mk_gpio.apid == MK_NONE) goto fail;
+	thread_t thread;
+	kern_return_t kr = kernel_thread_start(mk_thread, NULL, &thread);
+	if (kr != KERN_SUCCESS) {
+		printf("METROID KEYS: thread creation failed %d\n", kr);
+		goto fail;
+	}
+	thread_deallocate(thread);
+	return;
+fail:
+	printf("METROID KEYS: unavailable; reader stopped\n");
+	if (mk_obs) ml_io_unmap(mk_obs, MK_OBS_SIZE);
+	if (mk_cnfg) ml_io_unmap(mk_cnfg, MK_CNFG_SIZE);
+	if (mk_core) ml_io_unmap(mk_core, MK_CORE_SIZE);
+	mk_obs = mk_cnfg = mk_core = 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
