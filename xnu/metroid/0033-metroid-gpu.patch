+    for (unsigned i = 0; i < nm; i++) {
+        uint32_t m = rd(io, s, 0x800 + i * 4);
+        if (m == UINT32_MAX) return MG_IO;
+        if (!(m & BIT(31))) { if (free_smr == UINT32_MAX) free_smr = i; continue; }
+        if (!(((m & 0xffff) ^ 1u) & ~((m >> 16) & 0x7fff))) return MG_BUSY;
+    }
+    if (free_smr == UINT32_MAX) return MG_LIMIT;
+    int ret;
