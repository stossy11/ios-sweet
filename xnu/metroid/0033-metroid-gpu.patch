+/* Diagnostic only: the last open attempt is shown on the framebuffer status
+ * line, because Metal's compiler library hides a refused open behind
+ * "no msm device to open". newUserClient runs in the opening process. */
+static char gem_open_status[96];
+static IOSimpleLock *gem_open_lock;
+static void note_open(const char *result)
+{
+    char name[32], line[sizeof(gem_open_status)];
+    proc_selfname(name,sizeof(name));
+    snprintf(line,sizeof(line),"HakiosGPU open: %s[%d] uid=%u %s",name,proc_selfpid(),kauth_getuid(),result);
+    IOLog("METROID GPU: %s\n",line);
+    if (!gem_open_lock) return;
+    IOSimpleLockLock(gem_open_lock);
+    strlcpy(gem_open_status,line,sizeof(gem_open_status));
+    IOSimpleLockUnlock(gem_open_lock);
+}
+extern "C" size_t metroid_gpu_gem_open_status(char *out, size_t bytes)
+{
+    if (!out || !bytes) return 0;
+    out[0] = 0;
+    if (!gem_open_lock) return 0;
+    IOSimpleLockLock(gem_open_lock);
+    strlcpy(out,gem_open_status,bytes);
+    IOSimpleLockUnlock(gem_open_lock);
+    return strlen(out);
+}
+IOReturn HakiosGPU::newUserClient(task_t task, void *security, UInt32 type,
+    OSDictionary *properties, IOUserClient **out)
+{
+    if (!out) return kIOReturnBadArgument;
+    *out = nullptr;
+    if (type || !metroid_gpu_gem_ready()) { note_open(type ? "REFUSED (bad type)" : "REFUSED (GPU not ready)"); return kIOReturnNotReady; }
+    auto client = new HakiosGPUUserClient;
+    if (!client) return kIOReturnNoMemory;
+    if (!client->initWithTask(task,security,type,properties)) { client->release(); return kIOReturnError; }
+    if (!client->attach(this)) { client->release(); return kIOReturnError; }
+    if (!client->start(this)) { client->detach(this); client->release(); return kIOReturnError; }
+    note_open("ok");
+    *out = client; return kIOReturnSuccess;
+}
+extern "C" int metroid_gpu_gem_install(const mg_gem_ops *owner)
+{
+    if (!gem_open_lock) gem_open_lock = IOSimpleLockAlloc();
+    if (!owner || !owner->ready || !owner->map || !owner->unmap || !owner->submit ||
+        !owner->wait || !owner->parameter || !owner->ready(owner->context)) return MG_UNBACKED;
+    unsigned expected = 0;
+    if (!__atomic_compare_exchange_n(&installed,&expected,1,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE)) return MG_BUSY;
+    ops = *owner;
+    device_lock = IOLockAlloc();
+    IOService *provider = IOService::getPlatform();
+    auto service = new HakiosGPU;
+    if (!device_lock || !provider || !service) {
+        if (service) service->release();
+        if (device_lock) { IOLockFree(device_lock); device_lock = nullptr; }
+        return MG_LIMIT;
+    }
+    if (!service->init() || !service->attach(provider)) { service->release(); return MG_IO; }
+    if (!service->start(provider)) { service->detach(provider); service->release(); return MG_IO; }
+    service->setName("HakiosGPU");
+    service->setProperty("GPUChipID",MG_CHIP_ID,32);
+    service->setProperty("SynchronousSubmission",true);
+    __atomic_store_n(&installed,2,__ATOMIC_RELEASE);
+    service->registerService(); service->release();
+    metroid_gpu_metal_ready();
+    IOLog("METROID GEM: HakiosGPU published after GPU execution proof\n");
+    return MG_OK;
+}
