+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef METROID_GPU_VM_H
+#define METROID_GPU_VM_H
+#include "metroid_gpu_start.h"
+#define MG_VM_PAGE 4096u
+#define MG_VM_READ 1u
+#define MG_VM_WRITE 2u
+#define MG_VM_EXEC 4u
+#define MG_VM_PRIV 8u
+#define MG_VM_MAX_PAGES 16384u
+
+/* Independent 32-bit IOVA spaces, backed by XNU's wired 16K pages split
+ * into 4K translations. Physical pages may be scattered and above 4GB.
+ * One owner serializes all calls. Storage and every mapped physical page
+ * stay pinned until successful unmap/TLB synchronization. There is no
+ * remapping of valid entries and no implicit freeing after faults.
+ */
+struct mg_vm {
+    struct mg_page_tables tables;
+    struct mg_smmu_domain domain;
+    struct mg_smmu_io io;
+    void *context;
+    bool (*powered)(void *); /* prove SMMU access is safe before MMIO */
+    bool (*idle)(void *); /* all jobs fenced, or firmware awaiting new allocation */
+    unsigned mapped_pages;
+    int error;
+    bool initialized, exposed, quarantined;
+};
+int mg_vm_init(struct mg_vm *, void *cpu, uint64_t pa, size_t bytes,
+    const struct mg_smmu_io *, void *, bool (*powered)(void *), bool (*idle)(void *));
+int mg_vm_attach(struct mg_vm *, unsigned stream);
+/* Stream2 is reserved for the protected owner: table pool must already be
+ * shared HLOS RW/CP_PIXEL R; data must be CP_PIXEL-only before mapping. */
+/* Extend a domain already attached by the cold GMU owner. Never zeros,
+ * reattaches or changes the existing routes, ASID or boot mappings. */
+int mg_vm_adopt(struct mg_vm *, const struct mg_page_tables *,
+    const struct mg_smmu_domain *, const struct mg_smmu_io *, void *,
+    bool (*powered)(void *), bool (*idle)(void *));
+/* Mappings must avoid IOVA zero. pages[] contains page-aligned, pinned host
+ * physical addresses. It is host metadata, never read by the device.
+ * On an error after exposed becomes true, retain backing even if map failed.
+ */
+int mg_vm_map(struct mg_vm *, uint32_t iova, const uint64_t *pages,
+    unsigned count, unsigned access);
+int mg_vm_unmap(struct mg_vm *, uint32_t iova, unsigned count);
+/* Check live ownership/fault state without requiring an idle queue. */
+int mg_vm_validate(struct mg_vm *);
+/* Owner verification, used when validating jobs and memory requests. No MMIO.
+ * Checks the software page tables, not CPU cache visibility or GPU readiness. */
+bool mg_vm_contains(const struct mg_vm *, uint32_t iova, const uint64_t *pages,
+    unsigned count, unsigned access);
+#endif
