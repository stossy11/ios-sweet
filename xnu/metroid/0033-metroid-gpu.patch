+static int firmware_allocation(void *p, struct mg_sched_allocation *request)
+{
+    struct mg_accel *a = p;
+    unsigned size_shift = (request->align >> 8) & 255, va_shift = request->align & 255;
+    if (size_shift > 26 || va_shift > 26) return MG_LIMIT;
+    uint32_t alignment = 1u << (va_shift < 12 ? 12 : va_shift);
+    uint64_t unit = 1ull << (size_shift < 14 ? 14 : size_shift);
+    uint64_t bytes = ((uint64_t)request->bytes+unit-1) & ~(unit-1);
+    bool secure = (request->flags & 0x1000) != 0;
+    if (secure) {
