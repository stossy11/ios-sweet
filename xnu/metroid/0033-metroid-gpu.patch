+int metroid_gpu_rpmh_fabric_enable(void)
+{
+    if (__atomic_exchange_n(&rh_lock,1,__ATOMIC_ACQUIRE)) return EBUSY;
+    uint32_t address[4] = {0}, data[4];
+    int error = EIO;
