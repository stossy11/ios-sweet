+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef METROID_GPU_QUEUE_H
+#define METROID_GPU_QUEUE_H
+
+#include "metroid_gpu.h"
+
+#define MG_QUEUE_MAX_WAIT_US 100000u
+
+/* Single in-flight kernel job. Zero-initialize once per hardware lifetime.
+ * The caller serializes submit/wait and uses the same immutable backend for
+ * the life of the queue. Callbacks must never re-enter the queue. Jobs must be validated, pinned and retained before
+ * submission. Once dispatch is called the queue owns that reference, even
+ * on error. A nonzero output fence indicates that ownership transferred.
+ * Quarantined jobs remain pinned until hardware DMA is drained.
+ * This interface must only receive trusted kernel-generated jobs.
+ */
+struct mg_queue {
+    void *job;
+    uint64_t issued, completed;
+    bool quarantined;
+};
+
+struct mg_queue_io {
+    void *context;
+    bool (*ready)(void *);
+    /* Publish command/data buffers, then enqueue with this fence value. */
+    int (*dispatch)(void *, void *job, uint64_t fence);
+    /* Nonblocking. MG_EMPTY if pending. MG_OK only after all job DMA is
+     * complete and device writes are CPU-visible. Other results quarantine.
+     */
+    int (*complete)(void *, uint64_t fence);
+    void (*retire)(void *, void *job);
+    void (*delay)(void *, unsigned microseconds);
+};
+
+int mg_queue_submit(struct mg_queue *, const struct mg_queue_io *, void *job,
+    uint64_t *fence);
+int mg_queue_wait(struct mg_queue *, const struct mg_queue_io *, uint64_t fence,
+    unsigned timeout_us);
+
+#endif
