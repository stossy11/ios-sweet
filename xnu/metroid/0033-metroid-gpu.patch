+static bool reserved_image(const char *name, const void **image, size_t *bytes)
+{
+    DTEntry node; const void *property; unsigned size = 0;
+    const boot_args *args = PE_state.bootArgs;
+    if (!args || args->Version != 2 ||
+        SecureDTLookupEntry(NULL,"/chosen/memory-map",&node) != kSuccess ||
+        SecureDTGetProperty(node,name,&property,&size) != kSuccess || size != 16) return false;
+    uint64_t extent[2]; memcpy(extent,property,sizeof(extent));
+    uint64_t pa = extent[0], n = extent[1];
+    if (!n || n > MG_FW_MAX_BYTES || (pa & PAGE_MASK) || pa < args->physBase ||
+        args->topOfKernelData < args->physBase ||
+        args->topOfKernelData-args->physBase > args->memSize ||
+        pa > args->topOfKernelData || n > args->topOfKernelData-pa) return false;
+    *image = (const void *)ml_static_ptovirt((vm_offset_t)pa); *bytes = (size_t)n;
+    return true;
+}
+static void mg_payload_check(bool prepare_memory, bool live, bool accelerator)
+{
+    DTEntry node;
+    const void *property;
+    unsigned size = 0;
+    static struct mg_fw_plan plan;
+    struct mg_accel_images images = {0};
+    if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+        SecureDTGetProperty(node, "MetroidGMU", &property, &size) != kSuccess || size != 16) {
+        printf("METROID GPU: no reserved MetroidGMU image; use metroid-gpu-payload.py\n");
+        if (accelerator) metroid_gpu_accelerator_init(NULL,0,&images);
+        else if (live) metroid_gpu_live_init(NULL, 0);
+        return;
+    }
+    uint64_t extent[2];
+    memcpy(extent, property, sizeof(extent));
+    const boot_args *args = PE_state.bootArgs;
+    uint64_t pa = extent[0], bytes = extent[1];
+    if (!args || args->Version != 2 || !bytes || bytes > MG_FW_MAX_BYTES ||
+        (pa & PAGE_MASK) || pa < args->physBase ||
+        args->topOfKernelData < args->physBase ||
+        args->topOfKernelData - args->physBase > args->memSize ||
+        pa > args->topOfKernelData || bytes > args->topOfKernelData - pa) {
+        printf("METROID GPU: invalid reserved GMU firmware extent\n");
+        if (accelerator) metroid_gpu_accelerator_init(NULL,0,&images);
+        else if (live) metroid_gpu_live_init(NULL, 0);
+        return;
+    }
+    const void *image = (const void *)ml_static_ptovirt((vm_offset_t)pa);
+    int result = mg_fw_parse(image, (size_t)bytes, &plan);
+    printf("METROID GPU: reserved GMU preflight result=%d bytes=%llu blocks=%u reservations=%u\n",
+        result, (unsigned long long)bytes, plan.count, plan.reservation_count);
+    if (accelerator) {
+        if (!result && (!reserved_image("MetroidSQE",&images.sqe,&images.sqe_bytes) ||
+            !reserved_image("MetroidAQE",&images.aqe,&images.aqe_bytes) ||
+            !reserved_image("MetroidZAP",&images.zap,&images.zap_bytes))) result = MG_UNBACKED;
+        const void *parts[] = {image,images.sqe,images.aqe,images.zap};
+        const size_t lengths[] = {(size_t)bytes,images.sqe_bytes,images.aqe_bytes,images.zap_bytes};
+        for (unsigned i = 0; !result && i < 4; i++) for (unsigned j = 0; j < i; j++) {
+            uintptr_t a = (uintptr_t)parts[i], b = (uintptr_t)parts[j];
+            if (a < b+lengths[j] && b < a+lengths[i]) result = MG_INVALID;
+        }
+        if (result) printf("METROID GPU: mode6 requires distinct reserved GMU/SQE/AQE/ZAP firmware images; result=%d\n",result);
+        metroid_gpu_accelerator_init(result ? NULL : image,result ? 0 : (size_t)bytes,&images);
+        return;
+    }
+    if (live) {
+        metroid_gpu_live_init(result ? NULL : image, result ? 0 : (size_t)bytes);
+        return;
+    }
+    if (!result && prepare_memory) {
+        /* A deliberately separate preflight mode: allocate actual wired XNU
+         * backing and construct all stream-5 tables without exposing them to
+         * hardware. This can be tested before a GMU boot changes SMMU state.
+         * Never put this large ownership object on the kernel stack.
+         */
+        static struct mg_gmu_memory memory;
+        const struct mg_memory_io io = {NULL, mg_kernel_allocate, mg_kernel_release};
+        result = mg_gmu_memory_prepare(&memory, &io, image, (size_t)bytes);
+        printf("METROID GPU: memory-preflight result=%d ranges=%u firmware=%u tables=%u bytes=%lu\n",
+            result, memory.count, memory.firmware_count, memory.tables.used,
+            (unsigned long)memory.allocated);
+        if (!result) {
+            printf("METROID GPU: HFI=%#x log=%#x VRB=%#x; no SMMU attachment or DMA\n",
+                memory.config.hfi, memory.config.log, memory.config.vrb);
+            /* Safe only because no device has ever seen these allocations. */
+            (void)mg_gmu_memory_release(&memory, &io);
+        }
+    }
+    printf("METROID GPU: firmware preflight only; no power writes, SMMU changes or firmware execution\n");
+}
