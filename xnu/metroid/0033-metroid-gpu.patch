+static void encode(uint32_t *out, const struct mg_sched_allocation *a)
+{
+    out[0] = (uint32_t)a->gpu; out[1] = (uint32_t)(a->gpu >> 32);
+    out[2] = a->flags; out[3] = a->kind; out[4] = a->host_handle;
+    out[5] = a->firmware_handle; out[6] = a->gmu;
+    out[7] = a->bytes; out[8] = a->align;
+}
+static int allocation_reply(struct mg_scheduler *s, const uint32_t *in, unsigned words)
+{
+    if ((words != 10 && words != 11) || in[1] > 1 ||
+        (in[1] == 1 && words != 11) || (in[1] == 0 && words != 10)) return MG_INVALID;
+    /* Preserve the exact request before validating policy or invoking the
