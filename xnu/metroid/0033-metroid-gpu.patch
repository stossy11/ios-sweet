+    /* hfi_table_cmd version0/typeGPU_PERF, two GX OPPs and two CX OPPs. */
+    uint32_t p[] = {15,0,1,2,3,0,UINT32_MAX,0,
+        (voltage[0] << 16) | (index[3] << 8) | index[0],
+        0xffffc0ffu | (index[1] << 8),264000,
+        2,2,0,0,(voltage[2] << 16) | (index[1] << 8) | index[2],500000};
+    for (unsigned i = 0; i < sizeof(p)/sizeof(p[0]); i++) perf[i] = p[i];
+    for (unsigned i = 0; i < 160; i++) bw[i] = 0;
+    bw[0] = 3; bw[1] = 2; bw[2] = 1; bw[3] = 3; bw[4] = 1; bw[5] = 7;
+    error = mg_bcm_address("CN0",&bw[6]); if (error) goto out;
+    const char *bcm[] = {"MC0","SH0","SH1"};
+    for (unsigned i = 0; i < 3; i++) {
+        error = mg_bcm_address(bcm[i],&bw[24+i]); if (error) goto out;
+        for (unsigned j = 0; j < i; j++) if (bw[24+i] == bw[24+j]) { error = EINVAL; goto out; }
+        if (bw[24+i] == bw[6]) { error = EINVAL; goto out; }
+        bw[32+i] = 0x40000000; /* off: committed zero vote */
+        bw[40+i] = i < 2 ? 0x6fffffff : 0x60000001;
+    }
+    bw[12] = 0x40000000; bw[18] = 0x60000001;
+out:
+    __atomic_store_n(&rh_lock,0,__ATOMIC_RELEASE);
+    return error;
+}
