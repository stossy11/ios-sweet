+#include "metroid_gpu_vm.h"
+#ifdef MG_HOST_TEST
+#include <string.h>
+#else
+#include <libkern/libkern.h>
+#endif
+#define ADDR 0x0000fffffffff000ull
+#define BIT(n) (1u << (n))
+
+static bool extent(uint32_t va, unsigned count)
+{
+    return va && !(va & 4095) && count && count <= MG_VM_MAX_PAGES &&
+        (uint64_t)va + (uint64_t)count * MG_VM_PAGE <= (1ull << 32);
+}
+static uint64_t *child(const struct mg_vm *v, uint64_t entry)
+{
+    uint64_t pa = entry & ADDR;
+    if ((entry & 3) != 3 || pa < v->tables.pa ||
+        pa - v->tables.pa >= v->tables.used * (uint64_t)MG_VM_PAGE) return NULL;
+    return (uint64_t *)((uint8_t *)v->tables.memory + pa - v->tables.pa);
+}
+static uint64_t *pte(const struct mg_vm *v, uint32_t va)
+{
+    uint64_t *root = v->tables.memory;
+    uint64_t *middle = child(v,root[va >> 30]);
+    if (!middle) return NULL;
+    uint64_t *leaf = child(v,middle[(va >> 21) & 511]);
+    return leaf ? &leaf[(va >> 12) & 511] : NULL;
+}
+static uint64_t descriptor(uint64_t pa, unsigned access)
+{
+    return pa | 3 | (access & MG_VM_PRIV ? 0 : BIT(6)) |
+        (access & MG_VM_WRITE ? 0 : BIT(7)) | (3u << 8) | BIT(10) | BIT(11) |
+        (access & MG_VM_EXEC ? 0 : (3ull << 53));
+}
+static int poison(struct mg_vm *v, int error)
+{
+    if (!v->error) v->error = error;
+    v->quarantined = true;
+    return error;
+}
+/* Verify that nobody replaced this domain before touching the live tables.
+ * Never infer idleness or DMA drain from a reset/disabled context alone. */
+int mg_vm_validate(struct mg_vm *v)
+{
+    if (!v || !v->initialized || !v->domain.attached || v->quarantined) return MG_UNBACKED;
+    if (!v->powered(v->context)) return poison(v,MG_IO);
+    const struct mg_smmu_io *io = &v->io;
+    const struct mg_smmu_domain *s = &v->domain;
+    uint32_t b = s->cb_base + (s->cb << s->page_shift);
+    uint64_t ttbr = v->tables.pa | ((uint64_t)s->asid << 48);
+    uint32_t ctl = io->read(io->context,b);
+    if (ctl == UINT32_MAX || (ctl & 0xe7u) != 0x27u ||
+        io->read(io->context,0x800 + s->smr*4) != (BIT(31) | s->stream) ||
+        io->read(io->context,0xc00 + s->smr*4) != s->cb ||
+        io->read(io->context,b + 0x20) != (uint32_t)ttbr ||
+        io->read(io->context,b + 0x24) != (uint32_t)(ttbr >> 32) ||
+        (s->lpac_routed && (io->read(io->context,0x800 + s->lpac_smr*4) != (BIT(31) | 1u) ||
+            io->read(io->context,0xc00 + s->lpac_smr*4) != s->cb))) return poison(v,MG_STALE);
+    uint32_t fsr = io->read(io->context,b + 0x58);
+    if (fsr == UINT32_MAX || (fsr & 0xc00001feu)) return poison(v,MG_IO);
+    return MG_OK;
+}
+static int owned(struct mg_vm *v)
+{
+    int error = mg_vm_validate(v);
+    return error ? error : v->idle(v->context) ? MG_OK : MG_BUSY;
+}
+static int invalidate(struct mg_vm *v)
+{
+    const struct mg_smmu_domain *s = &v->domain;
+    const struct mg_smmu_io *io = &v->io;
+    uint32_t b = s->cb_base + (s->cb << s->page_shift);
+    io->publish(io->context,v->tables.memory,v->tables.used * MG_VM_PAGE);
+    io->write(io->context,b + 0x610,s->asid);
+    io->write(io->context,b + 0x7f0,0);
+    for (unsigned n = 0; n < 10000; n++) {
+        uint32_t value = io->read(io->context,b + 0x7f4);
+        if (value == UINT32_MAX) return poison(v,MG_IO);
+        if (!(value & 1)) return MG_OK;
+        io->delay(io->context,10);
+    }
+    return poison(v,MG_TIMEOUT);
+}
+int mg_vm_init(struct mg_vm *v, void *cpu, uint64_t pa, size_t bytes,
+    const struct mg_smmu_io *io, void *context, bool (*powered)(void *), bool (*idle)(void *))
+{
+    if (!v || !cpu || !pa || (((uintptr_t)cpu | pa | bytes) & 4095) ||
+        bytes < MG_VM_PAGE || bytes > MG_PT_MAX_PAGES * MG_VM_PAGE ||
+        bytes > UINTPTR_MAX - (uintptr_t)cpu ||
+        ((uintptr_t)cpu < (uintptr_t)v + sizeof(*v) &&
+         (uintptr_t)v < (uintptr_t)cpu + bytes) ||
+        pa >= (1ull << 48) || bytes > (1ull << 48) - pa || !io ||
+        !io->read || !io->write || !io->write64 || !io->publish || !io->delay ||
+        !powered || !idle) return MG_INVALID;
+    if (v->initialized || v->exposed) return MG_BUSY;
+    memset(cpu,0,bytes);
+    v->tables = (struct mg_page_tables){cpu,pa,bytes,1,true};
+    v->io = *io; v->context = context; v->powered = powered; v->idle = idle;
+    v->initialized = true;
+    return MG_OK;
+}
+int mg_vm_attach(struct mg_vm *v, unsigned stream)
+{
+    if (!v || !v->initialized || (stream != 0 && stream != 2 && stream != 5)) return MG_INVALID;
+    if (v->exposed) return MG_BUSY;
+    if (!v->powered(v->context) || !v->idle(v->context)) return MG_UNBACKED;
+    v->exposed = true;
+    int error = mg_smmu_attach_stream(&v->io,&v->domain,&v->tables,stream);
+    return error ? poison(v,error) : MG_OK;
+}
+int mg_vm_adopt(struct mg_vm *v, const struct mg_page_tables *t,
+    const struct mg_smmu_domain *d, const struct mg_smmu_io *io, void *context,
+    bool (*powered)(void *), bool (*idle)(void *))
+{
+    if (!v || !t || !d || !io || !powered || !idle || !io->read || !io->write ||
+        !io->write64 || !io->delay || !io->publish || !t->built || !t->memory ||
+        !t->used || t->used > MG_PT_MAX_PAGES || t->used*4096ull > t->bytes ||
+        t->bytes > MG_PT_MAX_PAGES*4096ull || (((uintptr_t)t->memory | t->pa | t->bytes) & 4095) ||
+        !d->attached || d->quarantined || (d->stream != 0 && d->stream != 5)) return MG_INVALID;
+    if (v->initialized || v->exposed) return MG_BUSY;
+    v->tables = *t; v->domain = *d; v->io = *io;
+    v->context = context; v->powered = powered; v->idle = idle;
+    v->initialized = v->exposed = true;
+    int error = owned(v); if (error) return error;
+    bool visited[MG_PT_MAX_PAGES] = {true};
+    const uint64_t *root = t->memory;
+    /* Existing GMU bootstrap uses only four root slots for a 32-bit space. */
+    for (unsigned a = 0; a < 512; a++) {
+        if (!root[a]) continue;
+        uint64_t *middle = a < 4 ? child(v,root[a]) : NULL;
+        if (!middle) return poison(v,MG_INVALID);
+        unsigned m = (unsigned)(((uint8_t *)middle-(uint8_t *)t->memory)/4096);
+        if (visited[m]) return poison(v,MG_INVALID);
+        visited[m] = true;
+        for (unsigned b = 0; b < 512; b++) {
+            if (!middle[b]) continue;
+            uint64_t *leaf = child(v,middle[b]);
+            if (!leaf) return poison(v,MG_INVALID);
+            unsigned l = (unsigned)(((uint8_t *)leaf-(uint8_t *)t->memory)/4096);
+            if (visited[l]) return poison(v,MG_INVALID);
+            visited[l] = true;
+            for (unsigned c = 0; c < 512; c++) if (leaf[c]) {
+                if ((leaf[c] & 3) != 3) return poison(v,MG_INVALID);
+                v->mapped_pages++;
+            }
+        }
+    }
+    for (unsigned i = 0; i < t->used; i++) if (!visited[i]) return poison(v,MG_INVALID);
+    return MG_OK;
+}
+int mg_vm_map(struct mg_vm *v, uint32_t va, const uint64_t *pages,
+    unsigned count, unsigned access)
+{
+    if (!v || !extent(va,count) || !pages || !(access & MG_VM_READ) ||
+        access & ~(MG_VM_READ | MG_VM_WRITE | MG_VM_EXEC | MG_VM_PRIV)) return MG_INVALID;
+    int error = owned(v); if (error) return error;
+    static const unsigned bits[] = {32,36,40,42,44,48};
+    if (v->domain.ips >= sizeof(bits)/sizeof(bits[0])) return poison(v,MG_INVALID);
+    uint64_t limit = 1ull << bits[v->domain.ips];
+    bool middle_needed[4] = {0}, leaf_needed[2048] = {0};
+    unsigned needed = 0;
+    uint64_t *root = v->tables.memory;
+    for (unsigned i = 0; i < count; i++) {
+        uint32_t address = va + i * MG_VM_PAGE;
+        if (!pages[i] || (pages[i] & 4095) || pages[i] >= limit ||
+            (pages[i] < v->tables.pa + v->tables.bytes && v->tables.pa < pages[i] + MG_VM_PAGE))
+            return MG_INVALID;
+        unsigned a = address >> 30, b = address >> 21;
+        uint64_t *middle = NULL;
+        if (root[a]) {
+            middle = child(v,root[a]);
+            if (!middle) return poison(v,MG_INVALID);
+        } else if (!middle_needed[a]) { middle_needed[a] = true; needed++; }
+        if (middle && middle[b & 511]) {
+            uint64_t *leaf = child(v,middle[b & 511]);
+            if (!leaf) return poison(v,MG_INVALID);
+            if (leaf[(address >> 12) & 511]) return MG_BUSY;
+        } else if (!leaf_needed[b]) { leaf_needed[b] = true; needed++; }
+    }
+    if (needed > v->tables.bytes / MG_VM_PAGE - v->tables.used) return MG_LIMIT;
+    for (unsigned i = 0; i < count; i++) {
+        uint32_t address = va + i * MG_VM_PAGE;
+        unsigned a = address >> 30, b = (address >> 21) & 511;
+        if (!root[a]) root[a] = (v->tables.pa + MG_VM_PAGE * (uint64_t)v->tables.used++) | 3;
+        uint64_t *middle = child(v,root[a]);
+        if (!middle[b]) middle[b] = (v->tables.pa + MG_VM_PAGE * (uint64_t)v->tables.used++) | 3;
+        uint64_t *leaf = child(v,middle[b]);
+        leaf[(address >> 12) & 511] = descriptor(pages[i],access);
+    }
+    v->mapped_pages += count;
+    return invalidate(v);
+}
+int mg_vm_unmap(struct mg_vm *v, uint32_t va, unsigned count)
+{
+    if (!v || !extent(va,count)) return MG_INVALID;
+    int error = owned(v); if (error) return error;
+    for (unsigned i = 0; i < count; i++) {
+        uint64_t *entry = pte(v,va + i * MG_VM_PAGE);
+        if (!entry || !(*entry & 1)) return MG_UNBACKED;
+    }
+    for (unsigned i = 0; i < count; i++) *pte(v,va + i * MG_VM_PAGE) = 0;
+    v->mapped_pages -= count;
+    /* Reusing table pages is intentionally unsupported. Reusing data backing
+     * requires this invalidation to succeed, not just cleared descriptors. */
+    return invalidate(v);
+}
+bool mg_vm_contains(const struct mg_vm *v, uint32_t va, const uint64_t *pages,
+    unsigned count, unsigned access)
+{
+    if (!v || !v->initialized || !v->domain.attached || v->quarantined ||
+        !pages || !extent(va,count) || !(access & MG_VM_READ) ||
+        access & ~(MG_VM_READ | MG_VM_WRITE | MG_VM_EXEC | MG_VM_PRIV)) return false;
+    for (unsigned i = 0; i < count; i++) {
+        uint64_t *entry = pte(v,va + i * MG_VM_PAGE);
+        if (!entry || (*entry & 3) != 3 || (*entry & ADDR) != pages[i] ||
+            ((access & MG_VM_WRITE) && (*entry & BIT(7))) ||
+            ((access & MG_VM_EXEC) && (*entry & (3ull << 53))) ||
+            (((access & MG_VM_PRIV) != 0) != ((*entry & BIT(6)) == 0))) return false;
+    }
+    return true;
+}
