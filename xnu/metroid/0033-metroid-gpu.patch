+    int error = submit(r,job,&fence); if (error) return error;
+    error = wait(r,fence,MG_QUEUE_MAX_WAIT_US); if (error) return error;
+    if (memcmp(output,colors,sizeof(colors))) return poison(r,MG_IO);
+    r->verified = true;
+    return MG_OK;
+}
