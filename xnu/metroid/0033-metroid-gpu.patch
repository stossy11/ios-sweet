+        if (!moved) break;
+    }
+    /* Assign before posting any PTE: all failures retain backing. */
+    if (gpu) { b->gpu = (uint32_t)start; b->gpu_access = access; }
+    else { b->gmu = (uint32_t)start; b->gmu_access = access; }
