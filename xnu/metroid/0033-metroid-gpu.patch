+static bool mg_scm_poisoned;
+
+static struct mg_scm_result invoke(uint32_t fn, uint32_t info, uint64_t arg, uint64_t b, uint64_t c, uint64_t d)
+{
+    lck_mtx_lock(&mg_scm_lock);
+    if (mg_scm_poisoned) {
+        lck_mtx_unlock(&mg_scm_lock);
+        return (struct mg_scm_result){.status = -1};
+    }
+    uint64_t command = fn, quirk = 0;
+    struct mg_scm_result result = {0};
+    for (unsigned resume = 0; resume < 64; resume++) {
+        register uint64_t x0 __asm__("x0") = command;
+        register uint64_t x1 __asm__("x1") = info;
+        register uint64_t x2 __asm__("x2") = arg;
+        register uint64_t x3 __asm__("x3") = b;
+        register uint64_t x4 __asm__("x4") = c;
+        register uint64_t x5 __asm__("x5") = d;
+        register uint64_t x6 __asm__("x6") = quirk;
+        register uint64_t x7 __asm__("x7") = 0;
+        __asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+            "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7) : :
+            "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+        result = (struct mg_scm_result){(int64_t)x0, x1};
+        if (x0 != 1) break; /* QCOM_SCM_INTERRUPTED */
+        command = 1; quirk = x6;
