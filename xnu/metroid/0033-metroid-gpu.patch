+    if (vote == UINT32_MAX) return MG_IO;
+    power_write(NULL, MG_CC, 0x7000, vote | 1);
+    unsigned us;
+    for (us = 0; us < 1000; us++) {
+        vote = power_read(NULL, MG_CC, 0x7000);
