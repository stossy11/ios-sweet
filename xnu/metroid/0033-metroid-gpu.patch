+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "metroid_gpu_start.h"
+#ifdef MG_HOST_TEST
+#include <string.h>
+#else
+#include <libkern/libkern.h>
+#endif
+
+static const struct mg_gmu_backing *find(const struct mg_gmu_loader *l,
+    uint32_t address, uint32_t size)
+{
+    for (size_t i = 0; i < l->count; i++) {
+        const struct mg_gmu_backing *b = &l->backing[i];
+        if (address >= b->iova && (uint64_t)address + size <= (uint64_t)b->iova + b->bytes)
+            return b;
+    }
+    return NULL;
+}
+static bool external(uint32_t a, uint32_t n)
+{
+    uint64_t end = (uint64_t)a + n;
+    return (a >= 0x4000 && end <= 0x1000000) ||
+        (a >= 0x60000000 && end <= 0x80000000) ||
+        (a >= 0xc0000000 && end <= 0xe0000000);
+}
+static bool alias(uintptr_t a, size_t n, uintptr_t b, size_t m)
+{ return a < b + m && b < a + n; }
+int mg_gmu_load(const void *image, size_t bytes, struct mg_fw_plan *plan,
+    const struct mg_gmu_loader *l)
+{
+    if (!l || !l->tcm_write || !l->publish || !l->backing ||
+        !l->count || l->count > MG_DMA_MAX_RANGES || !image || !plan ||
+        bytes > UINTPTR_MAX - (uintptr_t)image ||
+        alias((uintptr_t)plan,sizeof(*plan),(uintptr_t)image,bytes) ||
+        alias((uintptr_t)plan,sizeof(*plan),(uintptr_t)l,sizeof(*l)) ||
+        alias((uintptr_t)plan,sizeof(*plan),(uintptr_t)l->backing,l->count * sizeof(*l->backing)))
+        return MG_INVALID;
+    int ret = mg_fw_parse(image,bytes,plan);
+    if (ret) return ret;
+    /* No writes until all buffers and every firmware extent have passed. */
+    for (size_t i = 0; i < l->count; i++) {
+        const struct mg_gmu_backing *b = &l->backing[i];
+        if (!b->cpu || !b->bytes || ((b->iova | b->bytes | (uintptr_t)b->cpu) & 4095) ||
+            !external(b->iova,b->bytes) || b->bytes > UINTPTR_MAX - (uintptr_t)b->cpu ||
+            alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)image,bytes) ||
+            alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)plan,sizeof(*plan)) ||
+            alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)l,sizeof(*l)) ||
+            alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)l->backing,l->count * sizeof(*l->backing)))
+            return MG_INVALID;
+        for (size_t j = 0; j < i; j++) {
+            const struct mg_gmu_backing *p = &l->backing[j];
+            if (alias(b->iova,b->bytes,p->iova,p->bytes) ||
+                alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)p->cpu,p->bytes)) return MG_INVALID;
+        }
+    }
+    for (unsigned i = 0; i < plan->reservation_count; i++) {
+        const struct mg_fw_reservation *r = &plan->reservations[i];
+        if (r->region != MG_ITCM && r->region != MG_DTCM && !find(l,r->address,r->size))
+            return MG_UNBACKED;
+    }
+    for (unsigned i = 0; i < plan->count; i++) {
+        const struct mg_fw_block *b = &plan->blocks[i];
+        if (b->region != MG_ITCM && b->region != MG_DTCM && !find(l,b->address,b->size))
+            return MG_UNBACKED;
+    }
+    for (size_t i = 0; i < l->count; i++) memset(l->backing[i].cpu,0,l->backing[i].bytes);
+    for (unsigned i = 0; i < plan->count; i++) {
+        const struct mg_fw_block *b = &plan->blocks[i];
+        const uint8_t *p = (const uint8_t *)image + b->offset;
+        if (b->region == MG_ITCM || b->region == MG_DTCM) {
+            uint32_t start = b->region == MG_ITCM ? 0x1b400 : 0x1c400;
+            uint32_t base = b->region == MG_ITCM ? 0 : 0x10004000;
+            for (unsigned j = 0; j < b->size; j += 4) {
+                uint32_t word = (uint32_t)p[j] | (uint32_t)p[j+1] << 8 |
+                    (uint32_t)p[j+2] << 16 | (uint32_t)p[j+3] << 24;
+                l->tcm_write(l->context,start + (b->address - base + j)/4,word);
+            }
+        } else {
+            const struct mg_gmu_backing *v = find(l,b->address,b->size);
+            memcpy((uint8_t *)v->cpu + b->address - v->iova,p,b->size);
+        }
+    }
+    for (size_t i = 0; i < l->count; i++)
+        l->publish(l->context,l->backing[i].cpu,l->backing[i].bytes);
+    return MG_OK;
+}
