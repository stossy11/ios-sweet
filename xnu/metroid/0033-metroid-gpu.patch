+    SET(b + 0x3c, 0, UINT32_MAX);
+    uint32_t fsr = rd(io,s,b + 0x58);
+    if (fsr == UINT32_MAX) { ret = MG_IO; goto fail; }
+    io->write(io->context,b + 0x58,fsr & 0xc00001feu); /* W1C */
+    ret = check(io,s,b + 0x58,0,0xc00001feu); if (ret) goto fail;
+    ret = sync(io, s, s->asid); if (ret) goto fail;
+    /* Fault abort, no stall and no unhandled context interrupt. ASIDPNE
+     * (bit12) is only a broadcast-invalidation hint and may read as zero.
+     * Keep requesting it like Linux, but validate the functional controls. */
+    SET(b, BIT(12) | BIT(5) | BIT(2) | BIT(1) | 1,
+        BIT(7) | BIT(6) | BIT(5) | BIT(2) | BIT(1) | 1);
+    SET(0xc00 + s->smr * 4, s->cb, (3u << 16) | (3u << 24) | 255);
+    SET(0x800 + s->smr * 4, BIT(31) | stream, UINT32_MAX);
+    s->attached = true;
+    return MG_OK;
+fail:
+    /* Route might have partially posted. Pin everything and stop the new CB. */
+    io->write(io->context, b, 0);
+    s->quarantined = true;
+    return ret;
+#undef SET
+}
+
+int mg_smmu_route_lpac(const struct mg_smmu_io *io, struct mg_smmu_domain *s)
+{
+    if (!io || !io->read || !io->write || !s || !s->attached || s->quarantined ||
+        s->stream != 0) return MG_INVALID;
+    if (s->lpac_routed) return MG_BUSY;
+    uint32_t id0 = rd(io, s, 0x20), cr0 = rd(io, s, 0);
+    if (id0 == UINT32_MAX || cr0 == UINT32_MAX) return MG_IO;
+    /* Unmatched streams must fault, as attach requires: SID1 has no bypass owner. */
+    if (!(cr0 & BIT(10))) return MG_BUSY;
