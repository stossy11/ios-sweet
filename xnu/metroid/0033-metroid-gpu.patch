+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef METROID_GPU_SUBMIT_H
+#define METROID_GPU_SUBMIT_H
+#include "metroid_gpu_queue.h"
+
+#define MG_GEN8_CONTEXT_BYTES 4096u
+#define MG_GEN8_MAX_BUFFERS 64u
+#define MG_GEN8_MAX_IBS 64u
+#define MG_GEN8_MAX_JOB_BYTES (64u * 1024u * 1024u)
+#define MG_GEN8_ADDRESS_LIMIT (1ull << 49)
+#define MG_GEN8_HOST2GMU 0x1f994u /* GPU-relative dword offset */
+
+enum mg_gpu_access { MG_GPU_READ = 1, MG_GPU_WRITE = 2, MG_GPU_EXEC = 4 };
+enum mg_gpu_sync { MG_GPU_TO_DEVICE, MG_GPU_TO_CPU };
+struct mg_gen8_buffer { void *cpu; uint64_t gpu; size_t bytes; unsigned access; };
+struct mg_gen8_ib { unsigned buffer; uint32_t offset, bytes; };
+struct mg_gen8_job {
+    unsigned buffer_count, ib_count;
+    bool end_of_frame;
+    struct mg_gen8_buffer buffers[MG_GEN8_MAX_BUFFERS];
+    struct mg_gen8_ib ibs[MG_GEN8_MAX_IBS];
+};
+
+/* Exact 48-byte Gen8 gmu_context_queue_header (adreno_hfi.h). It is not
+ * the HFI control queue header: the ring has 1012 words, not 1024.
+ * This queue, HFI queues and timestamps require coherent/uncached mappings.
+ */
+struct mg_gen8_context_header {
+    uint32_t version, address, words;
+    volatile uint32_t out_fence_ts, sync_obj_ts, read, write;
+    uint32_t hw_fence_address, hw_fence_bytes, unused[3];
+};
+struct mg_gen8_config {
+    uint32_t chip_id, hfi_version, context_id, context_bank, asid;
+    uint64_t page_table; /* physical 4K-aligned root, without ASID */
+    void *hfi_memory;
+    size_t hfi_bytes;
+    uint32_t hfi_address;
+    void *context_memory; /* fresh zeroed 4K allocation in GMU stream 5 */
+    uint32_t context_address;
+    volatile uint32_t *sop, *eop; /* fresh zero timestamps in GPU stream 0 */
+    uint64_t sop_address, eop_address;
+};
+
+/* Production operations are supplied by the platform's resource owner.
+ * running() must prove clocks/power retained, HFI+hardware scheduler started,
+ * SQE/AQE and ZAP/nonsecure GPU initialization complete, and stream0/5 domains
+ * still owned. HFI controller readiness alone is NOT sufficient.
+ * context_valid() verifies the owned stream0 page-table/bank/ASID tuple.
+ * gmu_mapped() verifies the owner's retained coherent/uncached stream5 mapping.
+ * mapped() must verify this owner's pinned CPU/GPU mapping and permissions.
+ * sync() publishes commands/inputs before dispatch and makes device writes
+ * CPU-visible only after GPU retirement. It must report failures.
+ * retire() releases the caller's job reference only after successful wait.
+ * read/write take GPU-relative DWORD offsets and require ordered device MMIO;
+ * write must complete the doorbell store/barrier before returning.
+ * The callbacks must not re-enter this backend. Callers serialize every API
+ * call and keep the config, mappings, job metadata and inputs immutable while
+ * active. No userspace or unvalidated PM4 is accepted by this interface.
+ */
+struct mg_gen8_io {
+    void *context;
+    bool (*running)(void *);
+    bool (*context_valid)(void *, uint64_t page_table, uint32_t bank, uint32_t asid);
+    bool (*gmu_mapped)(void *, const void *cpu, uint32_t gmu, size_t);
+    bool (*mapped)(void *, const void *cpu, uint64_t gpu, size_t, unsigned access);
+    int (*sync)(void *, enum mg_gpu_sync, const void *, size_t);
+    uint32_t (*read)(void *, uint32_t gpu_register);
+    void (*write)(void *, uint32_t gpu_register, uint32_t value);
+    void (*delay)(void *, unsigned microseconds);
+    void (*retire)(void *, struct mg_gen8_job *);
+};
+struct mg_gen8_backend {
+    struct mg_gen8_config config;
+    struct mg_gen8_io io;
+    struct mg_hfi_queue control, messages, debug;
+    struct mg_queue queue;
+    struct mg_queue_io queue_io;
+    uint32_t control_sequence, issue_sequence, notified;
+    uint32_t waiting_header, ack_value;
+    uint32_t fault_register, fault_value, last_message_header;
+    int last_error;
+    bool bound, exposed, registered, closed, quarantined, ack_received;
+};
+
+/* Dedicated single-context, single-in-flight-job backend. Consumes an
+ * already-running Gen8 scheduler, never starts or claims to start it.
+ * Zero-initialize the backend once. init binds the existing HFI transport and prepares only the fresh context
+ * ring. It refuses nonempty startup queues and stale timestamps. All these
+ * mappings must remain pinned across register/unregister failures.
+ */
+int mg_gen8_init(struct mg_gen8_backend *, const struct mg_gen8_config *, const struct mg_gen8_io *);
+int mg_gen8_context_open(struct mg_gen8_backend *);
+/* fence must be a separate output variable, never an alias of backend/job/DMA
+ * memory. A nonzero fence transfers the retained job reference, even on error.
+ * A zero fence leaves that job reference with the caller. */
+int mg_gen8_submit(struct mg_gen8_backend *, struct mg_gen8_job *, uint64_t *fence);
+int mg_gen8_wait(struct mg_gen8_backend *, uint64_t fence, unsigned timeout_us);
+/* Requires no job in flight and a successful UNREGISTER_CONTEXT ACK.
+ * Does not stop the GPU, detach SMMUs or free global mappings. No reopen or
+ * reset recovery: a lost ACK/GMU fault quarantines until reboot/drained DMA.
+ */
+int mg_gen8_context_close(struct mg_gen8_backend *);
+
+#endif
