+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef METROID_GPU_HARDWARE_H
+#define METROID_GPU_HARDWARE_H
+#include "metroid_gpu_scheduler.h"
+struct mg_hw_config {
+    uint64_t sqe, aqe, restore;
+    uint32_t *restore_cpu;
+    size_t restore_bytes;
+};
+struct mg_hw_io {
+    void *context;
+    bool (*ready)(void *);
+    uint32_t (*read)(void *, uint32_t);
+    void (*write)(void *, uint32_t, uint32_t);
+    void (*delay)(void *, unsigned);
+    void (*publish)(void *, const void *, size_t);
+    int (*authenticate_zap)(void *);
+    void (*trace)(void *, const char *); /* optional phase checkpoints */
+};
+enum mg_hw_stage { MG_HW_OFF, MG_HW_OOB, MG_HW_REGISTERS, MG_HW_RESTORE,
+    MG_HW_CP, MG_HW_ZAP, MG_HW_NONSECURE };
+struct mg_hardware {
+    struct mg_hw_io io;
+    enum mg_hw_stage stage;
+    uint32_t reg, value;
+    int error;
+    bool attempted, exposed, quarantined;
+};
+/* Called by the scheduler's boot_gpu callback. Retains GX OOB until reboot;
+ * no IFPC, reset recovery, preemption, LPAC, performance counters or IRQs.
+ * Firmware and restore pointers must already have pinned privileged stream0
+ * mappings. Failure never releases OOB, backing, SMMU or secure ownership.
+ */
+int mg_hardware_boot(struct mg_hardware *, const struct mg_hw_io *,
+    const struct mg_hw_config *, struct mg_scheduler *);
+#endif
