+static int counter_reply(struct mg_scheduler *s, const uint32_t *in, unsigned count)
+{
+    if (count != 3) return MG_INVALID;
+    /* Per upstream, zero addresses explicitly decline an optional counter. */
+    uint32_t out[] = {0,in[0],in[1],in[2],0,0};
+    return send(s,out,6,COUNTER,1);
