+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "metroid_gpu_live.h"
+
+static void trace(struct mg_live *s, const char *phase)
+{ if (s->io.trace) s->io.trace(s->io.context,phase); }
+
+static int ready(void *context)
+{
+    struct mg_live *s = context;
+    return s->memory.exposed && s->domain.attached && !s->domain.quarantined &&
+        s->power.stage == MG_POWER_READY &&
+        s->io.fabric_ready(s->io.context) ? MG_OK : MG_UNBACKED;
+}
+static uint32_t read_reg(void *context, uint32_t reg)
+{ struct mg_live *s = context; return s->io.read(s->io.context, reg); }
+static void write_reg(void *context, uint32_t reg, uint32_t value)
+{
+    struct mg_live *s = context;
+    if (reg == 0x1f800 && value == 0) trace(s,"release CM3; wait FW ready");
+    if (reg == 0x1f986 && value == 1) trace(s,"FW ready; start HFI");
+    s->io.write(s->io.context, reg, value);
+}
+static void delay_us(void *context, unsigned us)
+{ struct mg_live *s = context; s->io.delay(s->io.context, us); }
+static void publish(void *context, const void *p, size_t bytes)
+{ struct mg_live *s = context; s->io.publish(s->io.context, p, bytes); }
+static struct mg_scm_result scm(void *context, uint32_t fn, uint32_t info, uint64_t arg)
+{ struct mg_live *s = context; return s->io.scm(s->io.context, fn, info, arg); }
+static int prepare(void *context)
+{
+    struct mg_live *s = context;
+    if (ready(s)) return MG_UNBACKED;
+    struct mg_gmu_loader loader = {s, write_reg, publish,
+        s->memory.backing, s->memory.firmware_count};
+    int error = mg_gmu_load(s->image, s->image_bytes, &s->memory.firmware, &loader);
+    if (error) return error;
+    trace(s,"verify loaded ITCM/DTCM");
+    /* Version words alone cannot prove CM3 instructions were loaded. Read
+     * every supplied TCM word while reset is held; reject the first mismatch.
+     * Firmware payload records are aligned LE32 and non-overlapping. */
+    for (unsigned i = 0; i < s->memory.firmware.count; i++) {
+        const struct mg_fw_block *b = &s->memory.firmware.blocks[i];
+        if (b->region != MG_ITCM && b->region != MG_DTCM) continue;
+        uint32_t reg = b->region == MG_ITCM ? 0x1b400 : 0x1c400;
+        uint32_t base = b->region == MG_ITCM ? 0 : 0x10004000;
+        const unsigned char *p = (const unsigned char *)s->image + b->offset;
+        for (unsigned j = 0; j < b->size; j += 4) {
+            uint32_t expected = (uint32_t)p[j] | (uint32_t)p[j+1] << 8 |
+                (uint32_t)p[j+2] << 16 | (uint32_t)p[j+3] << 24;
+            uint32_t index = reg + (b->address - base + j)/4;
+            uint32_t got = s->io.read(s->io.context,index);
+            if (got != expected) {
+                s->start.reg = index; s->start.value = got;
+                s->start.firmware_expected = expected;
+                s->start.firmware_mismatch = true;
+                return MG_IO;
+            }
+            s->start.firmware_words++;
+        }
+    }
+    trace(s,"TCM verified; publish transport");
+    /* The loader must not zero HFI/VRB. Publish the separately initialized
+     * transport, log and VRB after the firmware's external reservations. */
+    for (unsigned i = s->memory.firmware_count; i < s->memory.count; i++)
+        publish(s, s->memory.backing[i].cpu, s->memory.backing[i].bytes);
+    return MG_OK;
+}
+
+int mg_live_boot(struct mg_live *s, const struct mg_live_io *io,
+    const void *image, size_t bytes)
+{
+    if (!s || !io || !image || !bytes || !io->retain_fabric ||
+        !io->fabric_ready || !io->configure || !io->read || !io->write ||
+        !io->delay || !io->publish || !io->scm ||
+        !io->memory.allocate || !io->memory.release ||
+        !io->power.read || !io->power.write || !io->power.delay || !io->power.rails ||
+        !io->smmu.read || !io->smmu.write || !io->smmu.write64 ||
+        !io->smmu.delay || !io->smmu.publish) return MG_INVALID;
+    if (s->attempted) return MG_BUSY;
+    s->attempted = true;
+    s->io = *io; s->image = image; s->image_bytes = bytes;
+    trace(s,"allocate GMU memory");
+    int error = mg_gmu_memory_prepare(&s->memory, &io->memory, image, bytes);
+    if (error) goto fail;
+    s->stage = MG_LIVE_MEMORY;
+    s->fabric_attempted = true;
+    trace(s,"retain fabric votes");
+    error = io->retain_fabric(io->context);
+    if (error) goto fail;
+    if (!io->fabric_ready(io->context)) { error = MG_UNBACKED; goto fail; }
+    s->stage = MG_LIVE_FABRIC;
+    trace(s,"enable CX and clocks");
+    error = mg_power_enable(&io->power, &s->power);
+    if (error) goto fail;
+    s->stage = MG_LIVE_POWER;
+    trace(s,"configure GMU platform");
+    error = io->configure(io->context);
+    if (error) goto fail;
+    s->stage = MG_LIVE_PLATFORM;
+    if (!io->fabric_ready(io->context)) { error = MG_UNBACKED; goto fail; }
+    /* Must precede even the first possibly-posted SMMU write. */
+    s->memory.exposed = true;
+    trace(s,"attach GMU stream5");
+    error = mg_smmu_attach(&io->smmu, &s->domain, &s->memory.tables);
+    if (error) goto fail;
+    s->stage = MG_LIVE_SMMU;
+    trace(s,"load firmware and start CM3/HFI");
+    const struct mg_start_io start = {s, read_reg, write_reg, delay_us, ready, prepare, scm};
+    error = mg_gmu_start(&start, &s->memory.config, &s->start);
+    if (error) goto fail;
+    s->stage = MG_LIVE_HFI;
+    return MG_OK;
+fail:
+    s->error = error;
+    if (s->start.released && s->domain.attached) {
+        uint32_t cb = s->domain.cb_base + (s->domain.cb << s->domain.page_shift);
+        const uint32_t offsets[] = {0x48,0x50,0x54,cb+0x58,cb+0x60,
+            cb+0x64,cb+0x68,cb+0x6c};
+        for (unsigned i = 0; i < 8; i++)
+            s->fault_snapshot[i] = io->smmu.read(io->smmu.context,offsets[i]);
+        s->fault_snapshot_valid = true;
+    }
+    s->quarantined = s->fabric_attempted || s->power.touched || s->memory.exposed;
+    /* Unexposed RAM can be freed, including after a rail/clock failure;
+     * this never withdraws fabric/rail votes or resets someone else's GPU. */
+    if (!s->memory.exposed) (void)mg_gmu_memory_release(&s->memory, &io->memory);
+    return error;
+}
+
+bool mg_live_gmu_mapped(const struct mg_live *s, const void *cpu, uint32_t gpu, size_t bytes)
+{
+    if (!s || !cpu || !bytes || s->stage != MG_LIVE_HFI || s->quarantined ||
+        !s->domain.attached || s->domain.quarantined || !s->memory.exposed ||
+        !s->io.fabric_ready(s->io.context)) return false;
+    for (unsigned i = 0; i < s->memory.count; i++) {
+        const struct mg_gmu_backing *b = &s->memory.backing[i];
+        if (gpu < b->iova) continue;
+        uint64_t offset = (uint64_t)gpu - b->iova;
+        if (offset < b->bytes && bytes <= b->bytes - offset &&
+            (uintptr_t)cpu >= (uintptr_t)b->cpu &&
+            (uintptr_t)cpu - (uintptr_t)b->cpu == offset) return true;
+    }
+    return false;
+}
