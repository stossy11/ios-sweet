+         * mapped callback validates through the renderer's lifetime records. */
+    }
+    trace(a,"verify fenced GPU writes");
+    error = mg_render_selftest(&a->render,a->commands->memory.cpu,a->output->memory.cpu);
+    if (error) return poison(a,error);
+    a->stage = MG_ACCEL_PROOF;
+    return MG_OK;
+}
