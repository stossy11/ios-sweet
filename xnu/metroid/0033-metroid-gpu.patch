+static int validate_job(struct mg_gen8_backend *b, const struct mg_gen8_job *job)
+{
+    if (!job || !job->buffer_count || job->buffer_count > MG_GEN8_MAX_BUFFERS ||
+        !job->ib_count || job->ib_count > MG_GEN8_MAX_IBS) return MG_INVALID;
+    size_t total = 0;
+    for (unsigned i = 0; i < job->buffer_count; i++) {
