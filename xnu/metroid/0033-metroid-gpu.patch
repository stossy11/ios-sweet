+/* Exact vendor MP.ASSIGN wire structs. Metadata stays HLOS-owned and pinned:
+ * source VMID3; memory extent at64; 24-byte destination records at128;
+ * SMC64 extended args[3..9] at192. Never grant execute to protected data. */
+static int protect(struct mg_accel *a, struct mg_accel_block *b, bool tables)
+{
+    struct mg_accel_block *ctl = a->secure_control;
+    if (!a->io.secure || !ctl || !ctl->memory.cpu || !b->memory.cpu ||
+        b == ctl || b->protected_attempted || !private_extent(a,b) ||
+        !private_extent(a,ctl)) return MG_UNBACKED;
+    unsigned char *p = ctl->memory.cpu;
+    memset(p,0,256);
+    put32(p,3); put64(p+64,b->memory.pa); put64(p+72,b->memory.bytes);
+    put32(p+128,tables ? 3 : 10); put32(p+132,6); /* HLOS RW or CP_PIXEL RW */
+    if (tables) { put32(p+152,10); put32(p+156,4); } /* CP_PIXEL read-only walk */
+    put64(p+192,4); put64(p+200,ctl->memory.pa+128);
+    put64(p+208,tables ? 48 : 24);
