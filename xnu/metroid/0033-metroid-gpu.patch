+int mg_gen8_context_open(struct mg_gen8_backend *b)
+{
+    if (!b || !b->bound) return MG_INVALID;
+    if (b->quarantined) return MG_IO;
+    if (b->registered || b->closed || b->exposed) return MG_BUSY;
+    const struct mg_gen8_config *c = &b->config;
+    uint64_t ttbr = c->page_table | ((uint64_t)c->asid << 48);
+    uint32_t reg[] = {0,c->context_id,NOTIFY,(uint32_t)ttbr,(uint32_t)(ttbr >> 32),c->context_id,c->context_bank};
+    int ret = command(b,REGISTER,reg,7); if (ret) return ret;
+    uint32_t ptr[] = {0,c->context_id,(uint32_t)c->sop_address,(uint32_t)(c->sop_address >> 32),
