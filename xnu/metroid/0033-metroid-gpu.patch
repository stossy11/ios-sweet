+static bool gmu_mapped(void *p, const void *cpu, uint32_t gmu, size_t bytes)
+{
+    struct mg_accel *a = p;
+    if (!domains(a)) return false;
+    if (mg_live_gmu_mapped(a->live,cpu,gmu,bytes)) return true;
+    for (unsigned i = 0; i < a->block_count; i++) {
+        const struct mg_accel_block *b = &a->blocks[i];
+        if (b->gmu && gmu >= b->gmu && (uint64_t)gmu-b->gmu < b->memory.bytes) {
+            size_t offset = gmu-b->gmu;
+            if ((uintptr_t)cpu >= (uintptr_t)b->memory.cpu &&
+                (uintptr_t)cpu-(uintptr_t)b->memory.cpu == offset && bytes && bytes <= b->memory.bytes-offset)
+                return mg_vm_contains(&a->gmu,gmu & ~4095u,b->pages+offset/4096,
+                    (unsigned)(((offset & 4095)+bytes+4095)/4096),b->gmu_access);
+        }
+    }
+    return false;
+}
+static bool context_valid(void *p, uint64_t pt, uint32_t cb, uint32_t asid)
+{
+    struct mg_accel *a = p;
+    if (!domains(a) || a->gpu.tables.pa != pt || a->gpu.domain.cb != cb || a->gpu.domain.asid != asid) return false;
+    const struct mg_smmu_io *io = &a->gpu.io;
+    const struct mg_smmu_domain *d = &a->gpu.domain;
+    uint32_t b = d->cb_base+(d->cb << d->page_shift);
+    uint64_t ttbr = pt | ((uint64_t)asid << 48);
+    uint32_t ctl = io->read(io->context,b), fsr = io->read(io->context,b+0x58);
+    return ctl != UINT32_MAX && (ctl & 0xe7) == 0x27 && fsr != UINT32_MAX && !(fsr & 0xc00001fe) &&
+        io->read(io->context,0x800+d->smr*4) == 0x80000000 && io->read(io->context,0xc00+d->smr*4) == cb &&
+        io->read(io->context,b+0x20) == (uint32_t)ttbr && io->read(io->context,b+0x24) == (uint32_t)(ttbr >> 32);
+}
+static void retire(void *p, struct mg_gen8_job *job) { (void)p; (void)job; /* wait owns the persistent job */ }
+static void *hfi_pointer(struct mg_accel *a)
+{
+    for (unsigned i = 0; i < a->live->memory.count; i++)
+        if (a->live->memory.backing[i].iova == a->live->memory.config.hfi) return a->live->memory.backing[i].cpu;
+    return NULL;
+}
