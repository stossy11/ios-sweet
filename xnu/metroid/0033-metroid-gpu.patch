+static int poison(struct mg_scheduler *s, int error)
+{ if (!s->error) s->error = error; s->quarantined = true; return error; }
+static int health(struct mg_scheduler *s)
+{
+    if (s->quarantined) return MG_IO;
+    if (!s->io.ready(s->io.context)) return poison(s,MG_UNBACKED);
+    const uint32_t registers[] = {0x1f980,0x1f81c,0x1f992,0x23b05};
+    for (unsigned i = 0; i < 4; i++) {
+        uint32_t value = s->io.read(s->io.context,registers[i]);
+        if (value == UINT32_MAX || (i == 0 && !(value & 1)) ||
+            (i == 1 && (value & 0x1ff) != 0x100) ||
+            (i == 2 && (value & (1u << 15))) ||
+            (i == 3 && (value & 0x29))) {
+            s->fault_register = registers[i]; s->fault_value = value;
+            return poison(s,MG_IO);
