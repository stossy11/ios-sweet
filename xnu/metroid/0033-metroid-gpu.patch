+{ return (uint64_t)a < (uint64_t)b + m && (uint64_t)b < (uint64_t)a + n; }
+
+int mg_gmu_start(const struct mg_start_io *io, const struct mg_start_config *c,
+    struct mg_start_status *s)
+{
+    if (!io || !c || !s || !io->read || !io->write || !io->delay ||
+        !io->ready || !io->prepare || !io->scm) return MG_INVALID;
+    if (s->attempted) return MG_BUSY;
+    if ((c->hfi & 4095) || (c->log & 4095) || (c->log_bytes & 4095) ||
+        c->log_bytes > 0x100000 || (c->vrb & 4095) ||
+        !extent(c->hfi, MG_HFI_BYTES) || !extent(c->log, c->log_bytes) ||
+        !extent(c->vrb, 4096) ||
+        intersects(c->hfi, MG_HFI_BYTES, c->log, c->log_bytes) ||
+        intersects(c->hfi, MG_HFI_BYTES, c->vrb, 4096) ||
+        intersects(c->log, c->log_bytes, c->vrb, 4096)) return MG_INVALID;
+    *s = (struct mg_start_status){.attempted = true};
+    int ret = io->ready(io->context);
+    if (ret) return ret; /* No GPU accesses before platform prerequisites. */
+    uint32_t reset = rd(io, s, RESET);
+    if (reset == UINT32_MAX) return MG_IO;
+    if (reset != 1) return MG_BUSY; /* Refuse a running/unknown CM3. */
+    s->stage = MG_START_RESET;
+    ret = io->prepare(io->context); if (ret) goto fail;
+    /* Ensure the platform loader did not release the core. */
+    if (rd(io, s, RESET) != 1) { ret = MG_IO; goto fail; }
+    s->stage = MG_START_MEMORY;
+    ret = mg_secure_cx_init(io->scm, io->context, &s->scm);
+    if (ret) goto fail; /* Never treat unsupported secure setup as success. */
+    s->stage = MG_START_SECURE;
+#define WRITE(r,v) do { ret = write_check(io,s,(r),(v),UINT32_MAX); if (ret) goto fail; } while (0)
+    WRITE(0x1f7e9, 0xf); /* RPMH_POWER_STATE */
+    WRITE(0x1f7ed, 1); WRITE(0x1f7ec, 1); /* FAL10 veto */
+    WRITE(RESULT, 0); WRITE(0x1f801, 2);
+    WRITE(0x1f985, c->hfi); WRITE(0x1f984, 1);
+    WRITE(0x23b11, BIT(31) | (0x32u << 18) | 0x8a0);
+    WRITE(0x1f82d, 0x4052);
+    WRITE(0x3c03, 0x71e20); WRITE(0x3c04, 0x71e20);
+    WRITE(0x3c05, 0x71e20); WRITE(0x3c06, 0x71e20);
+    WRITE(0x3c00, 0x20023000); WRITE(0x3c45, BIT(3));
+    WRITE(0x1f9cb, c->vrb); WRITE(0x1f9c9, 0);
+    WRITE(0x1f9ca, 0x08060000); /* ADRENO_GMU_REV(8,6,0), not DT chip ID */
+    WRITE(0x1f9c8, c->log | (c->log_bytes / 4096 - 1));
+    WRITE(0x1f40f, 1); WRITE(0x1f400, 1); WRITE(0x1f401, 1);
+    uint32_t bcl = rd(io, s, 0x1fc40);
+    if (bcl == UINT32_MAX) { ret = MG_IO; goto fail; }
+    WRITE(0x1fc40, (bcl & 255) | 0x19171300);
+    /* Polling milestone: mask GMU2HOST IRQs; no uninstalled IRQ handler. */
+    /* All ones is the legitimate interrupt mask value, so do not use the
+     * generic inaccessible-register sentinel check for this register. */
+    io->write(io->context, 0x1f993, UINT32_MAX);
+    if (rd(io,s,0x1f993) != UINT32_MAX) { ret = MG_IO; goto fail; }
+    io->write(io->context, 0x1f991, UINT32_MAX);
+    io->write(io->context, 0x23b06, UINT32_MAX); /* AO mask: 1 masks */
+    if (rd(io,s,0x23b06) != UINT32_MAX) { ret = MG_IO; goto fail; }
+    io->write(io->context, 0x23b04, UINT32_MAX); /* AO pending W1C */
+    WRITE(0x27833, 0); /* CX_MISC mask: 1 enables */
+    io->write(io->context, 0x27831, UINT32_MAX);
+    WRITE(0x1f986, 0);
+    if (rd(io, s, HFI_STATUS) != 0) { ret = MG_STALE; goto fail; }
+    /* Offline format compatibility is insufficient: check loaded DTCM. */
+    if (rd(io, s, 0x1c400 + 0xff8) != 0x50040001 ||
+        rd(io, s, 0x1c400 + 0xffc) != 0x20070001) {
+        ret = MG_UNSUPPORTED; goto fail;
+    }
+    s->stage = MG_START_CONFIG;
+    io->write(io->context, RESET, 0);
+    s->released = true;
+    ret = poll(io,s,RESULT,0x1ff,0x100); if (ret) goto fail;
+    s->stage = MG_START_CM3;
+    io->write(io->context, 0x1f986, 1);
+    ret = poll(io,s,HFI_STATUS,1,1); if (ret) goto fail;
+    s->stage = MG_START_HFI;
+    return MG_OK;
+fail:
+    io->write(io->context, RESET, 1);
+    s->quarantined = true;
+    return ret;
+#undef WRITE
+}
