+/* SPDX-License-Identifier: GPL-2.0-only
+ * Gen8.6.0 HFI submission backend. Wire contracts follow NothingOSS
+ * 031e8669eb198d93e69532b01af973a1c2a82710 graphics-kernel:
+ * adreno_hfi.h, adreno_hwsched.c, adreno_gen8_hwsched_hfi.c.
+ * Not an A6xx ringbuffer or a Linux-DRM userspace command validator.
+ */
+#include "metroid_gpu_submit.h"
+#ifdef MG_HOST_TEST
+#include <string.h>
+#define BARRIER() __atomic_thread_fence(__ATOMIC_SEQ_CST)
+#else
+#include <libkern/libkern.h>
+#define BARRIER() __asm__ volatile("dmb osh" ::: "memory")
+#endif
+
+#define NOTIFY (1u << 5)
+#define EOF_FLAG (1u << 8)
+#define REGISTER 128u
+#define UNREGISTER 129u
+#define ISSUE 130u
+#define RETIRED 133u
+#define POINTERS 134u
+#define CONTEXT_BAD 150u
+#define FIRMWARE_ERROR 100u
+#define FIRMWARE_DEBUG 101u
+#define CONTEXT_WORDS ((MG_GEN8_CONTEXT_BYTES - sizeof(struct mg_gen8_context_header)) / 4u)
+#define CONTROL_TIMEOUT_US 100000u
+#define POLL_US 10u
+#define POLL_BUDGET 32u
+
+_Static_assert(sizeof(struct mg_gen8_context_header) == 48, "Gen8 context header ABI");
+_Static_assert(offsetof(struct mg_gen8_context_header, read) == 20, "Gen8 read index ABI");
+_Static_assert(offsetof(struct mg_gen8_context_header, write) == 24, "Gen8 write index ABI");
+_Static_assert(CONTEXT_WORDS == 1012, "Gen8 4K context queue ABI");
+_Static_assert(8 + MG_GEN8_MAX_IBS * 3 <= MG_HFI_MAX_MESSAGE, "inline IB message size");
+
+static bool overlaps(uint64_t a, uint64_t n, uint64_t b, uint64_t m)
+{ return a < b + m && b < a + n; }
+static bool cpu_range(const void *p, size_t n)
+{ return p && n && n <= UINTPTR_MAX - (uintptr_t)p; }
+static bool gpu_range(uint64_t p, size_t n)
+{ return p && !(p & 3) && n && !(n & 3) && p < MG_GEN8_ADDRESS_LIMIT && n <= MG_GEN8_ADDRESS_LIMIT-p; }
+static bool gmu_range(uint32_t p, size_t n)
+{ return p >= 0x60000000u && !(p & 4095) && n && (uint64_t)p+n <= 0x80000000ull; }
+static int poison(struct mg_gen8_backend *b, int ret)
+{
+    if (!b->quarantined) b->last_error = ret;
+    b->quarantined = true; b->queue.quarantined = true;
+    return ret;
+}
+
+static int register_fault(struct mg_gen8_backend *b, uint32_t reg, uint32_t value)
+{
+    b->fault_register = reg; b->fault_value = value;
+    return poison(b,MG_IO);
+}
+
+static int health(struct mg_gen8_backend *b)
+{
+    if (b->quarantined) return MG_IO;
+    /* No MMIO unless the power/clock/scheduler owner still permits it. */
+    if (!b->io.running(b->io.context)) return poison(b, MG_IO);
+    const struct mg_gen8_config *c = &b->config;
+    if (!b->io.context_valid(b->io.context,c->page_table,c->context_bank,c->asid) ||
+        !b->io.gmu_mapped(b->io.context,c->hfi_memory,c->hfi_address,c->hfi_bytes) ||
+        !b->io.gmu_mapped(b->io.context,c->context_memory,c->context_address,4096))
+        return poison(b, MG_UNBACKED);
+    uint32_t hfi = b->io.read(b->io.context, 0x1f980);
+    if (hfi == UINT32_MAX || !(hfi & 1)) return register_fault(b,0x1f980,hfi);
+    uint32_t result = b->io.read(b->io.context, 0x1f81c);
+    if (result == UINT32_MAX || (result & 0x1ff) != 0x100) return register_fault(b,0x1f81c,result);
+    uint32_t fault = b->io.read(b->io.context, 0x1f992);
+    if (fault == UINT32_MAX || (fault & (1u << 15))) return register_fault(b,0x1f992,fault);
+    uint32_t ao = b->io.read(b->io.context, 0x23b05);
+    /* GMU2HOST CM3 fault bit15; AO watchdog/fence/AHB error bits0/3/5.
+     * Polling does not acknowledge/clear other owners' interrupt bits. */
+    if (ao == UINT32_MAX || (ao & ((1u << 0) | (1u << 3) | (1u << 5))))
+        return register_fault(b,0x23b05,ao);
+    return MG_OK;
+}
+
+static int indices(struct mg_gen8_backend *b, uint32_t *read, uint32_t *write)
+{
+    volatile struct mg_gen8_context_header *h = b->config.context_memory;
+    BARRIER();
+    if (h->version || h->address != b->config.context_address + sizeof(*h) ||
+        h->words != CONTEXT_WORDS || h->hw_fence_address || h->hw_fence_bytes ||
+        h->unused[0] || h->unused[1] || h->unused[2] || h->sync_obj_ts)
+        return MG_INVALID;
+    *read = h->read; *write = h->write;
+    BARRIER();
+    if (*read >= CONTEXT_WORDS || *write >= CONTEXT_WORDS || ((*read | *write) & 3))
+        return MG_INVALID;
+    return MG_OK;
+}
+
+static int room(struct mg_gen8_backend *b, unsigned words)
+{
+    uint32_t r, w;
+    int ret = indices(b, &r, &w); if (ret) return ret;
+    uint32_t used = (w + CONTEXT_WORDS - r) % CONTEXT_WORDS;
+    return CONTEXT_WORDS - used <= ((words + 3u) & ~3u) ? MG_FULL : MG_OK;
+}
+
+static int service(struct mg_gen8_backend *b)
+{
+    int ret = health(b); if (ret) return ret;
+    uint32_t packet[MG_HFI_MAX_MESSAGE];
+    struct mg_hfi_queue *queues[] = {&b->messages, &b->debug};
+    for (unsigned q = 0; q < 2; q++) {
+        for (unsigned i = 0; i < POLL_BUDGET; i++) {
+            ret = mg_hfi_read(queues[q], packet, MG_HFI_MAX_MESSAGE);
+            if (ret == MG_EMPTY) break;
+            if (ret < 0) return poison(b, ret);
+            unsigned words = (unsigned)ret, id = packet[0] & 255;
+            b->last_message_header = packet[0];
+            unsigned type = (packet[0] >> 16) & 15;
+            if (type == 1 && !q) {
+                uint32_t value;
+                if (words < 3) return poison(b,MG_INVALID);
+                if (!b->waiting_header) continue; /* delayed, already completed ACK */
+                ret = mg_hfi_ack(packet, words, b->waiting_header, &value);
+                if (ret == MG_STALE) continue;
+                if (ret || b->ack_received) return poison(b, MG_INVALID);
+                b->ack_value = value; b->ack_received = true;
+                continue;
+            }
+            if (type != 0) return poison(b, MG_INVALID);
+            if (id == FIRMWARE_DEBUG && q) continue;
+            if (id == FIRMWARE_ERROR || id == CONTEXT_BAD) return poison(b, MG_IO);
+            if (id == RETIRED && !q) {
+                /* HFI v2.7 hfi_ts_retire_cmd is 60 bytes. A notification
+                 * is not completion: the GPU's EOP memstore is authoritative. */
+                if (words != 15 || packet[1] != b->config.context_id || !packet[2] ||
+                    packet[2] > b->queue.issued || packet[3] > 1)
+                    return poison(b, MG_INVALID);
+                if (packet[2] > b->notified) b->notified = packet[2];
+                continue;
+            }
+            /* No input/output HW fences, recurring work, perf requests or
+             * firmware allocations in this running single-context backend. */
+            return poison(b, MG_UNSUPPORTED);
+        }
+    }
+    BARRIER();
+    if (b->messages.header->read != b->messages.header->write ||
+        b->debug.header->read != b->debug.header->write) return MG_BUSY;
+    return MG_OK;
+}
+
+static int command(struct mg_gen8_backend *b, unsigned id, uint32_t *packet, unsigned words)
+{
+    int ret = service(b); if (ret) return ret;
+    if (b->control_sequence == 4095) return poison(b, MG_LIMIT);
+    ret = mg_hfi_message(id, 0, ++b->control_sequence, words, packet); if (ret) return ret;
+    b->waiting_header = packet[0]; b->ack_received = false;
+    /* Registration may have reached firmware even if its ACK never arrives. */
+    b->exposed = true;
+    ret = mg_hfi_write(&b->control, packet, words);
+    if (ret) return poison(b, ret);
+    BARRIER();
+    b->io.write(b->io.context, MG_GEN8_HOST2GMU, 1);
+    for (unsigned elapsed = 0;; elapsed += POLL_US) {
+        ret = service(b); if (ret && ret != MG_BUSY) return ret;
+        if (!ret && b->ack_received) {
+            b->waiting_header = 0;
+            /* Gen8 check_ack_failure: 0xffffffff is command rejection;
+             * other values may contain command-specific returned data. */
+            return b->ack_value == UINT32_MAX ? poison(b, MG_IO) : MG_OK;
+        }
+        if (elapsed == CONTROL_TIMEOUT_US) return poison(b, MG_TIMEOUT);
+        b->io.delay(b->io.context, POLL_US);
+    }
+}
+
+static bool queue_ready(void *p)
+{
+    struct mg_gen8_backend *b = p;
+    if (!b->registered || b->closed || b->quarantined) return false;
+    if (!b->io.running(b->io.context)) { (void)poison(b,MG_IO); return false; }
+    return true;
+}
+
+static int dispatch(void *p, void *data, uint64_t fence)
+{
+    struct mg_gen8_backend *b = p;
+    struct mg_gen8_job *job = data;
+    uint32_t packet[8 + 3 * MG_GEN8_MAX_IBS] = {0};
+    if (fence > UINT32_MAX) return poison(b, MG_LIMIT);
+    int ret = health(b); if (ret) return ret;
+    for (unsigned i = 0; i < job->buffer_count; i++) {
+        const struct mg_gen8_buffer *v = &job->buffers[i];
+        /* Publishing writes too prevents dirty CPU cache lines from later
+         * overwriting GPU results. Caller must stop all CPU access in flight. */
+        ret = b->io.sync(b->io.context, MG_GPU_TO_DEVICE, v->cpu, v->bytes);
+        if (ret) return poison(b, ret);
+    }
+    unsigned words = 8 + 3 * job->ib_count;
+    ret = mg_hfi_message(ISSUE, 0, (++b->issue_sequence) & 4095, words, packet);
+    if (ret) return poison(b, ret);
+    packet[1] = b->config.context_id;
+    packet[2] = NOTIFY | (job->end_of_frame ? EOF_FLAG : 0);
+    packet[3] = (uint32_t)fence; packet[6] = job->ib_count;
+    for (unsigned i = 0; i < job->ib_count; i++) {
+        const struct mg_gen8_ib *ib = &job->ibs[i];
+        uint64_t address = job->buffers[ib->buffer].gpu + ib->offset;
+        packet[8+3*i] = (uint32_t)address; packet[9+3*i] = (uint32_t)(address >> 32);
+        packet[10+3*i] = ib->bytes; /* hfi_issue_ib.size is BYTES, not dwords. */
+    }
+    uint32_t r, w;
+    ret = indices(b, &r, &w); if (ret) return poison(b, ret);
+    unsigned padded = (words + 3u) & ~3u;
+    if (CONTEXT_WORDS - ((w + CONTEXT_WORDS - r) % CONTEXT_WORDS) <= padded)
+        return poison(b, MG_FULL);
+    volatile uint32_t *ring = (volatile uint32_t *)((uint8_t *)b->config.context_memory + 48);
+    for (unsigned i = 0; i < padded; i++)
+        ring[(w+i) % CONTEXT_WORDS] = i < words ? packet[i] : 0xfafafafa;
+    BARRIER();
+    ((volatile struct mg_gen8_context_header *)b->config.context_memory)->write = (w+padded) % CONTEXT_WORDS;
+    BARRIER();
+    /* Normal GFX priority0, no LPAC/input-sync work: DISPQ_IRQ_BIT(0). */
+    b->io.write(b->io.context, MG_GEN8_HOST2GMU, 1u << 2);
+    return MG_OK;
+}
+
+static int complete(void *p, uint64_t fence)
+{
+    struct mg_gen8_backend *b = p;
+    int ret = service(b); if (ret) return ret == MG_BUSY ? MG_EMPTY : ret;
+    uint32_t r, w;
+    ret = indices(b, &r, &w); if (ret) return poison(b, ret);
+    ret = b->io.sync(b->io.context, MG_GPU_TO_CPU, (const void *)b->config.eop, 4);
+    if (ret) return poison(b, ret);
+    BARRIER(); uint32_t eop = *b->config.eop;
+    if (eop > fence || eop < b->queue.completed) return poison(b, MG_STALE);
+    if (eop != fence) return MG_EMPTY;
+    ret = b->io.sync(b->io.context, MG_GPU_TO_CPU, (const void *)b->config.sop, 4);
+    if (ret) return poison(b, ret);
+    BARRIER();
+    if (*b->config.sop != fence) return poison(b,MG_STALE);
+    if (r != w) return MG_EMPTY;
+    struct mg_gen8_job *job = b->queue.job;
+    for (unsigned i = 0; i < job->buffer_count; i++) {
+        const struct mg_gen8_buffer *v = &job->buffers[i];
+        if (v->access & MG_GPU_WRITE) {
+            ret = b->io.sync(b->io.context, MG_GPU_TO_CPU, v->cpu, v->bytes);
+            if (ret) return poison(b, ret);
+        }
+    }
+    /* Check for a fault discovered while output cache ownership changed. */
+    ret = service(b);
+    return ret == MG_BUSY ? MG_EMPTY : ret;
+}
+static void retire(void *p, void *job)
+{ struct mg_gen8_backend *b = p; b->io.retire(b->io.context, job); }
+static void wait_delay(void *p, unsigned us)
+{ struct mg_gen8_backend *b = p; b->io.delay(b->io.context, us); }
+
+int mg_gen8_init(struct mg_gen8_backend *b, const struct mg_gen8_config *c, const struct mg_gen8_io *io)
+{
+    if (!b || !c || !io || !io->running || !io->context_valid || !io->gmu_mapped ||
+        !io->mapped || !io->sync || !io->read ||
+        !io->write || !io->delay || !io->retire) return MG_INVALID;
+    if (b->bound || b->exposed || b->quarantined) return MG_BUSY;
+    if (c->chip_id != MG_CHIP_ID || c->hfi_version != 0x20070001u)
+        return MG_UNSUPPORTED;
+    if (!c->context_id || c->context_id > 1023 || c->context_bank >= 128 ||
+        !c->asid || c->asid > 255 || !c->page_table || (c->page_table & 4095) ||
+        c->page_table >= (1ull << 48) ||
+        !cpu_range(c->hfi_memory, c->hfi_bytes) || c->hfi_bytes < MG_HFI_BYTES ||
+        !gmu_range(c->hfi_address, c->hfi_bytes) ||
+        !cpu_range(c->context_memory, MG_GEN8_CONTEXT_BYTES) || ((uintptr_t)c->context_memory & 4095) ||
+        !gmu_range(c->context_address, MG_GEN8_CONTEXT_BYTES) ||
+        !cpu_range((const void *)c->sop,4) || !cpu_range((const void *)c->eop,4) ||
+        (((uintptr_t)c->sop | (uintptr_t)c->eop) & 3) ||
+        !gpu_range(c->sop_address,4) || !gpu_range(c->eop_address,4) ||
+        c->sop == c->eop || c->sop_address == c->eop_address ||
+        overlaps(c->context_address,4096,c->hfi_address,c->hfi_bytes)) return MG_INVALID;
+    const void *cpu[] = {b,c,io,c->context_memory,c->hfi_memory,(const void *)c->sop,(const void *)c->eop};
+    const size_t size[] = {sizeof(*b),sizeof(*c),sizeof(*io),4096,c->hfi_bytes,4,4};
+    for (unsigned i = 0; i < 7; i++)
+        for (unsigned j = 0; j < i; j++)
+            if (overlaps((uintptr_t)cpu[i],size[i],(uintptr_t)cpu[j],size[j])) return MG_INVALID;
+    if (!io->running(io->context)) return MG_UNSUPPORTED;
+    if (!io->mapped(io->context,(const void *)c->sop,c->sop_address,4,MG_GPU_READ|MG_GPU_WRITE) ||
+        !io->mapped(io->context,(const void *)c->eop,c->eop_address,4,MG_GPU_READ|MG_GPU_WRITE)) return MG_UNBACKED;
+    if (*c->sop || *c->eop) return MG_STALE;
+    const uint32_t *fresh = c->context_memory;
+    for (unsigned i = 0; i < 1024; i++) if (fresh[i]) return MG_STALE;
+    memset(b,0,sizeof(*b));
+    b->config = *c; b->io = *io;
+    struct mg_hfi_queue *queues[] = {&b->control,&b->messages,&b->debug};
+    for (unsigned i = 0; i < 3; i++) {
+        int ret = mg_hfi_bind(c->hfi_memory,c->hfi_bytes,c->hfi_address,i,queues[i]);
+        if (ret) return ret;
+        const volatile struct mg_hfi_header *h = queues[i]->header;
+        uint32_t r = h->read, w = h->write;
+        if (h->status != 1 || h->address != queues[i]->address || h->type != queues[i]->type ||
+            h->words != MG_HFI_WORDS || h->message_size || r >= MG_HFI_WORDS ||
+            w >= MG_HFI_WORDS || ((r|w)&3)) return MG_INVALID;
+        if (r != w) return MG_STALE;
+    }
+    int ret = health(b); if (ret) return ret;
+    volatile struct mg_gen8_context_header *h = c->context_memory;
+    h->address = c->context_address + sizeof(*h); h->words = CONTEXT_WORDS;
+    BARRIER();
+    b->queue_io = (struct mg_queue_io){b,queue_ready,dispatch,complete,retire,wait_delay};
+    b->bound = true;
+    return MG_OK;
+}
+
+int mg_gen8_context_open(struct mg_gen8_backend *b)
+{
+    if (!b || !b->bound) return MG_INVALID;
+    if (b->quarantined) return MG_IO;
+    if (b->registered || b->closed || b->exposed) return MG_BUSY;
+    const struct mg_gen8_config *c = &b->config;
+    uint64_t ttbr = c->page_table | ((uint64_t)c->asid << 48);
+    uint32_t reg[] = {0,c->context_id,NOTIFY,(uint32_t)ttbr,(uint32_t)(ttbr >> 32),c->context_id,c->context_bank};
+    int ret = command(b,REGISTER,reg,7); if (ret) return ret;
+    uint32_t ptr[] = {0,c->context_id,(uint32_t)c->sop_address,(uint32_t)(c->sop_address >> 32),
+        (uint32_t)c->eop_address,(uint32_t)(c->eop_address >> 32),0,0,0,c->context_address};
+    ret = command(b,POINTERS,ptr,10); if (ret) return poison(b,ret);
+    b->registered = true;
+    return MG_OK;
+}
+
+static int validate_job(struct mg_gen8_backend *b, const struct mg_gen8_job *job)
+{
+    if (!job || !job->buffer_count || job->buffer_count > MG_GEN8_MAX_BUFFERS ||
+        !job->ib_count || job->ib_count > MG_GEN8_MAX_IBS) return MG_INVALID;
+    size_t total = 0;
+    for (unsigned i = 0; i < job->buffer_count; i++) {
+        const struct mg_gen8_buffer *v = &job->buffers[i];
+        if (!cpu_range(v->cpu,v->bytes) || ((uintptr_t)v->cpu & 3) || !gpu_range(v->gpu,v->bytes) ||
+            !v->access || (v->access & ~7u) ||
+            ((v->access & MG_GPU_EXEC) && ((v->access & MG_GPU_WRITE) || !(v->access & MG_GPU_READ))))
+            return MG_INVALID;
+        if (v->bytes > MG_GEN8_MAX_JOB_BYTES-total) return MG_LIMIT;
+        total += v->bytes;
+        const void *protected[] = {b,job,b->config.context_memory,b->config.hfi_memory,
+            (const void *)b->config.sop,(const void *)b->config.eop};
+        const size_t sizes[] = {sizeof(*b),sizeof(*job),4096,b->config.hfi_bytes,4,4};
+        for (unsigned j = 0; j < 6; j++)
+            if (overlaps((uintptr_t)v->cpu,v->bytes,(uintptr_t)protected[j],sizes[j])) return MG_INVALID;
+        if (overlaps(v->gpu,v->bytes,b->config.sop_address,4) ||
+            overlaps(v->gpu,v->bytes,b->config.eop_address,4)) return MG_INVALID;
+        for (unsigned j = 0; j < i; j++)
+            if (overlaps(v->gpu,v->bytes,job->buffers[j].gpu,job->buffers[j].bytes) ||
+                overlaps((uintptr_t)v->cpu,v->bytes,(uintptr_t)job->buffers[j].cpu,job->buffers[j].bytes))
+                return MG_INVALID;
+        if (!b->io.mapped(b->io.context,v->cpu,v->gpu,v->bytes,v->access)) return MG_UNBACKED;
+    }
+    for (unsigned i = 0; i < job->ib_count; i++) {
+        const struct mg_gen8_ib *ib = &job->ibs[i];
+        if (ib->buffer >= job->buffer_count || !ib->bytes || ((ib->offset | ib->bytes) & 3)) return MG_INVALID;
+        const struct mg_gen8_buffer *v = &job->buffers[ib->buffer];
+        if ((v->access & (MG_GPU_READ|MG_GPU_EXEC)) != (MG_GPU_READ|MG_GPU_EXEC) ||
+            ib->offset > v->bytes || ib->bytes > v->bytes - ib->offset) return MG_INVALID;
+    }
+    return MG_OK;
+}
+
+int mg_gen8_submit(struct mg_gen8_backend *b, struct mg_gen8_job *job, uint64_t *fence)
+{
+    if (!fence) return MG_INVALID;
+    *fence = 0;
+    if (!b || !b->bound) return MG_INVALID;
+    if (b->quarantined) return MG_IO;
+    if (!b->registered || b->closed) return MG_UNSUPPORTED;
+    if (b->queue.job) return MG_BUSY;
+    if (b->queue.issued >= UINT32_MAX) return MG_LIMIT; /* No timestamp reuse/wrap. */
+    int ret = validate_job(b,job); if (ret) return ret;
+    ret = service(b); if (ret) return ret;
+    ret = room(b,8+3*job->ib_count);
+    if (ret) return ret == MG_FULL ? ret : poison(b,ret);
+    ret = mg_queue_submit(&b->queue,&b->queue_io,job,fence);
+    if (b->queue.quarantined) b->quarantined = true;
+    return ret;
+}
+
+int mg_gen8_wait(struct mg_gen8_backend *b, uint64_t fence, unsigned timeout_us)
+{
+    if (!b || !b->bound) return MG_INVALID;
+    if (b->quarantined) return MG_IO;
+    int ret = mg_queue_wait(&b->queue,&b->queue_io,fence,timeout_us);
+    if (b->queue.quarantined) b->quarantined = true;
+    return ret;
+}
+
+int mg_gen8_context_close(struct mg_gen8_backend *b)
+{
+    if (!b || !b->bound) return MG_INVALID;
+    if (b->quarantined) return MG_IO;
+    if (!b->registered || b->closed || b->queue.job) return MG_BUSY;
+    uint32_t r,w;
+    int ret = indices(b,&r,&w); if (ret) return poison(b,ret);
+    if (r != w) return MG_BUSY;
+    uint32_t packet[] = {0,b->config.context_id,(uint32_t)b->queue.completed};
+    ret = command(b,UNREGISTER,packet,3); if (ret) return ret;
+    b->registered = false; b->closed = true;
+    return MG_OK;
+}
