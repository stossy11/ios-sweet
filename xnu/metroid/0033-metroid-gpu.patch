+/* BCM command-DB ABI: unit:u32, width:u16, VCD:u8, reserved:u8. Addresses
+ * are discovered rather than copied from another phone's command database.
+ * Validate every resource before the first transaction. */
+static int mg_bcm_address(const char *name, uint32_t *address)
+{
+    uint32_t key[2] = {0,0}; unsigned matches = 0;
+    for (unsigned i = 0; i < 8 && name[i]; i++)
+        key[i/4] |= (uint32_t)(uint8_t)name[i] << (8 * (i%4));
+    for (unsigned i = 0; i < 8; i++) {
+        unsigned h = 8 + 16 * i, slave = rh_db16(h);
+        if (!slave) break;
+        unsigned entries = RH_DB_HEADER + rh_db16(h+2);
+        unsigned aux = RH_DB_HEADER + rh_db16(h+4), count = rh_db16(h+6);
+        if (slave < 3 || slave > 5 || (entries & 3) ||
+            !rh_range(entries,count * RH_DB_ENTRY) || !rh_range(aux,0)) return EINVAL;
+        for (unsigned j = 0; j < count; j++) {
+            unsigned e = entries + j * RH_DB_ENTRY;
+            if (rh_read(rh_db,e) != key[0] || rh_read(rh_db,e+4) != key[1]) continue;
+            unsigned start = aux + rh_db16(e+22), bytes = rh_db16(e+20);
+            uint32_t a = rh_read(rh_db,e+16);
+            if (slave != 5 || (a >> 16) != 5 || (a & 3) || bytes != 8 ||
+                (start & 3) || !rh_range(start,8) ||
+                !rh_read(rh_db,start) || !rh_db16(start+4) ||
+                (rh_db16(start+6) & 0xff00) || (rh_db16(start+6) & 255) >= 16)
+                return EINVAL;
+            *address = a;
+            if (++matches != 1) return EINVAL;
+        }
+    }
+    return matches == 1 ? 0 : ENODEV;
+}
+
+int metroid_gpu_rpmh_fabric_enable(void)
+{
+    if (__atomic_exchange_n(&rh_lock,1,__ATOMIC_ACQUIRE)) return EBUSY;
+    uint32_t address[4] = {0}, data[4];
+    int error = EIO;
+    if (rh_poisoned) goto out;
+    if (mg_fabric_held) { error = 0; goto out; }
+    error = rh_map(); if (error) goto out;
+    /* tuna.c: GPU/TCU -> SH1 -> LLCC(SH0) -> EBI(MC0); configuration
+     * path -> CN0. SH1/CN0 are one-bit enable BCMs. MC0/SH0 use the
+     * saturating 14-bit X/Y wire maximum, covering any inherited HLOS
+     * demand without reducing it. Temporary bring-up: no DVFS or release,
+     * and no deep sleep. ACV's performance-mask policy is not modified. */
+    const char *names[] = {"MC0","SH0","SH1","CN0"};
+    for (unsigned i = 0; i < 4; i++) {
+        error = mg_bcm_address(names[i],&address[i]); if (error) goto out;
+        for (unsigned j = 0; j < i; j++)
+            if (address[i] == address[j]) { error = EINVAL; goto out; }
+        /* Commit each resource, so no VCD can be left uncommitted. Every
+         * command waits for completion before the next is issued. */
+        data[i] = 0x60000000u | (i < 2 ? 0x0fffffffu : 1u);
+    }
+    error = mg_votes_send(address,data,4);
+    if (!error) {
+        mg_fabric_held = true;
+        printf("METROID GPU: DDR/LLCC/TCU/CNOC BCM votes acknowledged; retained until reboot\n");
+    }
+out:
+    __atomic_store_n(&rh_lock,0,__ATOMIC_RELEASE);
+    return error;
+}
+
+bool metroid_gpu_rpmh_fabric_ready(void)
+{
+    if (__atomic_exchange_n(&rh_lock,1,__ATOMIC_ACQUIRE)) return false;
+    bool ready = mg_fabric_held && !rh_poisoned;
+    __atomic_store_n(&rh_lock,0,__ATOMIC_RELEASE);
+    return ready;
+}
+
+/* Fixed low-frequency bring-up OPP, at the highest declared ARC corners.
+ * GMU gets its own votes; the CPU fabric owner stays retained independently.
+ * No inferred DDR unit conversion, ACV policy, bin-dependent frequency or
+ * voltage enum: all ARC indexes/levels and BCM addresses come from command DB.
+ */
+int metroid_gpu_rpmh_scheduler_tables(uint32_t *perf, uint32_t *bw)
+{
+    if (!perf || !bw) return EINVAL;
+    if (__atomic_exchange_n(&rh_lock,1,__ATOMIC_ACQUIRE)) return EBUSY;
+    int error = EIO;
+    uint32_t address[4], index[4], voltage[4];
+    if (rh_poisoned || !mg_fabric_held) goto out;
+    const char *names[] = {"gfx.lvl","mx.lvl","cx.lvl","gmxc.lvl"};
+    for (unsigned i = 0; i < 4; i++) {
+        error = mg_arc_details(names[i],&address[i],&index[i],&voltage[i]);
+        if (i == 3 && error == ENODEV) { index[3] = index[1]; voltage[3] = voltage[1]; error = 0; }
+        if (error) goto out;
