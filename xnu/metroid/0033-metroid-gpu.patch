+/* The diagnostic owns physical backing directly, before there is a GPU
+ * IODMACommand/provider. Keep the legacy allocator confined to this adapter. */
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+static int mg_kernel_allocate(void *context, size_t bytes, struct mg_memory_block *block)
+{
+    (void)context;
+    IOPhysicalAddress pa = 0;
+    void *cpu = IOMallocContiguous(bytes, MG_MEMORY_PAGE, &pa);
+    if (!cpu) return MG_LIMIT;
+    *block = (struct mg_memory_block){cpu, cpu, pa, bytes};
+    bzero(cpu, bytes);
+    return MG_OK;
+}
+static void mg_kernel_release(void *context, struct mg_memory_block *block)
+{
+    (void)context;
+    IOFreeContiguous(block->cpu, block->bytes);
+    *block = (struct mg_memory_block){0};
+}
