+    }
+    return MG_OK;
+}
+
+int mg_gen8_submit(struct mg_gen8_backend *b, struct mg_gen8_job *job, uint64_t *fence)
+{
+    if (!fence) return MG_INVALID;
+    *fence = 0;
+    if (!b || !b->bound) return MG_INVALID;
+    if (b->quarantined) return MG_IO;
+    if (!b->registered || b->closed) return MG_UNSUPPORTED;
+    if (b->queue.job) return MG_BUSY;
+    if (b->queue.issued >= UINT32_MAX) return MG_LIMIT; /* No timestamp reuse/wrap. */
+    int ret = validate_job(b,job); if (ret) return ret;
+    ret = service(b); if (ret) return ret;
+    ret = room(b,8+3*job->ib_count);
+    if (ret) return ret == MG_FULL ? ret : poison(b,ret);
+    ret = mg_queue_submit(&b->queue,&b->queue_io,job,fence);
+    if (b->queue.quarantined) b->quarantined = true;
+    return ret;
+}
+
+int mg_gen8_wait(struct mg_gen8_backend *b, uint64_t fence, unsigned timeout_us)
+{
+    if (!b || !b->bound) return MG_INVALID;
+    if (b->quarantined) return MG_IO;
+    int ret = mg_queue_wait(&b->queue,&b->queue_io,fence,timeout_us);
+    if (b->queue.quarantined) b->quarantined = true;
+    return ret;
+}
+
+int mg_gen8_context_close(struct mg_gen8_backend *b)
+{
+    if (!b || !b->bound) return MG_INVALID;
+    if (b->quarantined) return MG_IO;
+    if (!b->registered || b->closed || b->queue.job) return MG_BUSY;
+    uint32_t r,w;
+    int ret = indices(b,&r,&w); if (ret) return poison(b,ret);
+    if (r != w) return MG_BUSY;
+    uint32_t packet[] = {0,b->config.context_id,(uint32_t)b->queue.completed};
+    ret = command(b,UNREGISTER,packet,3); if (ret) return ret;
+    b->registered = false; b->closed = true;
+    return MG_OK;
+}
