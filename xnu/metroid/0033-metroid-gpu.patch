+    const struct mg_gen8_config submission = {.chip_id=MG_CHIP_ID,.hfi_version=0x20070001,
+        .context_id=1,.context_bank=a->gpu.domain.cb,.asid=a->gpu.domain.asid,.page_table=a->gpu.tables.pa,
+        .hfi_memory=hfi_pointer(a),.hfi_bytes=MG_HFI_BYTES,.hfi_address=live->memory.config.hfi,
+        .context_memory=a->context->memory.cpu,.context_address=a->context->gmu,
+        .sop=timestamps,.eop=timestamps+1,.sop_address=a->timestamps->gpu,.eop_address=a->timestamps->gpu+4};
