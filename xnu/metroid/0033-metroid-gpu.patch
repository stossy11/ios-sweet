+    return result;
+}
+struct mg_scm_result mg_scm_native(void *unused, uint32_t fn, uint32_t info, uint64_t arg)
+{
+    (void)unused;
+    if (info != 1 || !((fn == 0x42000601 && arg == 0x02002801) ||
+        (fn == 0x42002801 && arg == 0xb))) return (struct mg_scm_result){.status = -1};
+    return invoke(fn,info,arg,0,0,0);
+}
+/* PIL commands for GPU PAS13 only. Same serialized transport as CX setup;
+ * no general SMC gateway, no PAS shutdown/reuse after ambiguous failure. */
+struct mg_scm_result mg_scm_pas_native(void *unused, unsigned command, uint64_t pa, uint64_t bytes)
+{
+    (void)unused;
+    if (command == 1 && pa && !(pa & 4095) && pa < (1ull << 48) && !bytes)
+        return invoke(0x42000201,0x82,13,pa,0,0);
+    if (command == 2 && pa && !(pa & 4095) && bytes && !(bytes & 4095) &&
+        bytes <= 0x100000 && pa < (1ull << 48) && bytes <= (1ull << 48)-pa)
+        return invoke(0x42000202,3,13,pa,bytes,0);
+    if (command == 5 && !pa && !bytes) return invoke(0x42000205,1,13,0,0,0);
+    return (struct mg_scm_result){.status = -1};
+}
+/* MP.ASSIGN uses seven arguments: x2=mem-list, x3=16, x4=source-list,
+ * x5 points to args[3..9]. No general SCM gateway or reclaim operation. */
+struct mg_scm_result mg_scm_secure_native(void *unused, uint64_t pa)
+{
+    (void)unused;
+    if (!pa) return invoke(0x42000601,1,0x02000c16,0,0,0);
+    if ((pa & 4095) || pa >= (1ull << 48) - 4096)
+        return (struct mg_scm_result){.status = -1};
+    return invoke(0x42000c16,0x1117,pa+64,16,pa,pa+192);
+}
