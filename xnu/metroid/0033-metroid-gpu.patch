+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef METROID_GPU_LIVE_H
+#define METROID_GPU_LIVE_H
+#include "metroid_gpu_memory.h"
+
+/* The caller serializes boot and all access to this owner. Once exposed, its
+ * memory, mappings, fabric votes and clocks have reboot lifetime, even on a
+ * timeout. No stop/retry API exists until DMA drain can be demonstrated.
+ * Every allocation must be CPU/GMU coherent or CPU Normal-NC (not merely
+ * clean at boot), with device access ordered by the supplied barriers.
+ */
+enum mg_live_stage { MG_LIVE_OFF, MG_LIVE_MEMORY, MG_LIVE_FABRIC,
+    MG_LIVE_POWER, MG_LIVE_PLATFORM, MG_LIVE_SMMU, MG_LIVE_HFI };
+struct mg_live_io {
+    void *context;
+    struct mg_memory_io memory;
+    struct mg_power_io power;
+    struct mg_smmu_io smmu;
+    /* Retain acknowledged DDR/CNOC/TCU votes until reboot. An ambiguous
+     * failure retains votes too. Never implement this as unconditional OK. */
+    int (*retain_fabric)(void *);
+    bool (*fabric_ready)(void *);
+    /* After power-enable, safely deassert GPUCC reset with CM3 reset held,
+     * enable the GPU SMMU clock, initialize AHB timeout and CX timer. */
+    int (*configure)(void *);
+    uint32_t (*read)(void *, uint32_t); /* GPU-relative dwords */
+    void (*write)(void *, uint32_t, uint32_t);
+    void (*delay)(void *, unsigned);
+    void (*publish)(void *, const void *, size_t);
+    mg_scm_call scm;
+};
+struct mg_live {
+    struct mg_gmu_memory memory;
+    struct mg_smmu_domain domain;
+    struct mg_power_status power;
