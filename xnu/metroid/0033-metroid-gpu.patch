+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "metroid_gpu_render.h"
+#ifdef MG_HOST_TEST
+#include <string.h>
+#else
+#include <libkern/libkern.h>
+#endif
+#define VA_FIRST 0x10000000u
+#define VA_END 0x50000000u
+static bool running(struct mg_render *r)
+{
+    return r->initialized && !r->quarantined && !r->vm->quarantined &&
+        !r->backend->quarantined && r->running(r->context);
+}
+static bool ready(void *p) { struct mg_render *r = p; return r->verified && running(r) &&
+    r->backend->bound && r->backend->registered && !r->backend->closed; }
+static int poison(struct mg_render *r, int error) { r->quarantined = true; return error; }
+static int map(void *p, const struct mg_gem_backing *b, uint64_t *address)
+{
+    struct mg_render *r = p;
+    if (!address) return MG_INVALID;
+    *address = 0;
+    if (!b || !b->cpu || !b->pages || !b->bytes || (b->bytes & 4095) ||
+        ((uintptr_t)b->cpu & 4095) || b->bytes > UINTPTR_MAX-(uintptr_t)b->cpu ||
+        b->page_count != b->bytes/4096 || b->page_count > MG_VM_MAX_PAGES ||
+        !(b->access & MG_GPU_READ) || (b->access & ~7u)) return MG_INVALID;
+    if (!running(r)) return MG_UNBACKED;
+    if (r->active) return MG_BUSY;
+    if (b->bytes > MG_RENDER_BYTES-r->allocated) return MG_LIMIT;
+    unsigned slot;
+    for (slot = 0; slot < MG_RENDER_BUFFERS; slot++) if (!r->mappings[slot].address) break;
+    if (slot == MG_RENDER_BUFFERS) return MG_LIMIT;
+    uint64_t va = VA_FIRST;
+    /* First-fit with a 4K unmapped guard on either side of each allocation.
+     * Data VA can be reused only after completed jobs and TLB invalidation. */
+    for (;;) {
+        if (va + b->bytes + 4096 > VA_END) return MG_LIMIT;
+        bool moved = false;
+        for (unsigned i = 0; i < MG_RENDER_BUFFERS; i++) {
+            const struct mg_render_mapping *m = &r->mappings[i];
+            if (!m->address) continue;
+            if ((uintptr_t)b->cpu < (uintptr_t)m->backing.cpu+m->backing.bytes &&
+                (uintptr_t)m->backing.cpu < (uintptr_t)b->cpu+b->bytes) return MG_INVALID;
+            if (va < (uint64_t)m->address+m->backing.bytes+4096 &&
+                (uint64_t)m->address < va+b->bytes+4096) {
+                va = (uint64_t)m->address+m->backing.bytes+4096;
+                moved = true; break;
+            }
+        }
+        if (!moved) break;
+    }
+    struct mg_render_mapping *m = &r->mappings[slot];
+    m->backing = *b; m->address = (uint32_t)va;
+    unsigned access = MG_VM_READ | (b->access & MG_GPU_WRITE ? MG_VM_WRITE : 0) |
+        (b->access & MG_GPU_EXEC ? MG_VM_EXEC : 0);
+    int error = mg_vm_map(r->vm,m->address,b->pages,b->page_count,access);
+    if (error && !r->vm->quarantined) { *m = (struct mg_render_mapping){0}; return error; }
+    r->allocated += b->bytes;
+    *address = m->address;
+    if (error) return poison(r,error); /* nonzero address transfers backing retention */
+    return MG_OK;
+}
+static int unmap(void *p, uint64_t address, size_t bytes)
+{
+    struct mg_render *r = p;
+    if (!running(r)) return MG_UNBACKED;
+    if (r->active) return MG_BUSY;
+    for (unsigned i = 0; i < MG_RENDER_BUFFERS; i++) {
+        struct mg_render_mapping *m = &r->mappings[i];
+        if (m->address != address || m->backing.bytes != bytes) continue;
+        int error = mg_vm_unmap(r->vm,m->address,m->backing.page_count);
+        if (error) return r->vm->quarantined ? poison(r,error) : error;
+        r->allocated -= bytes; *m = (struct mg_render_mapping){0};
+        return MG_OK;
+    }
+    return MG_UNBACKED;
+}
+bool mg_render_mapped(const struct mg_render *r, const void *cpu, uint64_t gpu,
+    size_t bytes, unsigned access)
+{
+    if (!r || !cpu || !bytes || !access || (access & ~7u) ||
+        r->quarantined || r->vm->quarantined || gpu > UINT32_MAX) return false;
+    for (unsigned i = 0; i < MG_RENDER_BUFFERS; i++) {
+        const struct mg_render_mapping *m = &r->mappings[i];
+        if (!m->address || gpu < m->address || gpu-m->address >= m->backing.bytes ||
+            (uintptr_t)cpu < (uintptr_t)m->backing.cpu) continue;
+        uint64_t offset = gpu-m->address;
+        if ((uintptr_t)cpu-(uintptr_t)m->backing.cpu != offset ||
+            bytes > m->backing.bytes-offset || (access & ~m->backing.access)) continue;
+        unsigned first = (unsigned)(offset/4096), pages = (unsigned)(((offset & 4095)+bytes+4095)/4096);
+        unsigned permissions = MG_VM_READ | (access & MG_GPU_WRITE ? MG_VM_WRITE : 0) |
+            (access & MG_GPU_EXEC ? MG_VM_EXEC : 0);
+        return mg_vm_contains(r->vm,(uint32_t)gpu & ~4095u,m->backing.pages+first,pages,permissions);
+    }
+    return false;
+}
+static int submit(void *p, struct mg_gen8_job *job, uint64_t *fence)
+{
+    struct mg_render *r = p;
+    if (!fence) return MG_INVALID;
+    *fence = 0;
+    if (!running(r) || !r->backend->registered) return MG_UNBACKED;
+    if (r->active) return MG_BUSY;
+    for (unsigned i = 0; job && i < job->buffer_count && i < MG_GEN8_MAX_BUFFERS; i++) {
+        const struct mg_gen8_buffer *b = &job->buffers[i];
+        if (!mg_render_mapped(r,b->cpu,b->gpu,b->bytes,b->access)) return MG_UNBACKED;
+    }
+    int error = mg_gen8_submit(r->backend,job,fence);
+    if (*fence) { r->active = job; r->fence = *fence; }
+    if (r->backend->quarantined) return poison(r,error ? error : MG_IO);
+    return error;
+}
+static int wait(void *p, uint64_t fence, unsigned us)
+{
+    struct mg_render *r = p;
+    if (!running(r)) return MG_UNBACKED;
+    if (!fence || fence > r->backend->queue.issued) return MG_INVALID;
+    int error = mg_gen8_wait(r->backend,fence,us);
+    if (!error && r->active && fence >= r->fence) r->active = NULL;
+    if (r->backend->quarantined) return poison(r,error ? error : MG_IO);
+    return error;
+}
+static bool parameter(void *p, uint32_t key, uint64_t *value)
+{
+    struct mg_render *r = p;
+    if (!value || !ready(r)) return false;
+    switch (key) {
+    case 1: case 8: case 9: case 10: case 17: *value = 0; break;
+    case 2: *value = 0x260000; break;
+    case 3: *value = MG_CHIP_ID; break;
+    case 4: *value = r->frequency; break;
+    case 6: *value = 0x4000000; break; /* UCHE GMEM base programmed by GX owner */
+    case 7: *value = 1; break;
+    case 16: *value = 16; break;
+    case 20: *value = 0x1fffffffff000ull; break; /* actual UCHE trap base */
+    default: return false;
+    }
+    return true;
+}
+int mg_render_init(struct mg_render *r, struct mg_vm *vm, struct mg_gen8_backend *backend,
+    void *context, bool (*proof)(void *), uint32_t frequency)
+{
+    if (!r || !vm || !backend || !proof || !frequency ||
+        !vm->domain.attached || vm->domain.stream != 0 || vm->quarantined) return MG_INVALID;
+    if (r->initialized) return MG_BUSY;
