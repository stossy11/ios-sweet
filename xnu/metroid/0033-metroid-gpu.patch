+static int send(struct mg_scheduler *s, uint32_t *packet, unsigned count,
+    unsigned id, unsigned type)
+{
+    if (!count || count > MG_SCHED_PACKET_WORDS || s->sequence == 4095) return MG_LIMIT;
+    int error = health(s); if (error) return error;
+    error = mg_hfi_message(id,type,++s->sequence,count,packet);
+    if (error) return error;
+    s->exposed = true;
+    error = mg_hfi_write(&s->command,packet,count);
+    if (error) return poison(s,error);
+    s->io.write(s->io.context,0x1f994,1); /* control queue doorbell */
+    return MG_OK;
