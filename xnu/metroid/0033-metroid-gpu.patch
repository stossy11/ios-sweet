+static int map_block(struct mg_accel *a, struct mg_accel_block *b,
+    struct mg_vm *vm, unsigned access, uint32_t alignment, bool cache)
+{
+    bool gpu = vm == &a->gpu || vm == &a->secure;
+    uint64_t start = vm == &a->secure ? 0xf0000000ull : gpu ? 0x80000000ull : cache ? 0x4000 : 0x60000000;
+    uint64_t end = vm == &a->secure ? 0x100000000ull : gpu ? 0xb0000000ull : cache ? 0x1000000 : 0x80000000;
+    /* Walk retained boot and newly allocated mappings. Align VA, not PA: the
+     * GMU protocol's alignment exponent is a virtual-address requirement. */
+    for (;;) {
+        start = (start+alignment-1) & ~(uint64_t)(alignment-1);
+        if (start+b->memory.bytes > end) return MG_LIMIT;
+        bool moved = false;
+        for (unsigned i = 0; vm == &a->gmu && i < a->live->memory.count; i++) {
+            const struct mg_dma_range *r = &a->live->memory.ranges[i];
+            if (start < (uint64_t)r->iova+r->bytes && r->iova < start+b->memory.bytes) {
+                start = (uint64_t)r->iova+r->bytes+4096; moved = true; break;
+            }
+        }
+        if (!moved) for (unsigned i = 0; i < a->block_count; i++) {
+            const struct mg_accel_block *r = &a->blocks[i];
+            uint32_t va = gpu ? r->gpu : r->gmu;
+            if (va && start < (uint64_t)va+r->memory.bytes+4096 && va < start+b->memory.bytes+4096) {
+                start = (uint64_t)va+r->memory.bytes+4096; moved = true; break;
+            }
