+    if (__atomic_exchange_n(&rh_lock,1,__ATOMIC_ACQUIRE)) return false;
+    bool ready = mg_fabric_held && !rh_poisoned;
+    __atomic_store_n(&rh_lock,0,__ATOMIC_RELEASE);
+    return ready;
+}
