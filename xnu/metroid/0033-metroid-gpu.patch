+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "metroid_gpu_queue.h"
+
+#define MG_QUEUE_POLL_US 10u
+
+int
+mg_queue_submit(struct mg_queue *queue, const struct mg_queue_io *io,
+    void *job, uint64_t *fence)
+{
+    if (!fence)
+        return MG_INVALID;
+    *fence = 0;
+    if (!queue || !io || !io->ready || !io->dispatch || !io->complete ||
+        !io->retire || !io->delay || !job)
+        return MG_INVALID;
+    if (queue->quarantined)
+        return MG_IO;
+    if (queue->job)
+        return MG_BUSY;
+    if (queue->issued == UINT64_MAX)
+        return MG_LIMIT;
+    if (!io->ready(io->context))
+        return MG_UNSUPPORTED;
+
+    /* Once dispatch begins, an error cannot prove the device missed the job. */
+    queue->job = job;
+    *fence = ++queue->issued;
+    int result = io->dispatch(io->context, job, queue->issued);
+    if (result != MG_OK) {
+        queue->quarantined = true;
+        return result;
+    }
+    return MG_OK;
+}
+
+int
+mg_queue_wait(struct mg_queue *queue, const struct mg_queue_io *io,
+    uint64_t fence, unsigned timeout_us)
+{
+    if (!queue || !io || !io->complete || !io->retire || !io->delay ||
+        !fence || fence > queue->issued || timeout_us > MG_QUEUE_MAX_WAIT_US)
+        return MG_INVALID;
+    if (fence <= queue->completed)
+        return MG_OK;
+    if (queue->quarantined)
+        return MG_IO;
+
+    for (;;) {
+        int result = io->complete(io->context, fence);
+        if (result == MG_OK) {
+            io->retire(io->context, queue->job);
+            queue->job = NULL;
+            queue->completed = fence;
+            return MG_OK;
+        }
+        if (result != MG_EMPTY) {
+            queue->quarantined = true;
+            return result;
+        }
+        /* Timeout leaves the job in flight. A later wait can still retire it. */
+        if (!timeout_us)
+            return MG_TIMEOUT;
+        unsigned delay = timeout_us < MG_QUEUE_POLL_US ? timeout_us : MG_QUEUE_POLL_US;
+        io->delay(io->context, delay);
+        timeout_us -= delay;
+    }
+}
