+#ifndef METROID_GPU_GEM_H
+#define METROID_GPU_GEM_H
+#include "metroid_gpu_submit.h"
+
+/* The real platform owner installs this only after scheduler/firmware/domain
+ * initialization and a fenced GPU memory-write self-test. Installation does
+ * not manufacture readiness. All methods are serialized by the service lock.
+ * map retains the backing through the service; unmap returning an error means
+ * the service must leave it wired, mapped and retained until reboot.
+ */
+struct mg_gem_backing {
+    void *cpu;
+    const uint64_t *pages;
+    unsigned page_count;
+    size_t bytes;
+    unsigned access;
+};
+struct mg_gem_ops {
+    void *context;
+    bool (*ready)(void *);
+    int (*map)(void *, const struct mg_gem_backing *, uint64_t *address);
+    int (*unmap)(void *, uint64_t address, size_t bytes);
+    /* Nonzero fence retains this persistent job even on failure. wait must
+     * prove GPU retirement and CPU visibility before releasing that reference. */
+    int (*submit)(void *, struct mg_gen8_job *, uint64_t *fence);
+    int (*wait)(void *, uint64_t fence, unsigned microseconds);
+    bool (*parameter)(void *, uint32_t, uint64_t *);
+};
