+/* SPDX-License-Identifier: GPL-2.0-only
+ * Owned GMU buffers, following Nothing 031e8669eb19's Gen8 memory layout.
+ * HakiOS's separate kernel-buffer/user-client architecture is retained; no
+ * A6xx firmware, register sequence or command stream is used for this target.
+ */
+#include "metroid_gpu_memory.h"
+#ifdef MG_HOST_TEST
+#include <string.h>
+#else
+#include <libkern/libkern.h>
+#endif
+
+static bool overlap(uint64_t a, uint64_t n, uint64_t b, uint64_t m)
+{ return a < b + m && b < a + n; }
+static size_t rounded(size_t n)
+{ return (n + MG_MEMORY_PAGE - 1) & ~(size_t)(MG_MEMORY_PAGE - 1); }
+
+/* Rounding adjacent firmware reservations can make them share a GPU page.
+ * Union only ranges of the same access class, before allocating backing.
+ */
+static int reservation(struct mg_gmu_memory *m, const struct mg_fw_reservation *r)
+{
+    if (r->region == MG_ITCM || r->region == MG_DTCM) return MG_OK;
+    uint32_t start = r->address & ~4095u;
+    uint64_t end = ((uint64_t)r->address + r->size + 4095) & ~4095ull;
+    bool executable = r->region == MG_CACHE;
+    if (end > (1ull << 32) || end <= start || end - start > MG_MEMORY_LIMIT)
+        return MG_LIMIT;
+    for (unsigned i = 0; i < m->count;) {
+        struct mg_dma_range *p = &m->ranges[i];
+        uint64_t pe = (uint64_t)p->iova + p->bytes;
+        if (p->executable == executable && start <= pe && p->iova <= end) {
+            if (p->iova < start) start = p->iova;
+            if (pe > end) end = pe;
+            m->ranges[i] = m->ranges[--m->count];
+            i = 0; /* A union can now intersect an earlier range. */
+        } else i++;
+    }
+    if (m->count == MG_DMA_MAX_RANGES) return MG_LIMIT;
+    m->ranges[m->count++] = (struct mg_dma_range){start, (uint32_t)(end-start), 0, executable};
+    return MG_OK;
+}
+
+static int scratch(struct mg_gmu_memory *m, uint32_t bytes, uint32_t *address)
+{
+    uint32_t size = (bytes + 4095u) & ~4095u;
+    uint64_t start = 0x60000000;
+    if (!size || m->count == MG_DMA_MAX_RANGES) return MG_LIMIT;
+    for (;;) {
+        bool moved = false;
+        if (start + size > 0x80000000) return MG_LIMIT;
+        for (unsigned i = 0; i < m->count; i++) {
+            const struct mg_dma_range *r = &m->ranges[i];
+            if (overlap(start, size, r->iova, r->bytes)) {
+                start = (uint64_t)r->iova + r->bytes;
+                moved = true;
+                break;
+            }
+        }
+        if (!moved) break;
+    }
+    *address = (uint32_t)start;
+    m->ranges[m->count++] = (struct mg_dma_range){(uint32_t)start, size, 0, false};
+    return MG_OK;
+}
+
+static bool valid_block(const struct mg_memory_block *b, size_t bytes,
+    const struct mg_gmu_memory *m, const void *image, size_t image_bytes)
+{
+    uintptr_t cpu = (uintptr_t)b->cpu;
+    return cpu && b->token && b->bytes == bytes && b->pa &&
+        !((cpu | b->pa) & (MG_MEMORY_PAGE - 1)) &&
+        bytes <= UINTPTR_MAX - cpu && b->pa < (1ull << 48) && bytes <= (1ull << 48) - b->pa &&
+        !overlap(cpu, bytes, (uintptr_t)m, sizeof(*m)) &&
+        !overlap(cpu, bytes, (uintptr_t)image, image_bytes);
+}
+
+int mg_gmu_memory_release(struct mg_gmu_memory *m, const struct mg_memory_io *io)
+{
+    if (!m || !io || !io->release) return MG_INVALID;
+    if (m->exposed) return MG_BUSY;
+    /* A broken allocator may return a token it already gave us. Validate
+     * before use, but do not double-release that token while unwinding. */
+    void *table_token = m->table_block.token;
+    if (table_token) io->release(io->context, &m->table_block);
+    for (unsigned i = m->count; i > 0; i--) {
+        void *token = m->blocks[i-1].token;
+        bool duplicate = token == table_token;
+        for (unsigned j = 0; j + 1 < i; j++)
+            duplicate |= token == m->blocks[j].token;
+        if (token && !duplicate) io->release(io->context, &m->blocks[i-1]);
+    }
+    memset(m, 0, sizeof(*m));
+    return MG_OK;
+}
+
+int mg_gmu_memory_prepare(struct mg_gmu_memory *m, const struct mg_memory_io *io,
+    const void *image, size_t bytes)
+{
+    if (!m || !io || !io->allocate || !io->release || !image || !bytes ||
+        bytes > MG_FW_MAX_BYTES || bytes > UINTPTR_MAX - (uintptr_t)image ||
+        overlap((uintptr_t)m, sizeof(*m), (uintptr_t)image, bytes) ||
+        overlap((uintptr_t)m, sizeof(*m), (uintptr_t)io, sizeof(*io))) return MG_INVALID;
+    if (m->attempted || m->exposed) return MG_BUSY;
+    m->attempted = true;
+    int ret = mg_fw_parse(image, bytes, &m->firmware);
+    if (ret) goto fail;
+    for (unsigned i = 0; i < m->firmware.reservation_count; i++) {
+        ret = reservation(m, &m->firmware.reservations[i]);
+        if (ret) goto fail;
+    }
+    m->firmware_count = m->count;
+    ret = scratch(m, MG_HFI_BYTES, &m->config.hfi); if (ret) goto fail;
+    ret = scratch(m, MG_LOG_BYTES, &m->config.log); if (ret) goto fail;
+    m->config.log_bytes = MG_LOG_BYTES;
+    ret = scratch(m, 4096, &m->config.vrb); if (ret) goto fail;
+    /* Cap the whole allocation before asking the kernel for any wired memory. */
+    m->allocated = MG_PT_MAX_PAGES * 4096u;
+    for (unsigned i = 0; i < m->count; i++) {
+        size_t n = rounded(m->ranges[i].bytes);
+        if (n > MG_MEMORY_LIMIT - m->allocated) { ret = MG_LIMIT; goto fail; }
+        m->allocated += n;
+    }
+    for (unsigned i = 0; i <= m->count; i++) {
+        struct mg_memory_block *b = i == m->count ? &m->table_block : &m->blocks[i];
+        size_t n = i == m->count ? MG_PT_MAX_PAGES * 4096u : rounded(m->ranges[i].bytes);
+        ret = io->allocate(io->context, n, b);
+        if (ret) goto fail;
+        if (!valid_block(b, n, m, image, bytes)) { ret = MG_INVALID; goto fail; }
+        for (unsigned j = 0; j < i; j++) {
+            const struct mg_memory_block *p = &m->blocks[j];
+            if (b->token == p->token || overlap(b->pa,n,p->pa,p->bytes) ||
+                overlap((uintptr_t)b->cpu,n,(uintptr_t)p->cpu,p->bytes)) {
+                ret = MG_INVALID; goto fail;
+            }
+        }
+        if (i < m->count) {
+            m->ranges[i].pa = b->pa;
+            m->backing[i] = (struct mg_gmu_backing){m->ranges[i].iova, m->ranges[i].bytes, b->cpu};
+        }
+    }
+    m->tables = (struct mg_page_tables){m->table_block.cpu, m->table_block.pa,
+        m->table_block.bytes, 0, false};
+    ret = mg_smmu_tables(&m->tables, m->ranges, m->count); if (ret) goto fail;
+    for (unsigned i = m->firmware_count; i < m->count; i++) {
+        const struct mg_gmu_backing *b = &m->backing[i];
+        memset(b->cpu, 0, b->bytes);
+        if (b->iova == m->config.hfi) {
+            ret = mg_hfi_init(b->cpu, b->bytes, b->iova); if (ret) goto fail;
+        } else if (b->iova == m->config.vrb) {
+            /* gmu_core_set_vrb_register(VRB_SIZE_IDX, size >> 2). */
+            ((uint32_t *)b->cpu)[0] = b->bytes / 4;
+        }
+    }
+    m->prepared = true;
+    return MG_OK;
+fail:
+    (void)mg_gmu_memory_release(m, io);
+    return ret;
+}
