+++ b/bsd/dev/metroid_gpu_memory.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef METROID_GPU_MEMORY_H
+#define METROID_GPU_MEMORY_H
+#include "metroid_gpu_start.h"
+
+#define MG_MEMORY_LIMIT (16u * 1024u * 1024u)
+#define MG_LOG_BYTES (64u * 1024u)
+#define MG_MEMORY_PAGE 16384u
+
+/* Allocations must be private, physically contiguous, zeroed, wired and aligned
+ * to 16K on both CPU and physical addresses. The allocator retains each token
+ * until release; it must not recycle any allocation before then. This lets
+ * XNU's 16K pages back the GPU SMMU's independent 4K translation granules.
+ */
+struct mg_memory_block { void *cpu, *token; uint64_t pa; size_t bytes; };
+struct mg_memory_io {
+    void *context;
+    int (*allocate)(void *, size_t, struct mg_memory_block *);
+    void (*release)(void *, struct mg_memory_block *);
+};
+struct mg_gmu_memory {
+    struct mg_fw_plan firmware;
+    struct mg_memory_block blocks[MG_DMA_MAX_RANGES], table_block;
+    struct mg_dma_range ranges[MG_DMA_MAX_RANGES];
+    struct mg_gmu_backing backing[MG_DMA_MAX_RANGES];
+    struct mg_page_tables tables;
+    struct mg_start_config config;
+    unsigned count, firmware_count;
+    size_t allocated;
+    bool attempted, prepared, exposed;
+};
+
+/* Zero-initialize once. No MMIO, SMMU attachment or firmware execution here.
+ * The immutable image must outlive firmware loading. Allocator failures unwind
+ * every owned allocation before returning. A completed object is retained for
+ * the caller's attach/load/start sequence. Its first firmware_count backing
+ * entries are precisely those to pass to mg_gmu_load: HFI/log/VRB must NOT be
+ * included, since that loader zeros its backing before loading firmware.
+ * Set exposed BEFORE any possible device access, including a failed attach.
+ */
+int mg_gmu_memory_prepare(struct mg_gmu_memory *, const struct mg_memory_io *,
+    const void *image, size_t bytes);
+/* Refuses exposed memory even after GMU reset: that does not drain DMA. */
+int mg_gmu_memory_release(struct mg_gmu_memory *, const struct mg_memory_io *);
+
+#endif
