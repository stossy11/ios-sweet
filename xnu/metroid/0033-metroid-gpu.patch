+    s->lpac_smr = free_smr; s->lpac_routed = true;
+    return MG_OK;
+fail:
+    /* Never leave a half-written SID1 route; the bank itself stays attached. */
+    io->write(io->context, 0x800 + free_smr * 4, 0);
+    s->quarantined = true;
+    return ret;
