+#endif
+static uint32_t word(const uint8_t *p)
+{ return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24; }
+static unsigned half(const uint8_t *p) { return p[0] | (unsigned)p[1]<<8; }
+static bool range(size_t size, uint32_t offset, uint32_t bytes)
+{ return offset <= size && bytes <= size-offset; }
+static bool overlaps(uint64_t a, size_t n, uint64_t b, size_t m)
+{ return a < b+m && b < a+n; }
+int mg_zap_parse(const void *image, size_t bytes, struct mg_zap_plan *plan)
+{
+    if (!image || !plan || bytes < 52 || bytes > MG_FW_MAX_BYTES) return MG_INVALID;
+    const uint8_t *p = image;
+    if (word(p) != 0x464c457f || p[4] != 1 || p[5] != 1 || p[6] != 1 ||
+        half(p+16) != 2 || half(p+18) != 0xa4 || word(p+20) != 1 ||
+        half(p+40) != 52 || half(p+42) != 32 || !half(p+44) || half(p+44) > 16)
+        return MG_UNSUPPORTED;
+    uint32_t phoff = word(p+28), count = half(p+44);
+    if (phoff < 52 || !range(bytes,phoff,count*32)) return MG_INVALID;
+    const uint8_t *first = p+phoff;
+    uint32_t headers = word(first+16);
+    if (word(first) == 1 || word(first+4) || headers < phoff+count*32 ||
+        !range(bytes,0,headers) || headers > MG_ZAP_METADATA) return MG_INVALID;
+    struct mg_zap_plan result = {.minimum = UINT32_MAX, .header_bytes = headers};
+    uint64_t end = 0;
+    for (unsigned i = 0; i < count; i++) {
+        const uint8_t *h = p+phoff+32*i;
+        uint32_t type = word(h), offset = word(h+4), physical = word(h+12),
+            file = word(h+16), memory = word(h+20), flags = word(h+24);
+        if ((flags & 0x07000000u) == 0x02000000u) {
+            if (result.hash_bytes || !file || !range(bytes,offset,file) || file > MG_ZAP_METADATA-headers)
+                return MG_INVALID;
+            result.hash_offset = offset; result.hash_bytes = file;
+        } else if (type == 1 && memory) {
+            if (!(flags & (1u << 27)) || file > memory || !range(bytes,offset,file) ||
+                (uint64_t)physical+memory > UINT32_MAX || result.count == 16) return MG_INVALID;
+            for (unsigned j = 0; j < result.count; j++) {
+                const struct mg_zap_segment *s = &result.segments[j];
+                if (physical < (uint64_t)s->physical+s->memory_bytes &&
+                    s->physical < (uint64_t)physical+memory) return MG_INVALID;
+            }
+            result.segments[result.count++] = (struct mg_zap_segment){offset,physical,file,memory};
+            if (physical < result.minimum) result.minimum = physical;
+            if ((uint64_t)physical+memory > end) end = (uint64_t)physical+memory;
+        }
+    }
+    end = (end+4095) & ~4095ull;
+    if (!result.count || !result.hash_bytes || (result.minimum & 4095) ||
+        end <= result.minimum || end-result.minimum > 0x100000) return MG_INVALID;
+    result.span = (uint32_t)(end-result.minimum); *plan = result;
+    return MG_OK;
+}
+int mg_zap_authenticate(struct mg_zap_status *s, const struct mg_zap_io *io,
+    const void *image, size_t bytes)
+{
+    if (!s || !io || !io->reserved || !io->metadata || !io->publish || !io->pas ||
+        !io->reserved_pa || !io->metadata_pa || (io->reserved_pa & 4095) ||
+        (((uintptr_t)io->metadata | io->metadata_pa) & 4095) || io->metadata_bytes < MG_ZAP_METADATA)
+        return MG_INVALID;
+    if (((uintptr_t)io->reserved & 4095) || !io->reserved_bytes || io->reserved_bytes > 0x100000 ||
+        io->reserved_bytes > UINTPTR_MAX-(uintptr_t)io->reserved ||
+        MG_ZAP_METADATA > UINTPTR_MAX-(uintptr_t)io->metadata ||
+        bytes > UINTPTR_MAX-(uintptr_t)image ||
+        io->reserved_pa >= (1ull << 48) || io->reserved_bytes > (1ull << 48)-io->reserved_pa ||
+        io->metadata_pa >= (1ull << 48) || MG_ZAP_METADATA > (1ull << 48)-io->metadata_pa ||
+        overlaps(io->reserved_pa,io->reserved_bytes,io->metadata_pa,MG_ZAP_METADATA) ||
+        overlaps((uintptr_t)io->metadata,MG_ZAP_METADATA,(uintptr_t)io->reserved,io->reserved_bytes) ||
+        overlaps((uintptr_t)image,bytes,(uintptr_t)io->reserved,io->reserved_bytes) ||
+        overlaps((uintptr_t)image,bytes,(uintptr_t)io->metadata,MG_ZAP_METADATA)) return MG_INVALID;
+    if (s->attempted) return MG_BUSY;
+    struct mg_zap_plan plan;
+    int error = mg_zap_parse(image,bytes,&plan);
+    if (error) return error;
+    if (plan.span > io->reserved_bytes) return MG_UNBACKED;
+    s->attempted = true;
+    const uint8_t *p = image;
+    memcpy(io->metadata,p,plan.header_bytes);
+    memcpy((uint8_t *)io->metadata+plan.header_bytes,p+plan.hash_offset,plan.hash_bytes);
+    io->publish(io->context,io->metadata,plan.header_bytes+plan.hash_bytes);
+    s->stage = 1; s->exposed = true;
+    struct mg_scm_result r = io->pas(io->context,1,io->metadata_pa,0);
+    if (r.status || r.value) { error = MG_IO; goto fail; }
+    s->stage = 2;
+    r = io->pas(io->context,2,io->reserved_pa,plan.span);
+    if (r.status || r.value) { error = MG_IO; goto fail; }
+    s->stage = 3;
+    memset(io->reserved,0,plan.span);
+    for (unsigned i = 0; i < plan.count; i++) {
+        const struct mg_zap_segment *v = &plan.segments[i];
+        memcpy((uint8_t *)io->reserved+v->physical-plan.minimum,p+v->offset,v->file_bytes);
+    }
+    io->publish(io->context,io->reserved,plan.span);
+    s->stage = 4;
+    r = io->pas(io->context,5,0,0);
+    if (r.status || r.value) { error = MG_IO; goto fail; }
+    s->stage = 5;
+    return MG_OK;
+fail: s->error = error; return error;
+}
