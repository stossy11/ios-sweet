+/* SPDX-License-Identifier: GPL-2.0-only
+ * Read-only bring-up service. Deliberately does not match "HakiosGPU": that
+ * name makes the Metal plugin enumerate a usable GEM/submit accelerator.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <libkern/c++/OSNumber.h>
+#include "../../bsd/dev/metroid_gpu_live.h"
+
+/* Never map this carveout as Device memory: MDT copies use ordinary RAM
+ * accesses. It is outside XNU-managed RAM and must have no cached CPU alias.
+ * Descriptor+mapping have reboot lifetime, including PAS failures. */
+extern "C" void *metroid_gpu_zap_reserved_map(uint64_t pa, size_t bytes)
+{
+    if (pa != 0x94e9a000 || bytes != 0x2000) return nullptr;
+    auto memory = IOMemoryDescriptor::withPhysicalAddress(pa,bytes,kIODirectionInOut);
+    if (!memory) return nullptr;
+    auto mapping = memory->createMappingInTask(kernel_task,0,kIOMapAnywhere | kIOMapWriteCombineCache,0,bytes);
+    if (!mapping) { memory->release(); return nullptr; }
+    return reinterpret_cast<void *>(mapping->getVirtualAddress());
+}
+
+/* Discovery is deferred until the framebuffer and proven GEM backend both
+ * exist. Framebuffer start and GPU startup may occur in either order. */
+extern "C" bool metroid_gpu_gem_ready(void);
+static IOService *metal_framebuffer;
+static unsigned metal_attempted;
+class IOAcceleratorES : public IOService {
+    OSDeclareDefaultStructors(IOAcceleratorES);
+};
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+extern "C" void metroid_gpu_metal_ready(void)
+{
+    IOService *framebuffer = __atomic_load_n(&metal_framebuffer,__ATOMIC_ACQUIRE);
+    if (!framebuffer || !metroid_gpu_gem_ready()) return;
+    if (__atomic_exchange_n(&metal_attempted,1,__ATOMIC_ACQ_REL)) return;
+    auto accelerator = new IOAcceleratorES;
+    if (!accelerator) return;
+    if (!accelerator->init() || !accelerator->attach(framebuffer)) {
+        accelerator->release();
+        return;
+    }
+    if (!accelerator->start(framebuffer)) {
+        accelerator->detach(framebuffer);
+        accelerator->release();
+        return;
+    }
+    accelerator->setName("sgx");
+    /* Set both before publication: Metal enumerates once per process. */
+    bool properties = accelerator->setProperty("MetalPluginName", "HakiosMetal") &&
+        accelerator->setProperty("MetalPluginClassName", "HakiosMetalDevice") &&
+        accelerator->setProperty("MetroidExperimentalMetal", true) &&
+        accelerator->setProperty("AcceleratorReady", true);
+    if (properties) {
+        IOLog("METROID METAL: selecting HakiosMetal after fenced GPU execution proof\n");
+        accelerator->registerService();
+    } else {
+        accelerator->stop(framebuffer);
+        accelerator->detach(framebuffer);
+        IOLog("METROID METAL: failed to set discovery properties; not published\n");
+    }
+    accelerator->release();
+}
+extern "C" void metroid_gpu_publish_metal(IOService *framebuffer)
+{
+    int enabled = 0;
+    if (!PE_parse_boot_argn("metroidmetal",&enabled,sizeof(enabled)) || enabled != 1 || !framebuffer) return;
+    /* Reboot lifetime; the attached accelerator's parent must outlive it. */
+    framebuffer->retain();
+    IOService *expected = nullptr;
+    if (!__atomic_compare_exchange_n(&metal_framebuffer,&expected,framebuffer,false,
+        __ATOMIC_RELEASE,__ATOMIC_ACQUIRE)) framebuffer->release();
+    metroid_gpu_metal_ready();
+}
+
+/* Descriptor-owned Normal-NC memory: no WB CPU alias used for HFI polling.
+ * The buffer options select the cache mode at allocation, not by adding an
+ * alias to an IOMallocContiguous allocation. MapperNone keeps this GPU SMMU
+ * separate from the unrelated system IOMapper. */
+extern "C" int metroid_gpu_dma_allocate(void *, size_t bytes, mg_memory_block *out)
+{
+    auto memory = new IOBufferMemoryDescriptor;
+    if (!memory) return MG_LIMIT;
+    if (!memory->initWithPhysicalMask(kernel_task,
+        kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMemoryMapperNone |
+        kIOMapWriteCombineCache, bytes, MG_MEMORY_PAGE, 0)) {
+        memory->release();
+        return MG_LIMIT;
+    }
+    if (memory->prepare() != kIOReturnSuccess) {
+        memory->release();
+        return MG_IO;
+    }
+    IOByteCount span = 0;
+    IOPhysicalAddress pa = memory->getPhysicalSegment(0, &span);
+    void *cpu = memory->getBytesNoCopy();
+    if (!cpu || !pa || span < bytes ||
+        ((reinterpret_cast<uintptr_t>(cpu) | pa) & (MG_MEMORY_PAGE - 1))) {
+        memory->complete();
+        memory->release();
+        return MG_UNBACKED;
+    }
+    bzero(cpu, bytes);
+    *out = {cpu, memory, pa, bytes};
+    return MG_OK;
+}
+extern "C" void metroid_gpu_dma_release(void *, mg_memory_block *block)
+{
+    auto memory = static_cast<IOBufferMemoryDescriptor *>(block->token);
+    memory->complete();
+    memory->release();
+    *block = {};
+}
+
+class MetroidGPUUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(MetroidGPUUserClient);
+public:
+    IOReturn clientClose() override;
+    IOReturn externalMethod(uint32_t, IOExternalMethodArguments *,
+        IOExternalMethodDispatch *, OSObject *, void *) override;
+};
+OSDefineMetaClassAndStructors(MetroidGPUUserClient, IOUserClient);
+
+IOReturn MetroidGPUUserClient::clientClose()
+{
+    terminate();
+    return kIOReturnSuccess;
+}
+IOReturn MetroidGPUUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args, IOExternalMethodDispatch *, OSObject *, void *)
+{
+    if (isInactive()) return kIOReturnNotAttached;
+    if (selector != 0) return kIOReturnUnsupported;
+    if (!args || args->scalarInputCount || args->scalarOutputCount ||
+        args->structureInputSize || args->structureInputDescriptor ||
+        args->structureOutputDescriptor || !args->structureOutput ||
+        args->structureOutputSize != sizeof(mg_live_report)) return kIOReturnBadArgument;
+    static_assert(sizeof(mg_live_report) == 64, "status ABI");
+    mg_live_report report;
+    metroid_gpu_copy_report(&report);
+    memcpy(args->structureOutput, &report, sizeof(report));
+    return kIOReturnSuccess;
+}
+
+class MetroidGPU : public IOService {
+    OSDeclareDefaultStructors(MetroidGPU);
+public:
+    bool start(IOService *) override;
+    IOReturn newUserClient(task_t, void *, UInt32, OSDictionary *, IOUserClient **) override;
+};
+OSDefineMetaClassAndStructors(MetroidGPU, IOService);
+
+bool MetroidGPU::start(IOService *provider)
+{
+    if (!IOService::start(provider)) return false;
+    mg_live_report report;
+    metroid_gpu_copy_report(&report);
+    setName("MetroidGPU");
+    setProperty("GPUChipID", MG_CHIP_ID, 32);
+    setProperty("StatusVersion", report.version, 32);
+    setProperty("StartupStage", report.stage, 32);
+    setProperty("StartupError", static_cast<uint32_t>(report.error), 32);
+    setProperty("HFIReady", report.hfi_ready != 0);
+    setProperty("DMAExposed", report.exposed != 0);
+    setProperty("Quarantined", report.quarantined != 0);
+    setProperty("AcceleratorReady", false);
+    setProperty("Interface", "read-only startup status; selector 0, 64-byte ABI v1");
+    registerService();
+    return true;
+}
+IOReturn MetroidGPU::newUserClient(task_t task, void *security, UInt32 type,
+    OSDictionary *properties, IOUserClient **out)
+{
+    if (!out) return kIOReturnBadArgument;
+    *out = nullptr;
+    if (type != 0) return kIOReturnUnsupported;
+    if (isInactive()) return kIOReturnNotAttached;
+    auto client = new MetroidGPUUserClient;
+    if (!client) return kIOReturnNoMemory;
+    if (!client->initWithTask(task, security, type, properties)) {
+        client->release();
+        return kIOReturnNoMemory;
+    }
+    if (!client->attach(this)) {
+        client->release();
+        return kIOReturnError;
+    }
+    if (!client->start(this)) {
+        client->detach(this);
+        client->release();
+        return kIOReturnError;
+    }
+    *out = client;
+    return kIOReturnSuccess;
+}
+
+extern "C" void metroid_gpu_service_start(void)
+{
+    IOService *provider = IOService::getPlatform();
+    if (!provider) return;
+    auto service = new MetroidGPU;
+    if (!service) return;
+    if (!service->init() || !service->attach(provider)) {
+        service->release();
+        return;
+    }
+    if (!service->start(provider)) service->detach(provider);
+    service->release();
+}
+#endif
--- /dev/null
+++ b/iokit/Kernel/MetroidGEM.cpp
@@ -0,0 +1,455 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * HakiOS/MSM DRM 1.7 wire interface for the Metroid Gen8 backend.
+ * ABI reference: HakiOS62e09f85 BoardGPU.cpp and Linux uapi/drm/msm_drm.h.
+ * Any process may open it (the user removed the bring-up root-only check so
+ * backboardd, which runs as mobile, can use Metal). Untrusted PM4 validation
+ * and separate per-process GPU page tables are not implemented here: every
+ * client shares one GPU address space and can submit arbitrary commands.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOKitKeys.h>
+#include <kern/clock.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/kauth.h>
+#include "arm/SweetSurface.h"
+#include "../../bsd/dev/metroid_gpu_gem.h"
+
+struct gem_param { uint32_t pipe, param; uint64_t value; uint32_t len, pad; };
+struct gem_new { uint64_t bytes; uint32_t flags, handle; };
+struct gem_info { uint32_t handle, info; uint64_t value; uint32_t len, pad; };
+struct gem_time { int64_t seconds, nanoseconds; };
+struct gem_prep { uint32_t handle, op; gem_time timeout; };
+struct gem_wait { uint32_t fence, flags; gem_time timeout; uint32_t queue, pad; };
+struct gem_bo { uint32_t flags, handle; uint64_t presumed; };
+struct gem_cmd { uint32_t type, index, offset, bytes, pad, relocations; uint64_t relocs; };
+struct gem_submit {
+    uint32_t flags, fence, buffer_count, command_count; uint64_t buffers, commands;
+    int32_t fence_fd; uint32_t queue;
+    uint64_t in_sync, out_sync; uint32_t in_count, out_count, stride, pad;
+};
+struct gem_surface {
+    uint32_t surface, handle; uint64_t bytes;
+    uint32_t offset, row_bytes, width, height, format, planes;
+};
+struct gem_close { uint32_t handle, pad; };
+struct gem_queue { uint32_t flags, priority, id; };
+struct gem_madvise { uint32_t handle, advice, retained; };
+static_assert(sizeof(gem_param) == 24 && sizeof(gem_new) == 16 &&
+    sizeof(gem_info) == 24 && sizeof(gem_submit) == 72 &&
+    sizeof(gem_cmd) == 32 && sizeof(gem_surface) == 40 && sizeof(gem_wait) == 32,"MSM/HakiOS ABI");
+
+#define GEM_SLOTS 512u
+#define GEM_CLIENT_BYTES (128u * 1024u * 1024u)
+#define GEM_MAX_BYTES (64u * 1024u * 1024u)
+#define GEM_READONLY 2u
+extern "C" void metroid_gpu_metal_ready(void);
+static mg_gem_ops ops;
+static IOLock *device_lock;
+static unsigned installed;
+
+extern "C" bool metroid_gpu_gem_ready(void)
+{ return __atomic_load_n(&installed,__ATOMIC_ACQUIRE) == 2 && ops.ready(ops.context); }
+static IOReturn result(int error)
+{
+    switch (error) {
+    case MG_OK: return kIOReturnSuccess;
+    case MG_LIMIT: return kIOReturnNoResources;
+    case MG_BUSY: case MG_FULL: return kIOReturnBusy;
+    case MG_TIMEOUT: return kIOReturnTimeout;
+    case MG_INVALID: return kIOReturnBadArgument;
+    case MG_UNSUPPORTED: return kIOReturnUnsupported;
+    default: return kIOReturnNotReady;
+    }
+}
+struct gem_buffer {
+    IOMemoryDescriptor *memory;
+    IOMemoryMap *mapping;
+    SweetSurface *surface;
+    uint64_t *pages, address, fence;
+    void *cpu;
+    size_t bytes;
+    uint32_t handle, flags;
+    unsigned page_count;
+};
+
+class HakiosGPUUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(HakiosGPUUserClient);
+    gem_buffer *buffers;
+    mg_gen8_job *job;
+    uint64_t wired, last_fence;
+    uint32_t generation;
+    bool closed, job_pending;
+    gem_buffer *lookup(uint32_t);
+    IOReturn add(IOMemoryDescriptor *, SweetSurface *, uint32_t, uint32_t *);
+    bool drop(gem_buffer *);
+    IOReturn submit(gem_submit *);
+    IOReturn surface(gem_surface *);
+public:
+    bool start(IOService *) override;
+    IOReturn clientClose() override;
+    void free() override;
+    IOReturn clientMemoryForType(UInt32, IOOptionBits *, IOMemoryDescriptor **) override;
+    IOReturn externalMethod(uint32_t, IOExternalMethodArguments *, IOExternalMethodDispatch *, OSObject *, void *) override;
+};
+OSDefineMetaClassAndStructors(HakiosGPUUserClient, IOUserClient);
+gem_buffer *HakiosGPUUserClient::lookup(uint32_t handle)
+{
+    unsigned index = handle & 1023u;
+    if (!index || index > GEM_SLOTS || !buffers) return nullptr;
+    gem_buffer *b = &buffers[index-1];
+    return b->memory && b->handle == handle ? b : nullptr;
+}
+bool HakiosGPUUserClient::start(IOService *provider)
+{
+    if (!metroid_gpu_gem_ready() || !IOUserClient::start(provider)) return false;
+    buffers = IONewZero(gem_buffer,GEM_SLOTS);
+    job = IONewZero(mg_gen8_job,1);
+    return buffers && job;
+}
+/* The descriptor and CPU mapping are retained even when a failed map might
+ * have posted a PTE. Refusing to free is deliberate DMA quarantine. */
+bool HakiosGPUUserClient::drop(gem_buffer *b)
+{
+    if (!b->memory) return true;
+    if ((b->fence && ops.wait(ops.context,b->fence,0)) ||
+        ops.unmap(ops.context,b->address,b->bytes)) return false;
+    b->memory->complete();
+    if (b->mapping) b->mapping->release();
+    b->memory->release();
+    if (b->surface) b->surface->release();
+    IODelete(b->pages,uint64_t,b->page_count);
+    wired -= b->bytes;
+    *b = {};
+    return true;
+}
+IOReturn HakiosGPUUserClient::clientClose()
+{
+    IOLockLock(device_lock);
+    if (!closed) {
+        closed = true;
+        if (job_pending && !ops.wait(ops.context,last_fence,MG_QUEUE_MAX_WAIT_US)) job_pending = false;
+        if (buffers) for (unsigned i = 0; i < GEM_SLOTS; i++) {
+            if (buffers[i].memory && !drop(&buffers[i])) {
+                /* Keep the metadata, descriptor and map alive too: the owner
+                 * may still refer to this backing after an uncertain dispatch. */
+                IOLog("METROID GEM: retaining client backing after uncertain GPU access\n");
+            }
+        }
+    }
+    IOLockUnlock(device_lock);
+    terminate();
+    return kIOReturnSuccess;
+}
+void HakiosGPUUserClient::free()
+{
+    /* clientClose is the only GPU teardown path. free may also follow a failed
+     * start, where no buffers were mapped. Never contact a powered-off GPU. */
+    bool retained = false;
+    if (buffers) for (unsigned i = 0; i < GEM_SLOTS; i++) retained |= buffers[i].memory != nullptr;
+    if (!retained && buffers) IODelete(buffers,gem_buffer,GEM_SLOTS);
+    if (!job_pending && job) IODelete(job,mg_gen8_job,1);
+    IOUserClient::free();
+}
+IOReturn HakiosGPUUserClient::add(IOMemoryDescriptor *memory, SweetSurface *s,
+    uint32_t flags, uint32_t *handle)
+{
+    size_t bytes = static_cast<size_t>(memory->getLength());
+    if (!bytes || bytes > GEM_MAX_BYTES || (bytes & 4095) || bytes > GEM_CLIENT_BYTES-wired ||
+        (flags & ~GEM_READONLY) || job_pending) return kIOReturnBadArgument;
+    unsigned index;
+    for (index = 0; index < GEM_SLOTS; index++) if (!buffers[index].memory) break;
+    if (index == GEM_SLOTS || generation == 0x3fffffu) return kIOReturnNoResources;
+    if (memory->prepare() != kIOReturnSuccess) return kIOReturnVMError;
+    auto mapping = memory->map();
+    unsigned count = static_cast<unsigned>(bytes/4096);
+    auto pages = IONew(uint64_t,count);
+    if (!mapping || !pages) {
+        if (mapping) mapping->release();
+        if (pages) IODelete(pages,uint64_t,count);
+        memory->complete(); return kIOReturnNoMemory;
+    }
+    for (unsigned i = 0; i < count; i++) {
+        IOByteCount span = 0;
+        pages[i] = memory->getPhysicalSegment(i*4096ull,&span);
+        if (!pages[i] || (pages[i] & 4095) || span < 4096) {
+            mapping->release(); IODelete(pages,uint64_t,count);
+            memory->complete(); return kIOReturnVMError;
+        }
+    }
+    gem_buffer b = {};
+    b.memory = memory; b.mapping = mapping; b.surface = s; b.pages = pages;
+    b.cpu = reinterpret_cast<void *>(mapping->getVirtualAddress());
+    b.bytes = bytes; b.page_count = count; b.flags = flags;
+    b.handle = (++generation << 10) | (index+1);
+    mg_gem_backing backing = {b.cpu,pages,count,bytes,
+        static_cast<unsigned>(MG_GPU_READ | MG_GPU_EXEC | (flags & GEM_READONLY ? 0 : MG_GPU_WRITE))};
+    int error = ops.map(ops.context,&backing,&b.address);
+    if (error && !b.address) {
+        mapping->release(); IODelete(pages,uint64_t,count); memory->complete();
+        return result(error);
+    }
+    memory->retain(); if (s) s->retain();
+    buffers[index] = b; wired += bytes;
+    if (error) return result(error); /* retained, deliberately no user handle */
+    *handle = b.handle;
+    return kIOReturnSuccess;
+}
+IOReturn HakiosGPUUserClient::surface(gem_surface *request)
+{
+    SweetSurface *s = sweet_surface_copy(request->surface);
+    if (!s) return kIOReturnNotFound;
+    if (!s->memory) { s->release(); return kIOReturnNotReady; }
+    request->bytes = s->memory->getLength(); request->offset = s->offset;
+    request->row_bytes = s->bytesPerRow; request->width = s->width;
+    request->height = s->height; request->format = s->pixelFormat; request->planes = s->planeCount;
+    IOReturn ret = kIOReturnSuccess;
+    if (request->handle == UINT32_MAX) request->handle = 0;
+    else {
+        bool found = false;
+        for (unsigned i = 0; i < GEM_SLOTS; i++) if (buffers[i].memory && buffers[i].surface == s) {
+            request->handle = buffers[i].handle; found = true; break;
+        }
+        if (!found) ret = add(s->memory,s,0,&request->handle);
+    }
+    s->release();
+    return ret;
+}
+IOReturn HakiosGPUUserClient::submit(gem_submit *r)
+{
+    if (job_pending || !r->buffer_count || r->buffer_count > MG_GEN8_MAX_BUFFERS ||
+        !r->command_count || r->command_count > MG_GEN8_MAX_IBS ||
+        (r->flags & ~0x80000000u) != 0x10 || r->queue != 1 || r->in_sync || r->out_sync ||
+        r->in_count || r->out_count || r->pad) return kIOReturnBadArgument;
+    auto bos = IONew(gem_bo,r->buffer_count);
+    auto cmds = IONew(gem_cmd,r->command_count);
+    if (!bos || !cmds) {
+        if (bos) IODelete(bos,gem_bo,r->buffer_count);
+        if (cmds) IODelete(cmds,gem_cmd,r->command_count);
+        return kIOReturnNoMemory;
+    }
+    IOReturn ret = kIOReturnBadArgument;
+    do {
+        if (copyin(r->buffers,bos,r->buffer_count*sizeof(*bos)) ||
+            copyin(r->commands,cmds,r->command_count*sizeof(*cmds))) { ret = kIOReturnVMError; break; }
+        *job = {}; job->buffer_count = r->buffer_count; job->ib_count = r->command_count;
+        bool valid = true;
+        for (unsigned i = 0; i < r->buffer_count; i++) {
+            gem_buffer *b = lookup(bos[i].handle);
+            /* MSM_SUBMIT_BO_DUMP is a diagnostic hint, emitted by Mesa for
+             * command BOs. It does not add a GPU access permission. */
+            if (!b || !(bos[i].flags & 3) || (bos[i].flags & ~7u) ||
+                ((bos[i].flags & 2) && (b->flags & GEM_READONLY)) ||
+                (bos[i].presumed && bos[i].presumed != b->address)) { valid = false; break; }
+            for (unsigned j = 0; j < i; j++) if (bos[i].handle == bos[j].handle) valid = false;
+            job->buffers[i] = {b->cpu,b->address,b->bytes,
+                static_cast<unsigned>((bos[i].flags & 1 ? MG_GPU_READ : 0) |
+                    (bos[i].flags & 2 ? MG_GPU_WRITE : 0))};
+        }
+        if (!valid) break;
+        for (unsigned i = 0; i < r->command_count; i++) {
+            const gem_cmd &c = cmds[i];
+            if (c.type != 1 || c.index >= r->buffer_count || !c.bytes ||
+                ((c.offset | c.bytes) & 3) || c.relocations || c.relocs || c.pad ||
+                c.offset > job->buffers[c.index].bytes ||
+                c.bytes > job->buffers[c.index].bytes-c.offset) { valid = false; break; }
+            job->buffers[c.index].access |= MG_GPU_READ | MG_GPU_EXEC;
+            job->ibs[i] = {c.index,c.offset,c.bytes};
+        }
+        if (!valid) break;
+        uint64_t fence = 0;
+        int error = ops.submit(ops.context,job,&fence);
+        if (fence) {
+            last_fence = fence; job_pending = true;
+            for (unsigned i = 0; i < r->buffer_count; i++) lookup(bos[i].handle)->fence = fence;
+        }
+        if (error) { ret = result(error); break; }
+        if (!fence || fence > UINT32_MAX) { ret = kIOReturnInternalError; break; }
+        /* Deliberately synchronous bring-up: no buffer reuse or presentation
+         * can outrun the real retirement/CPU-visibility proof. */
+        error = ops.wait(ops.context,fence,MG_QUEUE_MAX_WAIT_US);
+        if (!error) job_pending = false;
+        ret = result(error);
+        if (!error) { r->fence = static_cast<uint32_t>(fence); r->fence_fd = -1; }
+    } while (false);
+    IODelete(bos,gem_bo,r->buffer_count); IODelete(cmds,gem_cmd,r->command_count);
+    return ret;
+}
+IOReturn HakiosGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+    if (!options || !memory) return kIOReturnBadArgument;
+    *memory = nullptr;
+    IOLockLock(device_lock);
+    gem_buffer *b = closed ? nullptr : lookup(type);
+    if (b) { b->memory->retain(); *memory = b->memory; *options = 0; }
+    IOLockUnlock(device_lock);
+    return b ? kIOReturnSuccess : kIOReturnBadArgument;
+}
+IOReturn HakiosGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *a,
+    IOExternalMethodDispatch *, OSObject *, void *)
+{
+    union request { gem_param param; gem_new create; gem_info info; gem_prep prep;
+        gem_wait wait; gem_submit submit; gem_surface surface; gem_close close;
+        gem_queue queue; gem_madvise advice; } r = {};
+    size_t bytes;
+    switch (selector) {
+    case 0x40: case 0x41: bytes = sizeof(r.param); break;
+    case 0x42: bytes = sizeof(r.create); break;
+    case 0x43: bytes = sizeof(r.info); break;
+    case 0x44: bytes = sizeof(r.prep); break;
+    case 0x45: bytes = 4; break;
+    case 0x46: bytes = sizeof(r.submit); break;
+    case 0x47: bytes = sizeof(r.wait); break;
+    case 0x48: bytes = sizeof(r.advice); break;
+    case 0x4a: bytes = sizeof(r.queue); break;
+    case 0x4b: bytes = 4; break;
+    case 0x09: bytes = sizeof(r.close); break;
+    case 0x7e: bytes = sizeof(r.surface); break;
+    default: return kIOReturnUnsupported;
+    }
+    if (!a || a->scalarInputCount || a->scalarOutputCount || a->structureInputDescriptor ||
+        a->structureOutputDescriptor || !a->structureInput || !a->structureOutput ||
+        a->structureInputSize != bytes || a->structureOutputSize != bytes) return kIOReturnBadArgument;
+    memcpy(&r,a->structureInput,bytes);
+    IOLockLock(device_lock);
+    IOReturn ret = kIOReturnSuccess;
+    if (closed || isInactive() || !metroid_gpu_gem_ready()) ret = kIOReturnNotReady;
+    else switch (selector) {
+    case 0x40:
+        if (r.param.pipe != 0x10 || r.param.len || r.param.pad ||
+            !ops.parameter(ops.context,r.param.param,&r.param.value)) ret = kIOReturnUnsupported;
+        break;
+    case 0x41: break; /* optional diagnostic process name */
+    case 0x42: {
+        if (!r.create.bytes || r.create.bytes > GEM_MAX_BYTES ||
+            (r.create.flags & ~(GEM_READONLY | 0xf0000u | 1u | 4u))) { ret = kIOReturnBadArgument; break; }
+        size_t capacity = static_cast<size_t>((r.create.bytes+PAGE_MASK) & ~(uint64_t)PAGE_MASK);
+        auto memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+            kIODirectionInOut | kIOMemoryMapperNone | kIOMemoryKernelUserShared | kIOMapWriteCombineCache,
+            capacity,PAGE_SIZE);
+        if (!memory) { ret = kIOReturnNoMemory; break; }
+        if (!memory->getBytesNoCopy()) { memory->release(); ret = kIOReturnNoMemory; break; }
+        bzero(memory->getBytesNoCopy(),capacity);
+        ret = add(memory,nullptr,r.create.flags & GEM_READONLY,&r.create.handle);
+        memory->release(); break;
+    }
+    case 0x43: {
+        gem_buffer *b = lookup(r.info.handle);
+        if (!b || r.info.pad) ret = kIOReturnBadArgument;
+        else if (r.info.info == 0) r.info.value = b->handle;
+        else if (r.info.info == 1) r.info.value = b->address;
+        else if (r.info.info == 2) { /* advisory debugger name; not retained or dereferenced */ }
+        else if (r.info.info == 5) r.info.value = b->flags | 0x20000u; /* actual WC mapping */
+        else ret = kIOReturnUnsupported;
+        break;
+    }
+    case 0x44: {
+        gem_buffer *b = lookup(r.prep.handle);
+        ret = b ? result(b->fence ? ops.wait(ops.context,b->fence,MG_QUEUE_MAX_WAIT_US) : MG_OK) : kIOReturnBadArgument;
+        break;
+    }
+    case 0x45: break; /* synchronous submit owns cache transitions */
+    case 0x46: ret = submit(&r.submit); break;
+    case 0x47:
+        ret = (!r.wait.fence || r.wait.fence > last_fence || r.wait.flags || r.wait.queue != 1) ?
+            kIOReturnBadArgument : result(ops.wait(ops.context,r.wait.fence,MG_QUEUE_MAX_WAIT_US));
+        if (!ret && r.wait.fence == last_fence) job_pending = false;
+        break;
+    case 0x48: if (!lookup(r.advice.handle)) ret = kIOReturnBadArgument; else r.advice.retained = 1; break;
+    case 0x4a:
+        if (r.queue.flags || r.queue.priority) ret = kIOReturnUnsupported; else r.queue.id = 1;
+        break;
+    case 0x4b: if (r.close.handle != 1) ret = kIOReturnBadArgument; break;
+    case 0x09: {
+        gem_buffer *b = lookup(r.close.handle);
+        ret = b && !r.close.pad ? (drop(b) ? kIOReturnSuccess : kIOReturnBusy) : kIOReturnBadArgument;
+        break;
+    }
+    case 0x7e: ret = surface(&r.surface); break;
+    }
+    if (!ret) memcpy(a->structureOutput,&r,bytes);
+    IOLockUnlock(device_lock);
+    return ret;
+}
