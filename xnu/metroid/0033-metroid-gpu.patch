+++ b/bsd/dev/metroid_gpu_platform.c
@@ -0,0 +1,205 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * XNU adapter for the retained GMU owner. No inherited bandwidth assumption.
+ * Register sequences: Nothing 031e8669, gpucc-tuna.c/adreno_gen8.c.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <IOKit/IOLib.h>
+#include "metroid_gpu_live.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+/* One mapping includes GPU, TCM, GMUCX, AO, GPUCC and CX_MISC. Do not map
+ * overlapping Device aliases separately. The next aperture is the SMMU. */
+#define MG_REGISTER_BYTES 0xa0000u
+static struct {
+    vm_offset_t gpu, gcc, smmu;
+    struct mg_live live;
+    struct mg_fabric_owner fabric;
+    unsigned phase, report_ready;
+    struct mg_live_report report;
+} platform;
+
+int metroid_gpu_install_fabric_owner(const struct mg_fabric_owner *owner)
+{
+    if (!owner || !owner->retain || !owner->ready ||
+        !owner->ahb_timeout || owner->ahb_timeout > 31) return MG_INVALID;
+    unsigned expected = 0;
+    if (!__atomic_compare_exchange_n(&platform.phase, &expected, 1, false,
+        __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return MG_BUSY;
+    platform.fabric = *owner;
+    __atomic_store_n(&platform.phase, 2, __ATOMIC_RELEASE);
+    return MG_OK;
+}
+void metroid_gpu_copy_report(struct mg_live_report *out)
+{
+    if (!out) return;
+    *out = (struct mg_live_report){.version = 1};
+    /* Published exactly once, after all mutable boot state is finalized. */
+    if (__atomic_load_n(&platform.report_ready, __ATOMIC_ACQUIRE))
+        *out = platform.report;
+}
+static uint32_t rd(vm_offset_t base, uint32_t offset)
+{
+    uint32_t value = *(volatile uint32_t *)(base + offset);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+static void wr(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)(base + offset) = value;
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+static uint32_t gpu_read(void *p, uint32_t reg)
+{ (void)p; return reg < MG_REGISTER_BYTES / 4 ? rd(platform.gpu, reg * 4) : UINT32_MAX; }
+static void gpu_write(void *p, uint32_t reg, uint32_t value)
+{ (void)p; if (reg < MG_REGISTER_BYTES / 4) wr(platform.gpu, reg * 4, value); }
+static uint32_t power_read(void *p, enum mg_bus bus, uint32_t offset)
+{ (void)p; return rd(bus == MG_CC ? platform.gpu + MG_GPUCC_PA - MG_GPU_PA : platform.gcc, offset); }
+static void power_write(void *p, enum mg_bus bus, uint32_t offset, uint32_t value)
+{ (void)p; wr(bus == MG_CC ? platform.gpu + MG_GPUCC_PA - MG_GPU_PA : platform.gcc, offset, value); }
+static uint32_t smmu_read(void *p, uint32_t offset)
+{ (void)p; return offset <= MG_SMMU_SIZE - 4 ? rd(platform.smmu, offset) : UINT32_MAX; }
+static void smmu_write(void *p, uint32_t offset, uint32_t value)
+{ (void)p; if (offset <= MG_SMMU_SIZE - 4) wr(platform.smmu, offset, value); }
+static void smmu_write64(void *p, uint32_t offset, uint64_t value)
+{
+    (void)p;
+    if (offset > MG_SMMU_SIZE - 8 || (offset & 7)) return;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint64_t *)(platform.smmu + offset) = value;
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+static void wait_us(void *p, unsigned us) { (void)p; IODelay(us); }
+static int rails(void *p) { (void)p; return metroid_gpu_rpmh_enable() ? MG_IO : MG_OK; }
+static int retain_fabric(void *p) { (void)p; return platform.fabric.retain(platform.fabric.context); }
+static bool fabric_ready(void *p) { (void)p; return platform.fabric.ready(platform.fabric.context); }
+static int board_retain(void *p)
+{ (void)p; return metroid_gpu_rpmh_fabric_enable() ? MG_IO : MG_OK; }
+static bool board_ready(void *p)
+{ (void)p; return metroid_gpu_rpmh_fabric_ready(); }
+static void publish(void *p, const void *cpu, size_t bytes)
+{
+    (void)p;
+    uint64_t ctr;
+    __asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+    uintptr_t line = (uintptr_t)4 << ((ctr >> 16) & 15);
+    uintptr_t end = (uintptr_t)cpu + bytes;
+    for (uintptr_t va = (uintptr_t)cpu & ~(line - 1); va < end; va += line)
+        __asm__ volatile("dc cvac, %0" :: "r"(va) : "memory");
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+static uint64_t counter(void)
+{ uint64_t value; __asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(value)); return value; }
+static int configure(void *p)
+{
+    (void)p;
+    /* Never inspect the GMU while GPUCC holds its block in reset. Once
+     * deasserted, the CM3 reset default must still be asserted. */
+    uint32_t reset = power_read(NULL, MG_CC, 0x9314);
+    if (reset == UINT32_MAX || !(reset & 1)) return MG_STALE;
+    power_write(NULL, MG_CC, 0x9314, reset & ~1u);
+    wait_us(NULL, 10);
+    if ((power_read(NULL, MG_CC, 0x9314) & 1) || gpu_read(NULL, 0x1f800) != 1)
+        return MG_STALE;
+    uint32_t vote = power_read(NULL, MG_CC, 0x7000);
+    if (vote == UINT32_MAX) return MG_IO;
+    power_write(NULL, MG_CC, 0x7000, vote | 1);
+    unsigned us;
+    for (us = 0; us < 1000; us++) {
+        vote = power_read(NULL, MG_CC, 0x7000);
+        if (vote == UINT32_MAX) return MG_IO;
+        if ((vote & 0x80000001u) == 1) break;
+        wait_us(NULL, 1);
+    }
+    if (us == 1000) return MG_TIMEOUT;
+    for (uint32_t reg = 0x27810; reg <= 0x27814; reg++) {
+        uint32_t value = 0x1b00u | platform.fabric.ahb_timeout;
+        gpu_write(NULL, reg, value);
+        if (gpu_read(NULL, reg) != value) return MG_IO;
+    }
+    /* Source's 16-sample CX timer calibration, bounded with interrupts off.
+     * Clamp unsigned timing noise rather than wrapping to an enormous skew. */
+    uint64_t skew = 0;
+    boolean_t interrupts = ml_set_interrupts_enabled(FALSE);
+    for (unsigned i = 0; i < 16; i++) {
+        uint64_t a = counter(), b = counter();
+        gpu_write(NULL, 0x27880, (uint32_t)b);
+        gpu_write(NULL, 0x27881, (uint32_t)(b >> 32));
+        uint64_t c = counter();
+        if (c - b > b - a) skew += (c - b) - (b - a);
+    }
+    uint64_t seed = counter() + (skew + 8) / 16;
+    gpu_write(NULL, 0x27880, (uint32_t)seed);
+    gpu_write(NULL, 0x27881, (uint32_t)(seed >> 32));
+    ml_set_interrupts_enabled(interrupts);
+    return MG_OK;
+}
+
+void metroid_gpu_live_init(const void *image, size_t bytes)
+{
+    /* Gen8.6.0 source profile: HUB=200MHz, NOC timeout=6800us.
+     * ilog2(200*6800)-1 = 19; AHB expires after 2^20 cycles = 5242.88us.
+     * A previously installed board owner takes precedence. */
+    const struct mg_fabric_owner board = {NULL,board_retain,board_ready,19};
+    if (__atomic_load_n(&platform.phase,__ATOMIC_ACQUIRE) == 0)
+        (void)metroid_gpu_install_fabric_owner(&board);
+    unsigned expected = 2;
+    if (!__atomic_compare_exchange_n(&platform.phase, &expected, 3, false,
+        __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        if (expected == 3) return;
+        /* Freeze installation even when the provider was missing at boot. */
+        expected = 0;
+        if (!__atomic_compare_exchange_n(&platform.phase, &expected, 3, false,
+            __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return;
+        platform.live.error = image && bytes ? MG_UNBACKED : MG_INVALID;
+        printf("METROID GPU: live startup refused: no retained DDR/CNOC/TCU fabric owner\n");
+        goto report;
+    }
+    if (!image || !bytes) {
+        platform.live.error = MG_INVALID;
+        goto report;
+    }
+    platform.gpu = ml_io_map(MG_GPU_PA, MG_REGISTER_BYTES);
+    platform.gcc = ml_io_map(0x00100000, 0x80000);
+    platform.smmu = ml_io_map(MG_SMMU_PA, MG_SMMU_SIZE);
+    if (!platform.gpu || !platform.gcc || !platform.smmu) {
+        platform.live.error = MG_IO;
+        if (platform.gpu) ml_io_unmap(platform.gpu, MG_REGISTER_BYTES);
+        if (platform.gcc) ml_io_unmap(platform.gcc, 0x80000);
+        if (platform.smmu) ml_io_unmap(platform.smmu, MG_SMMU_SIZE);
+        platform.gpu = platform.gcc = platform.smmu = 0;
+        goto report;
+    }
+    const struct mg_live_io io = {
+        .memory = {NULL, metroid_gpu_dma_allocate, metroid_gpu_dma_release},
+        .power = {NULL, power_read, power_write, wait_us, rails},
+        .smmu = {NULL, smmu_read, smmu_write, smmu_write64, wait_us, publish},
+        .retain_fabric = retain_fabric, .fabric_ready = fabric_ready,
+        .configure = configure, .read = gpu_read, .write = gpu_write,
+        .delay = wait_us, .publish = publish, .scm = mg_scm_native,
+    };
+    (void)mg_live_boot(&platform.live, &io, image, bytes);
+report:
+    platform.report = (struct mg_live_report){
+        .version = 1, .mode = 5, .stage = platform.live.stage,
+        .error = platform.live.error, .power_stage = platform.live.power.stage,
+        .start_stage = platform.live.start.stage,
+        .smmu_offset = platform.live.domain.offset, .smmu_value = platform.live.domain.value,
+        .start_register = platform.live.start.reg, .start_value = platform.live.start.value,
+        .ranges = platform.live.memory.count, .table_pages = platform.live.memory.tables.used,
+        .exposed = platform.live.memory.exposed, .quarantined = platform.live.quarantined,
+        .hfi_ready = platform.live.stage == MG_LIVE_HFI,
+        .accelerator_ready = 0, /* scheduler/SQE/AQE/ZAP + render proof absent */
+    };
+    __atomic_store_n(&platform.report_ready, 1, __ATOMIC_RELEASE);
+    printf("METROID GPU: live result=%d stage=%u exposed=%u quarantine=%u HFI=%u; accelerator unavailable\n",
+        platform.report.error, platform.report.stage, platform.report.exposed,
+        platform.report.quarantined, platform.report.hfi_ready);
+    metroid_gpu_service_start();
+}
