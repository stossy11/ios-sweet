+/* SPDX-License-Identifier: GPL-2.0-only
+ * Cold A825 GX/CP initialization, Nothing031e8669 adreno_gen8{,_hwsched}.c.
+ */
+#include "metroid_gpu_hardware.h"
+#include "metroid_gpu_registers.h"
+#define BIT(n) (1u << (n))
+enum { PIPE_NONE, PIPE_BR, PIPE_BV, PIPE_LPAC, PIPE_AQE0, PIPE_AQE1, PIPE_DDE_BR, PIPE_DDE_BV };
+#include "metroid_gpu_profile.h"
+#define COUNT(a) (sizeof(a)/sizeof((a)[0]))
+
+static int fail(struct mg_hardware *h, int error)
+{ h->error = error; h->quarantined = true; return error; }
+static void trace(struct mg_hardware *h, const char *phase)
+{ if (h->io.trace) h->io.trace(h->io.context,phase); }
+static void write_reg(struct mg_hardware *h, uint32_t reg, uint32_t value)
+{ h->reg = reg; h->value = value; h->io.write(h->io.context,reg,value); }
+static uint32_t read_reg(struct mg_hardware *h, uint32_t reg)
+{ h->reg = reg; return h->value = h->io.read(h->io.context,reg); }
+static int poll(struct mg_hardware *h, uint32_t reg, uint32_t mask, uint32_t wanted, unsigned us)
+{
+    for (unsigned i = 0; i < us; i++) {
+        if (!h->io.ready(h->io.context)) return fail(h,MG_UNBACKED);
+        uint32_t value = read_reg(h,reg);
+        if (value == UINT32_MAX) return fail(h,MG_IO);
+        if ((value & mask) == wanted) return MG_OK;
+        h->io.delay(h->io.context,1);
+    }
+    return fail(h,MG_TIMEOUT);
+}
+static void aperture(struct mg_hardware *h, unsigned pipe)
+{ write_reg(h,GEN8_CP_APERTURE_CNTL_HOST,pipe << 12); }
+static bool pipe_enabled(unsigned pipe) { return pipe != PIPE_LPAC && pipe != PIPE_AQE1; }
+static void pipe_write(struct mg_hardware *h, unsigned pipe, uint32_t reg, uint32_t value)
+{ aperture(h,pipe); write_reg(h,reg,value); }
+static uint32_t packet7(unsigned opcode, unsigned count)
+{
+    unsigned cp = 1, op = 1;
+    for (unsigned n = count; n; n >>= 1) cp ^= n & 1;
+    for (unsigned n = opcode; n; n >>= 1) op ^= n & 1;
+    return 0x70000000u | count | (cp << 15) | (opcode << 16) | (op << 23);
+}
+static int restore(struct mg_hardware *h, const struct mg_hw_config *c)
+{
+    uint32_t *out = c->restore_cpu;
+    /* Exact 16-byte cpu_gpu_lock followed by static pairs and pipe triplets. */
+    unsigned at = 4, dynamic = 0;
+    for (unsigned list = 0; list < 2; list++) {
+        const uint32_t *regs = list ? gen8_pwrup_reglist : gen8_ifpc_pwrup_reglist;
+        unsigned count = list ? COUNT(gen8_pwrup_reglist) : COUNT(gen8_ifpc_pwrup_reglist);
+        for (unsigned i = 0; i < count; i++) {
+            if ((at+2)*4 > c->restore_bytes) return fail(h,MG_LIMIT);
+            out[at++] = regs[i]; out[at++] = read_reg(h,regs[i]);
+            if (h->value == UINT32_MAX) return fail(h,MG_IO);
+        }
+    }
+    for (unsigned pipe = PIPE_BR; pipe <= PIPE_DDE_BV; pipe++) {
+        if (!pipe_enabled(pipe)) continue;
+        aperture(h,pipe);
+        for (unsigned i = 0; i < COUNT(gen8_0_0_pwrup_extlist); i++) {
+            const struct mg_hw_ext *e = &gen8_0_0_pwrup_extlist[i];
+            if (!(e->pipelines & BIT(pipe))) continue;
+            if ((at+3)*4 > c->restore_bytes) return fail(h,MG_LIMIT);
+            out[at++] = pipe << 12; out[at++] = e->reg; out[at++] = read_reg(h,e->reg);
+            if (h->value == UINT32_MAX) return fail(h,MG_IO);
+            dynamic++;
+        }
+    }
+    aperture(h,0);
+    out[0] = out[1] = out[2] = 0;
+    out[3] = COUNT(gen8_ifpc_pwrup_reglist) | (COUNT(gen8_pwrup_reglist) << 8) | (dynamic << 16);
+    h->io.publish(h->io.context,out,at*4);
+    return MG_OK;
+}
+static int registers(struct mg_hardware *h)
+{
+    trace(h,"GX registers: aperture and GMEM");
+    aperture(h,0);
+    write_reg(h,GEN8_RBBM_PERFCTR_GPU_BUSY_MASKED,UINT32_MAX);
+    /* GMEM=0x260000, UCHE alignment=64MiB, highest bank bit16, MAL32, UBWC5. */
+    write_reg(h,GEN8_UCHE_CCHE_GC_GMEM_RANGE_MIN_LO,0x4000000);
+    write_reg(h,GEN8_UCHE_CCHE_GC_GMEM_RANGE_MIN_HI,0);
+    write_reg(h,GEN8_SP_HLSQ_GC_GMEM_RANGE_MIN_LO,0x4000000);
+    write_reg(h,GEN8_SP_HLSQ_GC_GMEM_RANGE_MIN_HI,0);
+    write_reg(h,GEN8_UCHE_TRAP_BASE_LO,0xfffff000);
+    write_reg(h,GEN8_UCHE_TRAP_BASE_HI,0x1ffff);
+    write_reg(h,GEN8_UCHE_WRITE_THRU_BASE_LO,0xfffff000);
+    write_reg(h,GEN8_UCHE_WRITE_THRU_BASE_HI,0x1ffff);
+    write_reg(h,GEN8_GMUCX_POWER_COUNTER_SELECT_XOCLK_1,4);
+    pipe_write(h,PIPE_BV,GEN8_GRAS_NC_MODE_CNTL,0x60);
+    pipe_write(h,PIPE_BR,GEN8_GRAS_NC_MODE_CNTL,0x60);
+    pipe_write(h,PIPE_BR,GEN8_RB_CCU_NC_MODE_CNTL,6);
+    pipe_write(h,PIPE_BR,GEN8_RB_CMP_NC_MODE_CNTL,0x20006);
+    aperture(h,0);
+    write_reg(h,GEN8_SP_NC_MODE_CNTL,0x26);
+    write_reg(h,GEN8_TPL1_NC_MODE_CNTL,6);
+    for (unsigned i = 0; i < COUNT(gen8_0_0_bicubic_regs); i++)
+        write_reg(h,gen8_0_0_bicubic_regs[i].reg,gen8_0_0_bicubic_regs[i].value);
+    write_reg(h,GEN8_UCHE_CLIENT_PF,0x81);
+    trace(h,"GX registers: non-context setup");
+    for (unsigned i = 0; gen8_6_0_nonctxt_regs[i].reg; i++) {
+        const struct mg_hw_nonctxt *r = &gen8_6_0_nonctxt_regs[i];
+        for (unsigned pipe = PIPE_NONE; pipe <= PIPE_DDE_BV; pipe++)
+            if (pipe_enabled(pipe) && (r->pipelines & BIT(pipe))) pipe_write(h,pipe,r->reg,r->value);
+    }
+    aperture(h,0);
+    write_reg(h,GEN8_RBBM_INTERFACE_HANG_INT_CNTL,0x40cfffff);
+    write_reg(h,GEN8_RBBM_SLICE_INTERFACE_HANG_INT_CNTL,BIT(30));
+    write_reg(h,GEN8_GMUAO_GPU_CX_BUSY_MASK,0xff000000);
+    uint32_t select = read_reg(h,GEN8_GMUCX_POWER_COUNTER_SELECT_XOCLK_0);
+    if (select == UINT32_MAX) return fail(h,MG_IO);
+    write_reg(h,GEN8_GMUCX_POWER_COUNTER_SELECT_XOCLK_0,(select & ~255u) | 0x20);
+    write_reg(h,GEN8_GMUCX_POWER_COUNTER_ENABLE,1);
+    trace(h,"GX registers: protection masks");
+    for (unsigned pipe = PIPE_BR; pipe <= PIPE_BV; pipe++)
+        pipe_write(h,pipe,GEN8_CP_PROTECT_CNTL_PIPE,0xffff000b);
+    aperture(h,0);
+    uint32_t span = 0;
+    for (unsigned i = 0; gen8_0_0_protected_regs[i].reg; i++) {
+        const struct mg_hw_protect *r = &gen8_0_0_protected_regs[i];
+        span = r->start | ((r->end-r->start) << 18) | (r->noaccess << 31);
+        write_reg(h,r->reg,span);
+    }
+    for (unsigned pipe = PIPE_BR; pipe <= PIPE_DDE_BV; pipe++) {
+        if (!pipe_enabled(pipe)) continue;
+        if (pipe <= PIPE_BV) pipe_write(h,pipe,GEN8_CP_PROTECT_REG_PIPE+15,span);
+        pipe_write(h,pipe,GEN8_CP_APRIV_CNTL_PIPE,pipe == PIPE_BR ? 0x6f : 0xf);
+        pipe_write(h,pipe,GEN8_CP_INTERRUPT_STATUS_MASK_PIPE,0x07e83f7f);
+        pipe_write(h,pipe,GEN8_CP_HW_FAULT_STATUS_MASK_PIPE,0x77f);
+    }
+    aperture(h,0);
+    write_reg(h,GEN8_CP_INTERRUPT_STATUS_MASK_GLOBAL,0x007f007f);
+    trace(h,"GX registers: trusted VA range");
+    write_reg(h,GEN8_RBBM_SECVID_TSB_CNTL,0);
+    write_reg(h,GEN8_RBBM_SECVID_TSB_TRUSTED_BASE_LO,0xf0000000);
+    write_reg(h,GEN8_RBBM_SECVID_TSB_TRUSTED_BASE_HI,0);
+    /* A 32-bit IOVA domain reserves [f0000000,100000000) for secure memory;
+     * protected context-switch allocations use only stream2 in this range. */
+    write_reg(h,GEN8_RBBM_SECVID_TSB_TRUSTED_SIZE,0x10000000);
+    /* Disable host IRQ delivery: faults/completion are polled, never claimed. */
+    write_reg(h,GEN8_RBBM_INT_0_MASK,0);
+    trace(h,"GX registers: clock gating");
+    for (unsigned i = 0; i < COUNT(gen8_ao_hwcg_regs); i++)
+        write_reg(h,gen8_ao_hwcg_regs[i].reg,gen8_ao_hwcg_regs[i].value);
+    write_reg(h,GEN8_RBBM_CLOCK_CNTL_GLOBAL,1);
+    write_reg(h,GEN8_RBBM_CGC_GLOBAL_LOAD_CMD,1);
+    write_reg(h,GEN8_RBBM_CGC_P2S_TRIG_CMD,1);
+    int error = poll(h,GEN8_RBBM_CGC_P2S_STATUS,1,1,3);
+    if (!error) write_reg(h,GEN8_RBBM_CLOCK_CNTL_GLOBAL,0);
+    if (!error) trace(h,"GX clock gating synchronized");
+    return error;
+}
+int mg_hardware_boot(struct mg_hardware *h, const struct mg_hw_io *io,
+    const struct mg_hw_config *c, struct mg_scheduler *s)
+{
+    if (!h || !io || !c || !s || !io->ready || !io->read || !io->write ||
+        !io->delay || !io->publish || !io->authenticate_zap || !c->sqe || !c->aqe ||
+        !c->restore || ((c->sqe | c->aqe | c->restore) & 4095) ||
+        c->sqe >= (1ull << 32) || c->aqe >= (1ull << 32) || c->restore >= (1ull << 32) ||
+        !c->restore_cpu || ((uintptr_t)c->restore_cpu & 4095) || c->restore_bytes < 4096 ||
+        !s->booting_gpu || s->stage != MG_SCHED_STARTED) return MG_INVALID;
+    if (h->attempted) return MG_BUSY;
+    h->attempted = true; h->io = *io;
+    if (!io->ready(io->context)) return fail(h,MG_UNBACKED);
+    h->exposed = true;
+    trace(h,"request GX OOB power");
+    write_reg(h,GEN8_GMUCX_HOST2GMU_INTR_SET,BIT(30));
+    int error = poll(h,GEN8_GMUCX_GMU2HOST_INTR_INFO,BIT(31),BIT(31),100000);
+    if (error) return error;
+    write_reg(h,GEN8_GMUCX_GMU2HOST_INTR_CLR,BIT(31));
+    h->stage = MG_HW_OOB;
+    trace(h,"GX OOB acknowledged");
+    error = registers(h); if (error) return error;
+    h->stage = MG_HW_REGISTERS;
+    trace(h,"set SQE/AQE firmware bases");
+    write_reg(h,GEN8_CP_SQE_INSTR_BASE_LO,(uint32_t)c->sqe);
+    write_reg(h,GEN8_CP_SQE_INSTR_BASE_HI,0);
+    write_reg(h,GEN8_CP_AQE_INSTR_BASE_LO_0,(uint32_t)c->aqe);
+    write_reg(h,GEN8_CP_AQE_INSTR_BASE_HI_0,0);
+    trace(h,"build power-up restore list");
+    error = restore(h,c); if (error) return error;
+    h->stage = MG_HW_RESTORE;
+    trace(h,"submit CP_ME_INIT");
+    const uint32_t cp[] = {packet7(0x17,1),BIT(27),packet7(0x48,7),
+        0x14b,3,0x20000000,2,(uint32_t)c->restore,0,BIT(31)};
+    error = mg_scheduler_raw(s,cp,COUNT(cp)); if (error) return fail(h,error);
+    trace(h,"CP_ME_INIT acknowledged");
+    error = poll(h,GEN8_GMUAO_GPU_CX_BUSY_STATUS,BIT(23),0,200000); if (error) return error;
+    h->stage = MG_HW_CP;
+    trace(h,"CP initialization idle");
+    error = io->authenticate_zap(io->context); if (error) return fail(h,error);
+    h->stage = MG_HW_ZAP;
+    const uint32_t nonsecure[] = {packet7(0x66,1),0};
+    trace(h,"submit non-secure transition");
+    error = mg_scheduler_raw(s,nonsecure,COUNT(nonsecure)); if (error) return fail(h,error);
+    error = poll(h,GEN8_GMUAO_GPU_CX_BUSY_STATUS,BIT(23),0,200000); if (error) return error;
+    h->stage = MG_HW_NONSECURE;
+    return MG_OK;
+}
