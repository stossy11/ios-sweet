+    trace(a,"attach GPU stream0 and extend GMU mappings");
+    error = live->io.memory.allocate(live->io.memory.context,MG_PT_MAX_PAGES*4096,&a->table);
+    if (error) return poison(a,error);
+    error = mg_vm_init(&a->gpu,a->table.cpu,a->table.pa,a->table.bytes,&live->io.smmu,a,powered,idle);
+    if (!error) error = mg_vm_attach(&a->gpu,0);
+    /* SID1 (gfx3d_lpac) must reach the same bank before the SQE ever starts. */
+    if (!error) error = mg_smmu_route_lpac(&a->gpu.io,&a->gpu.domain);
+    if (!error) error = mg_vm_adopt(&a->gmu,&live->memory.tables,&live->domain,&live->io.smmu,a,powered,idle);
+    if (error) return poison(a,error);
+    a->stage = MG_ACCEL_DOMAINS;
+    trace(a,"allocate SQE/AQE/context buffers");
+    struct mg_accel_block **blocks[] = {&a->sqe,&a->aqe,&a->restore,&a->metadata,&a->context,&a->timestamps,&a->commands,&a->output};
+    const size_t sizes[] = {images->sqe_bytes-4,images->aqe_bytes-4,4096,MG_ZAP_METADATA,4096,4096,4096,4096};
+    for (unsigned i = 0; i < 8; i++) {
+        error = allocate(a,sizes[i],blocks[i]); if (error) return poison(a,error);
+        if (i < 3 || i == 5) {
+            unsigned access = MG_VM_READ | (i < 2 ? MG_VM_EXEC | MG_VM_PRIV : i == 2 ? MG_VM_WRITE | MG_VM_PRIV : MG_VM_WRITE);
+            error = map_block(a,*blocks[i],&a->gpu,access,4096,false);
