+                overlaps((uintptr_t)v->cpu,v->bytes,(uintptr_t)job->buffers[j].cpu,job->buffers[j].bytes))
+                return MG_INVALID;
+        if (!b->io.mapped(b->io.context,v->cpu,v->gpu,v->bytes,v->access)) return MG_UNBACKED;
+    }
+    for (unsigned i = 0; i < job->ib_count; i++) {
+        const struct mg_gen8_ib *ib = &job->ibs[i];
+        if (ib->buffer >= job->buffer_count || !ib->bytes || ((ib->offset | ib->bytes) & 3)) return MG_INVALID;
+        const struct mg_gen8_buffer *v = &job->buffers[ib->buffer];
+        if ((v->access & (MG_GPU_READ|MG_GPU_EXEC)) != (MG_GPU_READ|MG_GPU_EXEC) ||
