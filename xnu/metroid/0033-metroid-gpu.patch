+    uint32_t off, uint32_t val, uint32_t mask)
+{
+    uint32_t got = rd(io, s, off);
+    return got == UINT32_MAX || ((got ^ val) & mask) ? MG_IO : MG_OK;
+}
+static int set(const struct mg_smmu_io *io, struct mg_smmu_domain *s,
+    uint32_t off, uint32_t val, uint32_t mask)
+{
+    s->touched = true; io->write(io->context, off, val);
+    return check(io, s, off, val, mask);
+}
+static int sync(const struct mg_smmu_io *io, struct mg_smmu_domain *s, uint32_t asid)
+{
+    uint32_t b = s->cb_base + (s->cb << s->page_shift);
+    io->write(io->context, b + 0x610, asid);
+    io->write(io->context, b + 0x7f0, 0);
+    for (unsigned i = 0; i < 10000; i++) {
+        uint32_t v = rd(io, s, b + 0x7f4);
+        if (v == UINT32_MAX) return MG_IO;
+        if (!(v & 1)) return MG_OK;
+        io->delay(io->context, 10);
+    }
+    return MG_TIMEOUT;
+}
+
+int mg_smmu_attach_stream(const struct mg_smmu_io *io, struct mg_smmu_domain *s,
+    const struct mg_page_tables *t, uint32_t stream)
+{
