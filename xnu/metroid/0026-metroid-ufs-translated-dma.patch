+mu_crc32(const uint8_t *data, uint32_t len)
+{
+	uint32_t crc = UINT32_MAX;
+	for (uint32_t i = 0; i < len; i++) {
+		crc ^= data[i];
+		for (unsigned bit = 0; bit < 8; bit++) { crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1))); }
+	}
+	return ~crc;
+}
+
+static int
+ufs_capacity(void)
+{
+	uint8_t cdb[16] = { 0x9e, 0x10 }; /* READ CAPACITY(16) */
+	cdb[13] = 32;
+	int error = ufs_scsi(cdb, sizeof(cdb), 32, false);
+	if (error) { return error; }
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t last = mu_be64(b);
+	uint32_t block = mu_be32(b + 8);
+	if (last == UINT64_MAX || block < 512 || block > 4096 || (block & (block - 1)) ||
+	    last + 1 > UINT64_MAX / block) { return ENOTSUP; }
+	su.blocksize = block; su.total_blocks = last + 1;
+	printf("METROID UFS: LUN %u capacity=%llu blocks, blocksize=%u\n",
+	    su.lun, (unsigned long long)su.total_blocks, block);
 	return 0;
 }
 
