+/* Metroid live DT: PHY1d80000, GCC100000, dedicated reset output f1ca000.
+ * GCC/TLMM offsets and mux encodings follow Nothing gcc-tuna/pinctrl-tuna.
+ * No shared PLL is retuned and no PMIC/RPMh votes are guessed: firmware must
+ * retain the external rails and valid RCG parents. Refuse absent prerequisites
+ * before asserting reset. This is controller/PHY reinitialization, not PMIC
+ * bring-up from a completely unpowered board. */
+static int
+mu_io_poll(uintptr_t addr, uint32_t mask, uint32_t want, uint32_t timeout)
+{
+	uint64_t start = MU_NOW_US();
+	do {
+		if ((MU_READ32(addr) & mask) == want) { return 0; }
+		MU_DELAY(10);
+	} while (MU_NOW_US() - start < timeout);
+	return ETIMEDOUT;
+}
+
+static int
+mu_io_update(uintptr_t addr, uint32_t mask, uint32_t value)
+{
+	uint32_t old = MU_READ32(addr);
+	if (old == 0xffffffffu) {
+		MU_LOG("METROID UFS: MMIO inaccessible addr=%llx\n", (unsigned long long)addr);
+		return ENXIO;
+	}
+	MU_WRITE32(addr, (old & ~mask) | (value & mask)); MU_BARRIER();
+	uint32_t got = MU_READ32(addr);
+	if ((got & mask) != (value & mask)) {
+		MU_LOG("METROID UFS: MMIO update addr=%llx old=%08x mask=%08x want=%08x got=%08x\n",
+		    (unsigned long long)addr, old, mask, value & mask, got);
+		return EIO;
+	}
+	return 0;
+}
+
+/* RCG2 SRC_SEL/HID encodings, ftbl_gcc_ufs_phy_{axi,unipro}_clk_src.
+ * Preserve inherited rate/voltage; derive timers from it instead of assuming
+ * Linux's 403MHz maximum without a corresponding RPMh voltage vote. */
+static uint32_t
+mu_clock_mhz(uint32_t cfg)
+{
+	if (cfg & (3u << 12)) { return 0; } /* no fractional entries in this table */
+	uint32_t select = (cfg >> 8) & 7, div = cfg & 31;
+	if (select == 6 && div == 5) { return 100; }
+	if (select == 5 && div == 7) { return 202; } /* ceil(201.5MHz) */
+	if (select == 5 && div == 3) { return 403; }
+	return 0;
+}
+
+static int
+mu_dme_update(struct mu_host *h, uint32_t attr, uint32_t mask, uint32_t value)
+{
+	uint32_t old;
+	int error = mu_uic(h, 1, attr << 16, 0, &old);
+	if (error) { return error; }
+	return mu_uic_command(h, 2, attr << 16, (old & ~mask) | (value & mask), 0, NULL);
+}
+
+static void
+mu_phy_table(struct mu_host *h, const struct mu_phy_setting *table, unsigned count)
+{
+	for (unsigned i = 0; i < count; i++) {
+		MU_WRITE32(h->phy + table[i].off, table[i].value);
+	}
+	MU_BARRIER();
+}
+
+static int
+mu_cold_start(struct mu_host *h)
+{
+	bool pin_asserted = false, core_asserted = false, phy_asserted = false;
+	int error = ENXIO;
+	h->phase = "cold-preflight";
+	if (!h->phy || !h->gcc || !h->reset || (mu_r(h, MU_QCOM_HW_VERSION) >> 28) != 6) {
+		return ENOTSUP;
+	}
+	if (mu_r(h, 0x58) || mu_r(h, 0x78) || (mu_r(h, 0x60) & 1) || (mu_r(h, 0x80) & 1)) {
+		return EBUSY;
+	}
+	uint32_t host_power = MU_READ32(h->gcc + 0x77004);
+	uint32_t phy_power = MU_READ32(h->gcc + 0x9e000);
+	uint32_t core_mhz = mu_clock_mhz(MU_READ32(h->gcc + 0x77038));
+	uint32_t unipro_mhz = mu_clock_mhz(MU_READ32(h->gcc + 0x770a8));
+	uint32_t aux = MU_READ32(h->gcc + 0x770c4);
+	if (!(host_power & (1u << 31)) || !(phy_power & (1u << 31)) ||
+	    host_power == 0xffffffffu || phy_power == 0xffffffffu ||
+	    !core_mhz || !unipro_mhz || (aux & (7u << 8)) ||
+	    ((aux & 31) != 1 && (aux & 31) != 3)) {
+		MU_LOG("METROID UFS: cold prerequisites missing GDSC=%08x/%08x core=%u UniPro=%u aux=%08x; firmware rails/clock parents required\n",
+		    host_power, phy_power, core_mhz, unipro_mhz, aux);
+		return ENXIO;
+	}
+	unsigned gear = ((mu_r(h, 0x284c) >> 4) & 15) >= 4 ? 5 : 4;
+	MU_LOG("METROID UFS: cold reset/PHY G%u RateB core=%u UniPro=%u MHz; retaining firmware supplies\n",
+	    gear, core_mhz, unipro_mhz);
+	/* Request dedicated UFS clocks on, disabling their automatic GCC gates.
+	 * All other bits, shared PLLs and upstream rate/voltage votes are retained. */
+	const uint32_t clocks[] = { 0x77028, 0x77018, 0x770f4, 0x7706c, 0x7707c, 0x770bc };
+	h->phase = "cold-clocks";
+	for (unsigned i = 0; i < sizeof(clocks) / sizeof(clocks[0]); i++) {
+		error = mu_io_update(h->gcc + clocks[i], 3, 1);
+		if (error) { goto fail; }
+		error = mu_io_poll(h->gcc + clocks[i], 1u << 31, 0, 10000);
+		if (error) { goto fail; }
+	}
+	/* GPIO191 is the dedicated UFS_RESET pad: output bit0, no GPIO mux/OE. */
+	h->phase = "cold-device-reset";
+	pin_asserted = true;
+	error = mu_io_update(h->reset, 1, 0);
+	if (error) { goto fail; }
+	MU_DELAY(10);
+	/* Major6 requires external PHY power while BCR is held. Our preflight
+	 * already requires those domains on, and preserves their supply votes.
+	 * Linux's is_phy_pwr_on guard skips repeating the analog power helper.
+	 * Do not access PHY registers while BCR can hold that bank in reset. */
+	h->phase = "cold-core-assert";
+	core_asserted = true;
+	error = mu_io_update(h->gcc + 0x77000, 1, 1);
+	if (error) { goto fail; }
+	MU_DELAY(200);
+	h->phase = "cold-core-release";
+	error = mu_io_update(h->gcc + 0x77000, 1, 0);
+	if (error) { goto fail; }
+	core_asserted = false; MU_DELAY(1000);
+	h->phase = "cold-phy-power";
+	error = mu_io_update(h->phy + 0x13e0, 1u << 6, 0);
+	if (!error) { error = mu_io_update(h->phy + 0x1be0, 1u << 6, 0); }
+	if (!error) { error = mu_io_update(h->phy + 0x404, 1, 1); }
+	if (error) { goto fail; }
+	h->phase = "cold-ref-clock";
+	error = mu_io_update(h->regs + MU_QCOM_CFG1, MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK,
+	    MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK);
+	if (error) { goto fail; }
+	MU_DELAY(60);
+	h->phase = "cold-device-release";
+	error = mu_io_update(h->reset, 1, 1);
+	if (error) { goto fail; }
+	pin_asserted = false; MU_DELAY(10);
+	h->phase = "cold-hce-disable";
+	mu_w(h, 0x34, 0);
+	error = mu_poll(h, false, 0x34, 1, 0, 10000);
+	if (error) { goto fail; }
+	/* Route symbol clocks to XO while the PHY PLL is reset. */
+	const uint32_t lanes[] = { 0x77030, 0x770d8, 0x7702c };
+	const uint32_t muxes[] = { 0x77068, 0x770ec, 0x77058 };
+	h->phase = "cold-phy-calibrate";
+	for (unsigned i = 0; i < 3; i++) {
+		error = mu_io_update(h->gcc + lanes[i], 1, 0);
+		if (!error) { error = mu_io_update(h->gcc + muxes[i], 3, 2); }
+		if (error) { goto fail; }
+	}
+	phy_asserted = true;
+	error = mu_io_update(h->regs + MU_QCOM_CFG1, 2, 2);
+	if (error) { goto fail; }
+	MU_DELAY(1000);
+	error = mu_io_update(h->phy + 0x408, 1, 1);
+	if (error) { goto fail; }
+	mu_phy_table(h, mu_phy_rate_A_g5, sizeof(mu_phy_rate_A_g5) / sizeof(mu_phy_rate_A_g5[0]));
+	if (gear == 4) {
+		mu_phy_table(h, mu_phy_rate_A_g4, sizeof(mu_phy_rate_A_g4) / sizeof(mu_phy_rate_A_g4[0]));
+	}
+	mu_phy_table(h, mu_phy_2nd_lane, sizeof(mu_phy_2nd_lane) / sizeof(mu_phy_2nd_lane[0]));
+	mu_phy_table(h, mu_phy_rate_B, sizeof(mu_phy_rate_B) / sizeof(mu_phy_rate_B[0]));
+	error = mu_io_update(h->phy + 0x408, 1, 0);
+	if (!error) { error = mu_io_update(h->regs + MU_QCOM_CFG1, 2, 0); }
+	if (error) { goto fail; }
+	phy_asserted = false; MU_DELAY(1000);
+	error = mu_io_update(h->phy + 0x400, 1, 1);
+	if (error) { goto fail; }
+	h->phase = "cold-pcs-ready";
+	error = mu_io_poll(h->phy + 0x5a8, 1, 1, 1000000);
+	if (error) { goto fail; }
+	for (unsigned i = 0; i < 3; i++) {
+		error = mu_io_update(h->gcc + muxes[i], 3, 0);
+		if (!error) { error = mu_io_update(h->gcc + lanes[i], 1, 1); }
+		if (error) { goto fail; }
+		MU_DELAY(10); /* lane branches use BRANCH_HALT_DELAY in gcc-tuna */
+	}
+	/* Qunipro selection, modern CFG0, non-SCSI ICE-check bypass/ref clock. */
+	error = mu_io_update(h->regs + MU_QCOM_CFG1, 1 | MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK,
+	    1 | MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK);
+	if (!error) { error = mu_io_update(h->regs + 0xd8, (1u << 5) | 1, 0); }
+	if (error) { goto fail; }
+	MU_DELAY(60);
+	h->phase = "cold-hce-enable";
+	mu_w(h, 0x34, 1); MU_DELAY(1000);
+	error = mu_poll(h, false, 0x34, 1, 1, 50000);
+	if (error) { goto fail; }
+	uint64_t start = MU_NOW_US();
+	do {
+		error = mu_uic(h, 1, MU_TX_FSM_ATTRIBUTE, 0, &h->tx_fsm);
+		if (error || h->tx_fsm == MU_TX_FSM_HIBERN8) { break; }
+		MU_DELAY(100);
+	} while (MU_NOW_US() - start < 100000);
+	if (error) { goto fail; }
+	if (h->tx_fsm != MU_TX_FSM_HIBERN8) { error = ETIMEDOUT; goto fail; }
+	h->phase = "cold-link-config";
+	mu_w(h, 0xc0, core_mhz);
+	if (mu_r(h, 0xc0) != core_mhz) { error = EIO; goto fail; }
+	error = mu_dme_update(h, 0xd002, (0xfffu << 16) | (1u << 8), unipro_mhz << 16);
+	if (!error) { error = mu_dme_update(h, 0x9007, 0x3f, unipro_mhz == 403 ? 16 : unipro_mhz == 202 ? 8 : 4); }
+	if (!error) { error = mu_dme_update(h, 0xa00b, 0x3ff, 0x3ff); }
+	if (!error) { error = mu_dme_update(h, 0x9004, 0x1ff, 0x1ff); }
+	if (!error) { error = mu_dme_update(h, 0xd002, 1u << 9, 1u << 9); }
+	if (!error) { error = mu_io_update(h->regs + 0xe0, 0xff, 0xff); }
+	if (!error) { error = mu_io_update(h->phy + 0x57c, 2, 0); }
+	/* Like ufshcd_get_local_unipro_ver(), this modern HCI is >= UniPro1.6. */
+	if (!error) { error = mu_dme_update(h, 0x155e, 1, 0); }
+	if (error) { goto fail; }
+	/* Linux repeats startup when device-active state is unknown. */
+	h->phase = "cold-link-startup";
+	for (unsigned i = 0; i < 2; i++) {
+		error = mu_uic(h, 0x16, 0, 0, NULL);
+		if (error) { goto fail; }
+		if (!(mu_r(h, 0x30) & 1)) { error = ENXIO; goto fail; }
+	}
+	uint32_t connected = 0;
+	error = mu_uic(h, 1, 0x1561u << 16, 0, &connected);
+	if (error) { goto fail; }
+	if (!connected || connected > 2) { error = EIO; goto fail; }
+	(void)mu_r(h, 0x38); /* consume PHY adapter error after line reset */
+	mu_w(h, 0x18, 0); mu_w(h, 0x24, 0);
+	MU_LOG("METROID UFS: cold reset/PHY ready; PCS=%08x HCS=%08x TX lanes=%u\n",
+	    MU_READ32(h->phy + 0x5a8), mu_r(h, 0x30), connected);
+	return 0;
+fail:
+	MU_LOG("METROID UFS: %s failed errno=%d PCS=%08x HCE=%08x HCS=%08x\n",
+	    h->phase, error, MU_READ32(h->phy + 0x5a8), mu_r(h, 0x34), mu_r(h, 0x30));
+	/* Best effort deassertion: do not intentionally leave the phone in reset.
+	 * No queue is started and no command retried after partial reset failure. */
+	if (phy_asserted) {
+		(void)mu_io_update(h->phy + 0x408, 1, 0);
+		(void)mu_io_update(h->regs + MU_QCOM_CFG1, 2, 0);
+	}
+	if (core_asserted) { (void)mu_io_update(h->gcc + 0x77000, 1, 0); }
+	if (pin_asserted) { (void)mu_io_update(h->reset, 1, 1); }
+	return error;
+}
+
+static int
+mu_wake_link(struct mu_host *h)
+{
+	h->phase = "link-wake";
+	uint32_t revision = mu_r(h, MU_QCOM_HW_VERSION), major = revision >> 28;
+	if (major < 2 || major == 0xf) {
+		MU_LOG("METROID UFS: unsupported Qualcomm controller revision=%08x\n", revision);
+		return ENOTSUP;
+	}
+	/* ufs_qcom_populate_ref_clk_ctrl/dev_ref_clk_ctrl + link_startup_notify.
+	 * RMW preserves PHY/reset/UniPro controls. Clock must settle before H8 exit.
+	 * Bit31 bypasses ICE configuration checks even for NOP/query requests. */
+	uint32_t cfg = mu_r(h, MU_QCOM_CFG1);
+	mu_w(h, MU_QCOM_CFG1, cfg | MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK);
+	uint32_t got = mu_r(h, MU_QCOM_CFG1);
+	if ((got & (MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK)) !=
+	    (MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK)) {
+		MU_LOG("METROID UFS: CFG1 wake/ICE setup blocked old=%08x got=%08x\n", cfg, got);
+		return EPERM;
+	}
+	MU_DELAY(60);
+	int error;
+	if (!(mu_r(h, 0x30) & 1)) {
+		error = mu_uic(h, 0x16, 0, 0, NULL); /* DME_LINK_STARTUP */
+		if (error) { return error; }
+	}
+	if (mu_poll(h, false, 0x30, 0xf, 0xf, 1000000)) { return ENXIO; }
+	error = mu_uic(h, 1, MU_TX_FSM_ATTRIBUTE, 0, &h->tx_fsm);
+	if (error) { return error; }
+	MU_LOG("METROID UFS: inherited TX_FSM=%x CFG1=%08x\n", h->tx_fsm, got);
+	if (h->tx_fsm == MU_TX_FSM_HIBERN8) {
+		MU_LOG("METROID UFS: exiting inherited Hibern8\n");
+		error = mu_uic(h, 0x18, 0, MU_HIBERN8_EXIT_DONE, NULL);
+		if (error) { return error; }
+		uint64_t start = MU_NOW_US();
+		do {
+			error = mu_uic(h, 1, MU_TX_FSM_ATTRIBUTE, 0, &h->tx_fsm);
+			if (error) { return error; }
+			if (h->tx_fsm != MU_TX_FSM_HIBERN8) { break; }
+			MU_DELAY(100);
+		} while (MU_NOW_US() - start < 100000);
+		if (h->tx_fsm == MU_TX_FSM_HIBERN8) { return ETIMEDOUT; }
+	}
+	if (!h->tx_fsm) {
+		MU_LOG("METROID UFS: TX disabled; cold PHY/clock bring-up required\n");
+		return ENXIO;
+	}
+	MU_LOG("METROID UFS: link awake TX_FSM=%x\n", h->tx_fsm);
+	return 0;
+}
+
+static int
+mu_start_host(struct mu_host *h)
+{
+	if (!h->mapped || h->failed) { return EIO; }
+	/* PHY/lane clocks must remain powered, but a sleeping link is recoverable. */
+	int error = h->cold_init ? mu_cold_start(h) : mu_wake_link(h);
+	if (error) { h->failed = true; return error; }
+	h->phase = "list-start";
+	mu_w(h, 0x4c, 0); /* interrupt aggregation */
+	mu_w(h, 0x20, mu_r(h, 0x20));
+	mu_w(h, 0x50, (uint32_t)MU_IOVA); mu_w(h, 0x54, 0);
+	mu_w(h, 0x70, (uint32_t)(MU_IOVA + MU_TASK)); mu_w(h, 0x74, 0);
+	MU_FLUSH((uintptr_t)h->pool, MU_POOL_SIZE);
+	MU_BARRIER();
+	if (mu_r(h, 0x50) != MU_IOVA || mu_r(h, 0x54) ||
+	    mu_r(h, 0x70) != MU_IOVA + MU_TASK || mu_r(h, 0x74)) { return EIO; }
+	mu_w(h, 0x80, 1); mu_w(h, 0x60, 1);
+	return mu_poll(h, false, 0x60, 1, 1, 10000);
+}
+
+/* No timeout retries: a late DMA must never land in a reused command buffer. */
+static int
+mu_submit(struct mu_host *h, uint32_t len, bool write, uint8_t response_type)
+{
+	if (!h->mapped || h->failed || mu_r(h, 0x58) || !(mu_r(h, 0x60) & 1)) { return EIO; }
+	struct mu_utrd *d = (struct mu_utrd *)h->pool;
+	struct mu_ucd *c = (struct mu_ucd *)(h->pool + MU_UCD);
+	/* Detect a lost/changed stream or list base before publishing a request. */
+	if (mu_sr(h, 0x800 + 4 * h->smr) != ((1u << 31) | MU_SID) ||
+	    (mu_sr(h, 0xc00 + 4 * h->smr) & ((3u << 16) | 0xff)) != h->cb ||
+	    !(mu_sr(h, mu_cb(h, h->cb)) & 1) ||
+	    mu_r(h, 0x50) != MU_IOVA || mu_r(h, 0x54)) {
+		h->failed = true; mu_dump(h, "dma-route-changed"); return EIO;
+	}
+	d->header = (1u << 28) | (1u << 24) | (len ? (write ? 1u : 2u) << 25 : 0);
+	d->ocs = 0xf;
+	d->ucd_lo = (uint32_t)(MU_IOVA + MU_UCD); d->ucd_hi = 0;
+	d->response_len = 512 / 4; d->response_offset = 512 / 4;
+	d->prdt_len = (uint16_t)((len + 0x3ffff) / 0x40000); d->prdt_offset = 1024 / 4;
+	for (uint32_t i = 0, done = 0; i < d->prdt_len; i++) {
+		uint32_t chunk = len - done > 0x40000 ? 0x40000 : len - done;
+		c->prdt[i].lo = (uint32_t)(MU_IOVA + MU_DATA + done);
+		c->prdt[i].hi = 0; c->prdt[i].bytes = chunk - 1;
+		done += chunk;
+	}
+	/* Transfer cache ownership, including previously cached response/OCS
+	 * lines, before doorbell. CPU never writes these while DMA owns them. */
+	MU_FLUSH((uintptr_t)h->pool, MU_DATA);
+	if (len) { MU_FLUSH((uintptr_t)h->pool + MU_DATA, len); }
+	MU_BARRIER();
+	mu_w(h, 0x58, 1);
+	/* Device power transitions have Linux's separate ten-second deadline. */
+	uint32_t timeout = response_type == 0x21 && c->request[2] == MU_DEVICE_WLUN &&
+	    c->request[16] == 0x1b ? MU_DEVICE_ACTIVE_TIMEOUT_US : MU_TIMEOUT_US;
+	uint64_t start = MU_NOW_US();
+	while (mu_r(h, 0x58) & 1) {
+		uint32_t is = mu_r(h, 0x20);
+		uint32_t fault = mu_sr(h, mu_cb(h, h->cb) + 0x58) & MU_SMMU_FSR_FAULT;
+		if ((is & MU_FATAL_IS) || fault || MU_NOW_US() - start >= timeout) {
+			h->failed = true;
+			mu_dump(h, "timeout/fault");
+			return ((is & MU_FATAL_IS) || fault) ? EIO : ETIMEDOUT;
+		}
+		MU_DELAY(10);
+	}
+	MU_BARRIER();
+	MU_FLUSH((uintptr_t)h->pool, MU_DATA);
+	if (len && !write) { MU_FLUSH((uintptr_t)h->pool + MU_DATA, len); }
+	if ((mu_r(h, 0x20) & MU_FATAL_IS) ||
+	    (mu_sr(h, mu_cb(h, h->cb) + 0x58) & MU_SMMU_FSR_FAULT)) {
+		h->failed = true; mu_dump(h, "completion-fault"); return EIO;
+	}
+	mu_w(h, 0x20, 1); /* acknowledge transfer completion only */
+	if ((d->ocs & 0xff) || c->response[0] != response_type ||
+	    c->response[2] != c->request[2] || c->response[3] != c->request[3]) {
+		MU_LOG("METROID UFS: malformed completion OCS=%x response=%x tag=%x/%x\n",
+		    d->ocs, c->response[0], c->response[3], c->request[3]);
+		h->failed = true; return EIO;
+	}
+	return 0;
+}
+
+static int
+mu_prepare(struct mu_host *h, uint8_t type, uint8_t lun)
+{
+	if (!h->mapped || h->failed) { return EIO; }
+	if (mu_r(h, 0x58)) { h->failed = true; return EBUSY; }
+	memset(h->pool, 0, sizeof(struct mu_utrd));
+	struct mu_ucd *c = (struct mu_ucd *)(h->pool + MU_UCD);
+	memset(c, 0, sizeof(*c));
+	c->request[0] = type; c->request[2] = lun; c->request[3] = 0; /* slot 0 */
+	return 0;
+}
+
+static int
+mu_scsi(struct mu_host *h, uint8_t lun, const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	if (h->failed) { return EIO; }
+	h->phase = lun == MU_DEVICE_WLUN && cdb_len && cdb[0] == 0x1b ? "device-active" : "scsi";
+	if (cdb_len > 16 || !cdb_len || len > MU_BOUNCE) { return EINVAL; }
+	int error = mu_prepare(h, 1, lun);
+	if (error) { return error; }
+	struct mu_ucd *c = (struct mu_ucd *)(h->pool + MU_UCD);
+	c->request[1] = len ? (write ? 0x20 : 0x40) : 0;
+	c->request[12] = (uint8_t)(len >> 24); c->request[13] = (uint8_t)(len >> 16);
+	c->request[14] = (uint8_t)(len >> 8); c->request[15] = (uint8_t)len;
+	memcpy(c->request + 16, cdb, cdb_len);
+	error = mu_submit(h, len, write, 0x21);
+	if (error) { return error; }
+	if (c->response[6] || c->response[7]) {
+		const uint8_t *sense = c->response + 34;
+		uint32_t sense_len = (uint32_t)c->response[32] << 8 | c->response[33];
+		uint32_t data_len = (uint32_t)c->response[10] << 8 | c->response[11];
+		uint8_t key = 0xff, asc = 0, ascq = 0;
+		if (sense_len >= 14 && sense_len <= 18 && data_len >= sense_len + 2 &&
+		    ((sense[0] & 0x7f) == 0x70 || (sense[0] & 0x7f) == 0x71)) {
+			key = sense[2] & 0xf; asc = sense[12]; ascq = sense[13];
+		} else if (sense_len >= 4 && sense_len <= 18 && data_len >= sense_len + 2 &&
+		    ((sense[0] & 0x7f) == 0x72 || (sense[0] & 0x7f) == 0x73)) {
+			key = sense[1] & 0xf; asc = sense[2]; ascq = sense[3];
+		}
+		MU_LOG("METROID UFS: SCSI cmd=%02x LUN=%02x response=%02x status=%02x sense=%02x/%02x/%02x\n",
+		    cdb[0], lun, c->response[6], c->response[7], key, asc, ascq);
+		/* UNIT ATTENTION / NOT READY may be retried only after completion. */
+		return !c->response[6] && c->response[7] == 2 && (key == 6 || key == 2) ? EAGAIN : EIO;
+	}
+	/* Refuse short/overflowed reads; stale bounce bytes must not reach BSD. */
+	if (c->response[1] & 0x60) { return EIO; }
+	return 0;
+}
+
+/* Link active and device active are separate states. Nothing's resume path
+ * exits Hibern8 then sends START STOP UNIT / ACTIVE to the UFS Device WLUN.
+ * We cannot trust inherited software power state, so request ACTIVE explicitly.
+ * This has no data payload and does not address an ordinary storage LUN. */
+static int
+mu_activate_device(struct mu_host *h)
+{
+	const uint8_t active[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+	for (unsigned attempt = 1; attempt <= 3; attempt++) {
+		int error = mu_scsi(h, MU_DEVICE_WLUN, active, sizeof(active), 0, false);
+		MU_LOG("METROID UFS: device ACTIVE LUN=d0 attempt=%u/3 errno=%d transport_failed=%u\n",
+		    attempt, error, (unsigned)h->failed);
+		if (!error || h->failed) { return error; }
+		/* Retry only a completed sense response indicating UA/NOT READY.
+		 * Unknown/permanent rejections are not improved by repetition. */
+		if (error != EAGAIN || attempt == 3) { return error; }
+		MU_DELAY(10000);
+	}
+	return EIO;
+}
+
+static uint32_t
+mu_upiu_word(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static void
+mu_query_dump(const char *which, const uint8_t *p)
+{
+	MU_LOG("METROID UFS: query-%s %08x %08x %08x %08x %08x %08x %08x %08x\n",
+	    which, mu_upiu_word(p), mu_upiu_word(p + 4), mu_upiu_word(p + 8), mu_upiu_word(p + 12),
+	    mu_upiu_word(p + 16), mu_upiu_word(p + 20), mu_upiu_word(p + 24), mu_upiu_word(p + 28));
+}
+
+static int
+mu_query_flag(struct mu_host *h, bool set, uint8_t *value)
+{
+	if (h->failed) { return EIO; }
+	h->phase = set ? "fDeviceInit-set" : "fDeviceInit-read";
+	for (unsigned attempt = 1; attempt <= MU_QUERY_ATTEMPTS; attempt++) {
+		int error = mu_prepare(h, 0x16, 0);
+		if (error) { return error; }
+		struct mu_ucd *c = (struct mu_ucd *)(h->pool + MU_UCD);
+		c->request[5] = set ? 0x81 : 0x01; /* standard write/read query */
+		c->request[12] = set ? 6 : 5; /* SET_FLAG / READ_FLAG */
+		c->request[13] = 1; /* fDeviceInit, index=selector=0 */
+		error = mu_submit(h, 0, false, 0x36);
+		/* Only validated completion releases this slot. No transport error,
+		 * timeout, fault, OCS failure or malformed header may be retried. */
+		if (error) { return error; }
+		uint8_t result = c->response[6];
+		if (!result && !c->response[7] && !c->response[10] && !c->response[11] &&
+		    !memcmp(c->response + 12, c->request + 12, 4)) {
+			*value = c->response[23] & 1;
+			return 0;
+		}
+		MU_LOG("METROID UFS: %s attempt=%u/%u result=%02x status=%02x opcode=%02x IDN=%02x index=%02x selector=%02x\n",
+		    h->phase, attempt, MU_QUERY_ATTEMPTS, result, c->response[7],
+		    c->response[12], c->response[13], c->response[14], c->response[15]);
+		mu_query_dump("req", c->request);
+		mu_query_dump("rsp", c->response);
+		/* QUERY_RESULT_GENERAL_FAILURE may be transient. Match Linux's
+		 * three-attempt bound, but never turn a rejected query into success.
+		 * Failed queries need not echo the OSF, so inspect it only on success.
+		 * Explicit invalid/not-writable results and malformed success stop. */
+		if (result != 0xff || c->response[7] || attempt == MU_QUERY_ATTEMPTS) { return EIO; }
+		MU_DELAY(1000);
+	}
+	return EIO;
+}
+
+/* Read-only readiness probe, also usable before management queries for
+ * diagnostics. Its success alone must not authorize firmware takeover. */
+static int
+mu_probe_scsi_ready(struct mu_host *h)
+{
+	if (h->probe_first > h->probe_last || h->probe_last > 7) { return EINVAL; }
+	const uint8_t tur[6] = { 0 };
+	uint8_t capacity[16] = { 0x9e, 0x10 };
+	capacity[13] = 32;
+	for (unsigned lun = h->probe_first; lun <= h->probe_last; lun++) {
+		int error = EIO;
+		for (unsigned attempt = 0; attempt < 3; attempt++) {
+			error = mu_scsi(h, (uint8_t)lun, tur, sizeof(tur), 0, false);
+			MU_LOG("METROID UFS: SCSI probe LUN=%u TUR attempt=%u errno=%d\n", lun, attempt + 1, error);
+			if (!error) {
+				error = mu_scsi(h, (uint8_t)lun, capacity, sizeof(capacity), 32, false);
+				MU_LOG("METROID UFS: SCSI probe LUN=%u READ CAPACITY errno=%d\n", lun, error);
+			}
+			if (error != EAGAIN) { break; }
+			if (attempt < 2) { MU_DELAY(10000); }
+		}
+		if (h->failed) { return error; }
+		if (error) { continue; }
+		const uint8_t *data = h->pool + MU_DATA;
+		uint64_t last = (uint64_t)mu_upiu_word(data) << 32 | mu_upiu_word(data + 4);
+		uint32_t block = mu_upiu_word(data + 8);
+		if (last == ~(uint64_t)0 || block < 512 || block > 4096 ||
+		    (block & (block - 1)) || last + 1 > (~(uint64_t)0) / block) {
+			MU_LOG("METROID UFS: SCSI probe LUN=%u invalid capacity last=%08x%08x block=%u\n",
+			    lun, (uint32_t)(last >> 32), (uint32_t)last, block);
+			continue;
+		}
+		MU_LOG("METROID UFS: SCSI readiness verified LUN=%u block=%u\n", lun, block);
+		return 0;
+	}
+	return ENOENT;
+}
+
+static int
+mu_wait_device_init(struct mu_host *h, uint8_t *flag)
+{
+	uint64_t start = MU_NOW_US();
+	do {
+		int error = mu_query_flag(h, false, flag);
+		if (error || !*flag) { return error; }
+		MU_DELAY(1000);
+	} while (MU_NOW_US() - start < MU_TIMEOUT_US);
+	return ETIMEDOUT;
+}
+
+static int
+mu_device_init(struct mu_host *h)
+{
+	if (h->failed) { return EIO; }
+	h->inherited_ready = false;
+	h->phase = "nop";
+	int error = mu_prepare(h, 0, 0); /* NOP OUT */
+	if (error) { return error; }
+	error = mu_submit(h, 0, false, 0x20);
+	if (error) { return error; }
+	if (h->cold_init) {
+		/* Match Nothing's fresh initialization: NOP, SET, then READ/poll.
+		 * Inherited-state READ/probes are only for the resume/takeover path. */
+		uint8_t flag = 1;
+		error = mu_query_flag(h, true, &flag);
+		if (!error) { error = mu_wait_device_init(h, &flag); }
+		return error ? error : mu_activate_device(h);
+	}
+	/* Hibern8 exit only woke the link. Restore the device power mode before
+	 * attempting ordinary-LUN commands or querying inherited initialization.
+	 * A completed rejection can mean cold initialization is still needed;
+	 * retain the normal query/init path in that case. Transport errors stop. */
+	int wake_error = mu_activate_device(h);
+	if (h->failed) { return wake_error; }
+	/* Probe before READ_FLAG so a rejected management query cannot hide
+	 * whether ordinary read-only SCSI commands work. Never bypass the
+	 * query on success, or submit anything after a transport failure. */
+	MU_LOG("METROID UFS: pre-query SCSI probe begin\n");
+	int readiness = mu_probe_scsi_ready(h);
+	MU_LOG("METROID UFS: pre-query SCSI probe errno=%d transport_failed=%u\n",
+	    readiness, (unsigned)h->failed);
+	if (h->failed || (readiness && readiness != ENOENT)) { return readiness; }
+	uint8_t flag = 1;
+	error = mu_query_flag(h, false, &flag);
+	if (error) { return error; }
+	/* Finish an inherited in-progress initialization before probing. */
+	if (flag) {
+		error = mu_wait_device_init(h, &flag);
+		if (error) { return error; }
+		/* Initialization changed state; refresh the earlier evidence. */
+		readiness = mu_probe_scsi_ready(h);
+	}
+	if (!readiness) {
+		h->inherited_ready = true;
+		return 0;
+	}
+	if (readiness != ENOENT || h->failed) { return readiness; }
+	/* No proven usable LUN: use the ordinary SET/poll sequence. A rejected
+	 * SET remains an error; it must never be treated as readiness. */
+	error = mu_query_flag(h, true, &flag);
+	if (error) { return error; }
+	error = mu_wait_device_init(h, &flag);
+	if (error) { return error; }
+	/* A cold device may have rejected the early power command. Retry it
+	 * after successful initialization, before ordinary disk discovery. */
+	return wake_error ? mu_activate_device(h) : 0;
+}
+#endif
