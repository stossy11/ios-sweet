-/*
- * Read one SMMU register.  With sweetsmmu bit 3 the offset is printed first:
- * a bus error on a register that is not accessible from here is fatal in the
- * kernel, and the last offset printed is then the one that killed the boot.
- * The console may be buffered, so the last line on screen can lag behind.
- */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	int error = mu_scsi(&su.host, su.lun, cdb, cdb_len, len, write);
+	su.io_failed = su.host.failed;
+	return error;
+}
+
+static int
+ufs_rw_blocks(uint64_t lba, uint32_t count, bool write)
+{
+	if (!count || count > BOUNCE_SIZE / su.blocksize || lba >= su.total_blocks ||
+	    count > su.total_blocks - lba) { return EINVAL; }
+	if (write && (!su.writable || lba < su.first_block ||
+	    lba - su.first_block >= su.nblocks || count > su.nblocks - (lba - su.first_block))) { return EROFS; }
+	/* READ/WRITE(16): no artificial 32-bit LBA ceiling. */
+	uint8_t cdb[16] = { 0 };
+	cdb[0] = write ? 0x8a : 0x88;
+	for (unsigned i = 0; i < 8; i++) { cdb[2 + i] = (uint8_t)(lba >> (56 - i * 8)); }
+	for (unsigned i = 0; i < 4; i++) { cdb[10 + i] = (uint8_t)(count >> (24 - i * 8)); }
+	return ufs_scsi(cdb, sizeof(cdb), count * su.blocksize, write);
+}
+static int ufs_read_blocks(uint64_t lba, uint32_t count) { return ufs_rw_blocks(lba, count, false); }
+static int ufs_write_blocks(uint64_t lba, uint32_t count) { return ufs_rw_blocks(lba, count, true); }
+static int ufs_sync_cache(void) { const uint8_t cdb[16] = { 0x91 }; return ufs_scsi(cdb, sizeof(cdb), 0, false); }
+
+static uint32_t mu_be32(const uint8_t *p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+static uint64_t mu_be64(const uint8_t *p) { return (uint64_t)mu_be32(p) << 32 | mu_be32(p + 4); }
+static uint32_t mu_le32(const uint8_t *p) { return (uint32_t)p[3] << 24 | (uint32_t)p[2] << 16 | (uint32_t)p[1] << 8 | p[0]; }
+static uint64_t mu_le64(const uint8_t *p) { return (uint64_t)mu_le32(p + 4) << 32 | mu_le32(p); }
