new file mode 100644
--- /dev/null
+++ b/bsd/dev/metroid_ufs_hw.h
@@ -0,0 +1,1149 @@
+/*
+ * Metroid UFSHCI + SMMUv2 transport. Independently implemented from the
+ * register formats and sequences documented by Nothing's SM8735 Linux tree
+ * (031e8669), not a port of Linux's DMA API or global SMMU driver.
+ *
+ * The caller owns serialization and permanent, physically contiguous memory.
+ * CPU addresses, physical addresses and device IOVAs are deliberately distinct.
+ * MU_* hooks make the actual transport testable with a host MMIO model.
+ */
+#ifndef METROID_UFS_HW_H
+#define METROID_UFS_HW_H
+#define MU_POOL_SIZE 0x104000u
+#define MU_DATA      0x4000u
+#define MU_UCD       0x1000u
+#define MU_TASK      0x0800u
+#define MU_BOUNCE    0x100000u
+#define MU_TABLE_SIZE 0x3000u
+#define MU_IOVA      0x40000000ull
+#define MU_SID       0x60u
+#define MU_ADDR_MASK 0x0000fffffffff000ull
+#define MU_TIMEOUT_US 5000000u
+#define MU_DEVICE_WLUN 0xd0u
+#define MU_DEVICE_ACTIVE_TIMEOUT_US 10000000u /* Nothing START STOP: 10 * HZ */
+#define MU_QUERY_ATTEMPTS 3u /* Nothing ufshcd.c QUERY_REQ_RETRIES */
+#define MU_UIC_DONE (1u << 10)
+#define MU_HIBERN8_EXIT_DONE (1u << 5)
+#define MU_TX_FSM_ATTRIBUTE (0x41u << 16) /* QCOM MPHY_TX_FSM_STATE, lane 0 */
+#define MU_TX_FSM_HIBERN8 1u
+#define MU_QCOM_CFG1 0xdcu
+#define MU_QCOM_HW_VERSION 0xe4u
+#define MU_QCOM_REF_CLK (1u << 26)
+#define MU_QCOM_NO_ICE_CHECK (1u << 31)
+/* Nothing arm-smmu.h ARM_SMMU_FSR_FAULT: MULTI, SS and bits 8:1.
+ * Bit 10 (0x400) is not a recognized context fault. Do not infer a valid
+ * fault address from FAR unless an actual fault bit is set.
+ */
+#define MU_SMMU_FSR_FAULT 0xc00001feu
+#define MU_FATAL_IS ((1u << 2) | (1u << 7) | (1u << 11) | (1u << 16) | (1u << 17) | (1u << 18))
+
+struct mu_utrd {
+	uint32_t header, reserved, ocs, reserved2;
+	uint32_t ucd_lo, ucd_hi;
+	uint16_t response_len, response_offset, prdt_len, prdt_offset;
+};
+struct mu_ucd {
+	uint8_t request[512], response[512];
+	struct { uint32_t lo, hi, reserved, bytes; } prdt[4];
+};
+_Static_assert(sizeof(struct mu_utrd) == 32, "UFSHCI UTRD size");
+_Static_assert(offsetof(struct mu_ucd, response) == 512, "response offset");
+_Static_assert(offsetof(struct mu_ucd, prdt) == 1024, "PRDT offset");
+
+struct mu_host {
+	uintptr_t regs, smmu, phy, gcc, reset;
+	uint8_t *pool;
+	uint64_t pool_pa, tables_pa;
+	uint64_t *tables;
+	uint32_t pgshift, cb_base, gr1, ncb, ns2cb, nsmr, cb, smr, asid, ips;
+	uint32_t old_smr, old_s2cr;
+	uint32_t tx_fsm;
+	const char *phase;
+	uint8_t probe_first, probe_last;
+	bool mapped, failed, configured, inherited_ready, cold_init;
+};
+
+static uint32_t mu_r(struct mu_host *h, uint32_t off) { return MU_READ32(h->regs + off); }
+static void mu_w(struct mu_host *h, uint32_t off, uint32_t v) { MU_WRITE32(h->regs + off, v); MU_BARRIER(); }
+static uint32_t mu_sr(struct mu_host *h, uint32_t off) { return MU_READ32(h->smmu + off); }
+static void mu_sw(struct mu_host *h, uint32_t off, uint32_t v) { MU_WRITE32(h->smmu + off, v); MU_BARRIER(); }
+static uint32_t mu_cb(struct mu_host *h, uint32_t cb) { return h->cb_base + (cb << h->pgshift); }
+static uint64_t mu_sr64(struct mu_host *h, uint32_t off) { return (uint64_t)mu_sr(h, off) | (uint64_t)mu_sr(h, off + 4) << 32; }
+/* Aligned 64-bit device accesses, as used for AArch64 TTBRs in Linux. */
+static void mu_sw64(struct mu_host *h, uint32_t off, uint64_t v) { MU_WRITE64(h->smmu + off, v); MU_BARRIER(); }
+
+static int
+mu_poll(struct mu_host *h, bool smmu, uint32_t off, uint32_t mask,
+    uint32_t want, uint32_t timeout)
+{
+	uint64_t start = MU_NOW_US();
+	do {
+		uint32_t v = smmu ? mu_sr(h, off) : mu_r(h, off);
+		if ((v & mask) == want) { return 0; }
+		MU_DELAY(10);
+	} while (MU_NOW_US() - start < timeout);
+	return ETIMEDOUT;
+}
+
+static void
+mu_dump(struct mu_host *h, const char *stage)
+{
+	MU_LOG("METROID UFS[%s]: IS=%08x HCS=%08x HCE=%08x DBR=%08x RSR=%08x MEMCFG=%08x UTRL=%08x:%08x\n",
+	    stage, mu_r(h, 0x20), mu_r(h, 0x30), mu_r(h, 0x34), mu_r(h, 0x58),
+	    mu_r(h, 0x60), mu_r(h, 0x300), mu_r(h, 0x54), mu_r(h, 0x50));
+	MU_LOG("METROID UFS[%s]: phase=%s AHIT=%08x QCOM_VER=%08x CFG1=%08x TX_FSM=%x\n",
+	    stage, h->phase ? h->phase : "idle", mu_r(h, 0x18),
+	    mu_r(h, MU_QCOM_HW_VERSION), mu_r(h, MU_QCOM_CFG1), h->tx_fsm);
+	if (h->mapped && h->pool) {
+		/* Descriptors were cleaned before submission; no CPU writes occur
+		 * while DMA owns them. Refresh cache lines for diagnostic reads only.
+		 * OCS=invalid with DBR=1 alone does not prove the request was unfetched.
+		 */
+		MU_FLUSH((uintptr_t)h->pool, sizeof(struct mu_utrd));
+		MU_FLUSH((uintptr_t)h->pool + MU_UCD + offsetof(struct mu_ucd, response), 32);
+		MU_BARRIER();
+		const volatile struct mu_utrd *d = (const volatile struct mu_utrd *)h->pool;
+		const volatile struct mu_ucd *c = (const volatile struct mu_ucd *)(h->pool + MU_UCD);
+		MU_LOG("METROID UFS[%s]: request=%02x cdb=%02x tag=%02x UTRD_OCS=%08x header=%08x UCD=%08x:%08x\n",
+		    stage, c->request[0], c->request[16], c->request[3], d->ocs, d->header, d->ucd_hi, d->ucd_lo);
+		MU_LOG("METROID UFS[%s]: response=%02x flags=%02x lun=%02x tag=%02x result=%02x status=%02x resp_off=%u resp_len=%u prdt_len=%u\n",
+		    stage, c->response[0], c->response[1], c->response[2], c->response[3], c->response[6], c->response[7],
+		    d->response_offset, d->response_len, d->prdt_len);
+	}
+	MU_LOG("METROID SMMU[%s]: sCR0=%08x sACR=%08x GFSR=%08x GFSYNR1=%08x\n",
+	    stage, mu_sr(h, 0), mu_sr(h, 0x10), mu_sr(h, 0x48), mu_sr(h, 0x54));
+	MU_LOG("METROID UFS[%s]: UECPA=%08x UECDL=%08x UECN=%08x UECT=%08x UECDME=%08x\n",
+	    stage, mu_r(h, 0x38), mu_r(h, 0x3c), mu_r(h, 0x40), mu_r(h, 0x44), mu_r(h, 0x48));
+	if (h->configured) {
+		uint32_t b = mu_cb(h, h->cb);
+		MU_LOG("METROID SMMU[%s]: SID=60 SMR[%u]=%08x S2CR=%08x CB=%u SCTLR=%08x FSR=%08x FAR=%08x:%08x FSYNR0=%08x\n",
+		    stage, h->smr, mu_sr(h, 0x800 + 4 * h->smr), mu_sr(h, 0xc00 + 4 * h->smr),
+		    h->cb, mu_sr(h, b), mu_sr(h, b + 0x58), mu_sr(h, b + 0x64), mu_sr(h, b + 0x60), mu_sr(h, b + 0x68));
+		MU_LOG("METROID SMMU[%s]: fault_bits=%08x fault_SID=%04x (FAR meaningful only with fault_bits)\n",
+		    stage, mu_sr(h, b + 0x58) & MU_SMMU_FSR_FAULT,
+		    mu_sr(h, h->gr1 + 0x400 + 4 * h->cb) & 0xffff);
+		MU_LOG("METROID SMMU[%s]: CBAR=%08x CBA2R=%08x TCR=%08x TCR2=%08x TTBR0=%08x:%08x MAIR=%08x:%08x\n",
+		    stage, mu_sr(h, h->gr1 + 4 * h->cb), mu_sr(h, h->gr1 + 0x800 + 4 * h->cb),
+		    mu_sr(h, b + 0x30), mu_sr(h, b + 0x10), mu_sr(h, b + 0x24), mu_sr(h, b + 0x20),
+		    mu_sr(h, b + 0x3c), mu_sr(h, b + 0x38));
+	}
+}
+
+/* Stop both legacy engines before replacing any descriptor or DMA mappings.
+ * An already-selected MCQ controller requires a separate queue teardown and
+ * is refused before writes, not switched to legacy behind firmware's back. */
+static int
+mu_quiesce(struct mu_host *h)
+{
+	if (mu_r(h, 8) < 0x00000200) { return ENOTSUP; }
+	if ((mu_r(h, 0) & (1u << 29)) || (mu_r(h, 0x300) & 1)) {
+		MU_LOG("METROID UFS: MCQ active or legacy removed; MCQ teardown is not implemented\n");
+		return ENOTSUP;
+	}
+	if (!(mu_r(h, 0x34) & 1) && !h->cold_init) {
+		MU_LOG("METROID UFS: firmware PHY/host is off; cold PHY/clock bring-up required\n");
+		return ENXIO;
+	}
+	if (mu_r(h, 0x58) || mu_r(h, 0x78)) { return EBUSY; }
+	/* Freeze automatic link sleep before changing the DMA domain. Existing
+	 * manual Hibern8 is handled explicitly before enabling request lists. */
+	mu_w(h, 0x18, 0);
+	if (mu_r(h, 0x18) & 0x1fff) {
+		MU_LOG("METROID UFS: cannot disable automatic Hibern8\n");
+		return EIO;
+	}
+	mu_w(h, 0x24, 0);
+	mu_w(h, 0x60, 0);
+	mu_w(h, 0x80, 0);
+	if (mu_poll(h, false, 0x60, 1, 0, 10000) || mu_poll(h, false, 0x80, 1, 0, 10000)) { return ETIMEDOUT; }
+	if (mu_r(h, 0x58) || mu_r(h, 0x78)) { return EBUSY; }
+	return 0;
+}
+
+static bool
+mu_smr_matches(uint32_t smr)
+{
+	uint32_t mask = (smr >> 16) & 0x7fff;
+	return (smr & (1u << 31)) && !(((smr & 0xffff) ^ MU_SID) & ~mask);
+}
+
+/* Find the exact UFS stream, then allocate a fresh stage-1 context bank.
+ * Every context referenced by firmware, including UFS, remains reserved.
+ * No global reset, CLIENTPD change or unrelated-stream TLB invalidation. */
+static int
+mu_choose_context(struct mu_host *h)
+{
+	uint32_t id0 = mu_sr(h, 0x20), id1 = mu_sr(h, 0x24), id2 = mu_sr(h, 0x28);
+	uint32_t scr0 = mu_sr(h, 0);
+	MU_LOG("METROID SMMU: ID0=%08x ID1=%08x ID2=%08x CR0=%08x\n", id0, id1, id2, scr0);
+	if (!id0 || id0 == UINT32_MAX || !id1 || id1 == UINT32_MAX || id2 == UINT32_MAX ||
+	    !(id0 & (1u << 30)) || !(id0 & (1u << 27)) || !(id2 & (1u << 12)) ||
+	    (scr0 & ((1u << 0) | (1u << 3)))) {
+		MU_LOG("METROID SMMU: need active SMMUv2 stage-1/4K/SMR, no extended IDs; ID=%08x/%08x/%08x CR0=%08x\n", id0, id1, id2, scr0);
+		return ENOTSUP;
+	}
+	h->pgshift = (id1 & (1u << 31)) ? 16 : 12;
+	h->gr1 = 1u << h->pgshift;
+	h->cb_base = (1u << (((id1 >> 28) & 7) + 1)) << h->pgshift;
+	h->ncb = id1 & 0xff;
+	h->ns2cb = (id1 >> 16) & 0xff;
+	h->nsmr = id0 & 0xff;
+	/* Stage-1 output width is ID2.IAS (IPA width), not ID2.OAS. */
+	h->ips = id2 & 0xf;
+	/* QSMMUv500 exposes more than 128 SMR/S2CR groups (138 on Metroid).
+	 * Nothing's qsmmuv500_impl retains ID0.NUMSMRG; the generic Qualcomm
+	 * implementation's 128-group workaround is not installed for this IP.
+	 * The 8-bit count bounds both arrays of registers inside GR0: up to
+	 * SMR[254] at 0xbf8 and S2CR[254] at 0xff8. Context-bank bookkeeping
+	 * below is indexed by CBNDX, not by the number of streams.
+	 */
+	if (!h->ncb || h->ncb > 128 || !h->nsmr ||
+	    h->ns2cb >= h->ncb || h->ips > 5 ||
+	    (uint64_t)h->cb_base + ((uint64_t)h->ncb << h->pgshift) > 0x100000) {
+		MU_LOG("METROID SMMU: unsupported geometry: page_shift=%u CB_base=%x contexts=%u stage2_only=%u SMRs=%u IPS=%u aperture=100000\n",
+		    h->pgshift, h->cb_base, h->ncb, h->ns2cb, h->nsmr, h->ips);
+		return ENOTSUP;
+	}
+	bool referenced[128] = { false }, used_asid[256] = { false };
+	uint32_t matches = 0, free_smr = UINT32_MAX;
+	h->smr = UINT32_MAX;
+	for (uint32_t i = 0; i < h->nsmr; i++) {
+		uint32_t s = mu_sr(h, 0x800 + 4 * i), c = mu_sr(h, 0xc00 + 4 * i);
+		if (!(s & (1u << 31))) { if (free_smr == UINT32_MAX) { free_smr = i; } continue; }
+		if (mu_smr_matches(s)) { h->smr = i; matches++; }
+		if (((c >> 16) & 3) == 0 && (c & 0xff) < h->ncb) { referenced[c & 0xff] = true; }
+	}
+	if (matches > 1) { return EBUSY; }
+	h->cb = UINT32_MAX;
+	if (matches == 1) {
+		h->old_smr = mu_sr(h, 0x800 + 4 * h->smr);
+		h->old_s2cr = mu_sr(h, 0xc00 + 4 * h->smr);
+		if (h->old_smr != ((1u << 31) | MU_SID)) { return EBUSY; }
+
+	} else {
+		if (free_smr == UINT32_MAX) { return ENOSPC; }
+		h->smr = free_smr;
+		h->old_smr = mu_sr(h, 0x800 + 4 * h->smr);
+		h->old_s2cr = mu_sr(h, 0xc00 + 4 * h->smr);
+	}
+	for (uint32_t i = h->ns2cb; i < h->ncb; i++) {
+		uint32_t b = mu_cb(h, i);
+		uint64_t ttbr = mu_sr64(h, b + 0x20), ttbr1 = mu_sr64(h, b + 0x28);
+		used_asid[(ttbr >> 48) & 0xff] = true;
+		used_asid[(ttbr1 >> 48) & 0xff] = true;
+		if (h->cb == UINT32_MAX && !referenced[i] && !(mu_sr(h, b) & 1)) { h->cb = i; }
+	}
+	if (h->cb == UINT32_MAX) {
+		MU_LOG("METROID SMMU: no unused disabled stage-1 context; firmware contexts preserved\n");
+		return ENOSPC;
+	}
+	MU_LOG("METROID SMMU: allocate fresh CB=%u; firmware UFS S2CR=%08x is preserved until attach\n",
+	    h->cb, h->old_s2cr);
+	h->asid = 0;
+	for (uint32_t i = 1; i < 256; i++) { if (!used_asid[i]) { h->asid = i; break; } }
+	return h->asid ? 0 : ENOSPC;
+}
+
+/* Three 4K tables: 32-bit IOVA -> L1 (four entries) -> L2 -> L3.
+ * Only the DMA pool is mapped; neighbouring pages and all other IOVAs fault.
+ * SMMU's 4K granule is independent of the CPU's 16K XNU page size. */
+static int
+mu_build_tables(struct mu_host *h)
+{
+	static const uint8_t pa_bits[] = { 32, 36, 40, 42, 44, 48 };
+	if (!h->tables || !h->pool || h->ips > 5 || (h->pool_pa & 4095) ||
+	    (h->tables_pa & 4095) || h->pool_pa > (1ull << pa_bits[h->ips]) - MU_POOL_SIZE ||
+	    h->tables_pa > (1ull << pa_bits[h->ips]) - MU_TABLE_SIZE) { return EINVAL; }
+	memset(h->tables, 0, MU_TABLE_SIZE);
+	uint64_t *l1 = h->tables, *l2 = l1 + 512, *l3 = l2 + 512;
+	l1[(MU_IOVA >> 30) & 3] = (h->tables_pa + 0x1000) | 3;
+	l2[(MU_IOVA >> 21) & 511] = (h->tables_pa + 0x2000) | 3;
+	for (uint32_t i = 0; i < MU_POOL_SIZE / 4096; i++) {
+		/* AF, inner-shareable, unprivileged R/W, AttrIdx0 WB, nG, XN. */
+		l3[i] = (h->pool_pa + (uint64_t)i * 4096) | 3 | (1u << 6) |
+		    (3u << 8) | (1u << 10) | (1u << 11) | (3ull << 53);
+	}
+	MU_CLEAN((uintptr_t)h->tables, MU_TABLE_SIZE);
+	MU_BARRIER();
+	return 0;
+}
+
+static int
+mu_tlb_sync(struct mu_host *h, uint32_t asid)
+{
+	uint32_t b = mu_cb(h, h->cb);
+	mu_sw(h, b + 0x610, asid);
+	mu_sw(h, b + 0x7f0, 0);
+	return mu_poll(h, true, b + 0x7f4, 1, 0, 100000);
+}
+
+/* Linux writes configuration without whole-register equality checks.
+ * Report normalization, but only reject differences that would change the
+ * translation format, page-table address, or UFS stream destination. */
+static int
+mu_check32(struct mu_host *h, uint32_t off, uint32_t want, uint32_t mask, const char *name)
+{
+	uint32_t got = mu_sr(h, off);
+	if (got != want) {
+		MU_LOG("METROID SMMU: %s readback want=%08x got=%08x required=%08x %s\n",
+		    name, want, got, mask, ((got ^ want) & mask) ? "blocked/incompatible" : "continuing");
+	}
+	return ((got ^ want) & mask) ? EPERM : 0;
+}
+
+static int
+mu_check_ttbr(struct mu_host *h, uint32_t off, uint64_t want)
+{
+	uint64_t got = mu_sr64(h, off);
+	const uint64_t mask = MU_ADDR_MASK | (0xffffull << 48);
+	if (got != want) {
+		MU_LOG("METROID SMMU: TTBR0 readback want=%llx got=%llx %s\n",
+		    (unsigned long long)want, (unsigned long long)got,
+		    ((got ^ want) & mask) ? "blocked/incompatible" : "continuing");
+	}
+	return ((got ^ want) & mask) ? EPERM : 0;
+}
+
+static int
+mu_map_dma(struct mu_host *h)
+{
+	h->phase = "dma-map";
+	if (mu_r(h, 0x58) || mu_r(h, 0x78) || (mu_r(h, 0x60) & 1) || (mu_r(h, 0x80) & 1)) { return EBUSY; }
+	int error = mu_choose_context(h);
+	if (error) { return error; }
+	/* Nothing's qsmmuv500_cfg_probe clears only this implementation bit.
+	 * Firmware may protect it; preserve every other sACR bit and report
+	 * blocked writes like Linux, without resetting global SMMU state. */
+	uint32_t acr = mu_sr(h, 0x10);
+	if (acr & (1u << 26)) {
+		mu_sw(h, 0x10, acr & ~(1u << 26));
+		MU_LOG("METROID SMMU: CACHE_LOCK old=%08x new=%08x%s\n", acr, mu_sr(h, 0x10),
+		    (mu_sr(h, 0x10) & (1u << 26)) ? " firmware-locked" : " cleared");
+	}
+	error = mu_build_tables(h);
+	if (error) { return error; }
+	uint32_t b = mu_cb(h, h->cb);
+	/* The UFS engines are stopped. Keep this context disabled on failure;
+	 * the permanent pool/tables remain pinned for any late device accesses. */
+	h->configured = true;
+	uint32_t old_asid = (uint32_t)(mu_sr64(h, b + 0x20) >> 48);
+	mu_sw(h, b, 0);
+	if ((error = mu_check32(h, b, 0, 1, "SCTLR disable"))) { goto fail; }
+	if (mu_tlb_sync(h, old_asid)) { error = ETIMEDOUT; goto fail; }
+	uint32_t cbar = (1u << 16) | (0xfu << 12) | (3u << 8);
+	/* Linux io-pgtable's noncoherent-walk case: outer-shareable, inner
+	 * and outer noncacheable table reads. Tables are explicitly cleaned
+	 * above and immutable while attached; firmware coherency is not assumed.
+	 * Endpoint PTEs remain Normal WB and use explicit cache ownership below. */
+	uint32_t tcr = (1u << 23) | (2u << 12) | 32;
+	uint32_t tcr2 = (7u << 15) | h->ips; /* 8-bit ASID; TCR2.AS stays zero */
+	uint64_t ttbr = h->tables_pa | ((uint64_t)h->asid << 48);
+	mu_sw(h, h->gr1 + 0x800 + 4 * h->cb, 1); /* AArch64 */
+	mu_sw(h, h->gr1 + 4 * h->cb, cbar);
+	mu_sw(h, b + 0x10, tcr2);
+	mu_sw(h, b + 0x30, tcr);
+	mu_sw64(h, b + 0x20, ttbr);
+	mu_sw64(h, b + 0x28, 0);
+	mu_sw(h, b + 0x38, 0xff); /* MAIR0 Attr0: Normal WB */
+	mu_sw(h, b + 0x3c, 0);
+	mu_sw(h, b + 0x58, mu_sr(h, b + 0x58) & MU_SMMU_FSR_FAULT);
+	if ((error = mu_check32(h, h->gr1 + 0x800 + 4 * h->cb, 1, 1, "CBA2R VA64")) ||
+	    (error = mu_check32(h, h->gr1 + 4 * h->cb, cbar, 3u << 16, "CBAR stage")) ||
+	    (error = mu_check32(h, b + 0x10, tcr2, 0xf, "TCR2 PA size")) ||
+	    (error = mu_check32(h, b + 0x30, tcr, (1u << 23) | (1u << 22) | (3u << 14) | (1u << 7) | 0x3f, "TCR format")) ||
+	    (error = mu_check_ttbr(h, b + 0x20, ttbr)) ||
+	    (error = mu_check32(h, b + 0x38, 0xff, 0xff, "MAIR Attr0"))) { goto fail; }
+	if (mu_tlb_sync(h, h->asid)) { error = ETIMEDOUT; goto fail; }
+	/* Abort on faults rather than stall forever; poll FSR instead of using IRQ. */
+	uint32_t sctlr = (1u << 12) | (1u << 5) | (1u << 2) | (1u << 1) | 1;
+	mu_sw(h, b, sctlr);
+	if ((error = mu_check32(h, b, sctlr, 1, "SCTLR enable"))) { goto fail; }
+	/* Linux uses TRANS + PRIVCFG_DEFAULT when attaching a DMA domain. */
+	uint32_t s2cr = h->cb;
+	mu_sw(h, 0xc00 + 4 * h->smr, s2cr);
+	if ((error = mu_check32(h, 0xc00 + 4 * h->smr, s2cr, (3u << 16) | 0xff, "S2CR route"))) { goto fail; }
+	mu_sw(h, 0x800 + 4 * h->smr, (1u << 31) | MU_SID);
+	if ((error = mu_check32(h, 0x800 + 4 * h->smr, (1u << 31) | MU_SID, UINT32_MAX, "SMR match"))) { goto fail; }
+	h->mapped = true;
+	MU_LOG("METROID DMA: SID=60 SMR=%u CB=%u ASID=%u IOVA=%llx PA=%llx bytes=%x TTBR=%llx (NC table walks, explicit cache sync)\n",
+	    h->smr, h->cb, h->asid, (unsigned long long)MU_IOVA,
+	    (unsigned long long)h->pool_pa, MU_POOL_SIZE, (unsigned long long)h->tables_pa);
+	return 0;
+fail:
+	mu_sw(h, b, 0);
+	h->failed = true;
+	return error;
+}
+
+/* UIC command completion and power-transition completion are independent.
+ * Follow ufshcd_uic_pwr_ctrl: Hibern8 exit needs UHXS and PWR_LOCAL too. */
+static int
+mu_uic_command(struct mu_host *h, uint32_t command, uint32_t arg1,
+    uint32_t arg3, uint32_t power_event, uint32_t *value)
+{
+	int error = mu_poll(h, false, 0x30, 1u << 3, 1u << 3, 1000000);
+	if (error) { goto fail; }
+	mu_w(h, 0x20, MU_UIC_DONE | power_event);
+	mu_w(h, 0x94, arg1); mu_w(h, 0x98, 0); mu_w(h, 0x9c, arg3);
+	mu_w(h, 0x90, command);
+	error = mu_poll(h, false, 0x20, MU_UIC_DONE, MU_UIC_DONE, 1000000);
+	if (error) { goto fail; }
+	uint32_t result = mu_r(h, 0x98) & 0xff;
+	mu_w(h, 0x20, MU_UIC_DONE);
+	if (result) {
+		MU_LOG("METROID UFS: UIC cmd=%02x attr=%08x result=%02x\n", command, arg1, result);
+		error = EIO; goto fail;
+	}
+	if (value) { *value = mu_r(h, 0x9c); }
+	if (power_event) {
+		error = mu_poll(h, false, 0x20, power_event, power_event, 1000000);
+		if (error) { goto fail; }
+		uint32_t status = (mu_r(h, 0x30) >> 8) & 7;
+		mu_w(h, 0x20, power_event);
+		if (status != 1) {
+			MU_LOG("METROID UFS: UIC power cmd=%02x status=%x (need PWR_LOCAL=1)\n", command, status);
+			error = EIO; goto fail;
+		}
+	}
+	return 0;
+fail:
+	MU_LOG("METROID UFS: UIC cmd=%02x attr=%08x failed errno=%d IS=%08x HCS=%08x\n",
+	    command, arg1, error, mu_r(h, 0x20), mu_r(h, 0x30));
+	h->failed = true;
+	return error;
+}
+
+static int
+mu_uic(struct mu_host *h, uint32_t command, uint32_t arg1,
+    uint32_t power_event, uint32_t *value)
+{
+	return mu_uic_command(h, command, arg1, 0, power_event, value);
+}
