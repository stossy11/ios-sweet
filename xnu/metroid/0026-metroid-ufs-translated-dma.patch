+static const struct mu_phy_setting mu_phy_rate_A_g4[] = {
+	{ 0x0474, 0x04 },
+	{ 0x04bc, 0x04 },
+};
+static const struct mu_phy_setting mu_phy_2nd_lane[] = {
+	{ 0x05fc, 0x02 },
+};
